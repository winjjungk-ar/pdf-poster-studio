class MainWindow(QMainWindow):
    def __init__(self) -> None:
        super().__init__()

        self.current_pdf_path = None
        self.current_project_path = None
        self.is_modified = False

        self.project_manager = ProjectManager()
        self.recent_projects = RecentProjects(RECENT_PROJECTS_PATH)

        self.undo_stack: list[dict] = []
        self.redo_stack: list[dict] = []
        self._restoring_history = False
        self.last_exported_pdf_path: str | None = None
        self.print_dpi = 300
        self.last_temp_print_pdf_path: str | None = None

        self.last_search_text: str = ""
        self.last_search_page_index: int = -1

        self.pdf_renderer = PdfRenderer()
        self.current_page_index = 0
        self.page_count = 0
        self.current_pixmap: QPixmap | None = None
        self.fit_to_page_enabled = True

        self.page_selections: dict[int, QRect] = {}
        # Stores the preview display size used when each selection QRect was saved.
        # This keeps selections stable when zoom changes.
        self.page_selection_display_sizes: dict[int, tuple[int, int]] = {}
        self.checked_pages: set[int] = set()
        self._updating_page_list = False
        self._auto_sync_print_order_enabled = False

        # Multi-PDF workspace.
        # Each item keeps its own selected pages and selection rectangles.
        self.workspace_items: list[dict] = []
        self.current_workspace_index: int | None = None
        self._updating_workspace_list = False
        self.current_display_scale_x = 1.0
        self.current_display_scale_y = 1.0
        self.render_zoom = 2.5
        self.preview_zoom_factor = 1.0
        self.preview_zoom_min = 0.25
        self.preview_zoom_max = 5.0
        self.preview_zoom_step = 1.25
        self.rotation_degrees = 0
        # Page-specific rotation. This prevents rotating one page from rotating all pages.
        self.page_rotations: dict[int, int] = {}
        self.current_display_base_width = 1
        self.current_display_base_height = 1

        # Show the manual-selection Output Area notice only once per app session.
        self._selection_output_area_notice_shown = False

        self.setWindowTitle(t("app_title_long"))
        self.setWindowIcon(self._create_app_icon())

        # Start comfortably on any monitor, then maximize after the UI is created.
        self.setMinimumSize(1000, 700)

        self._create_menus()
        self._create_quick_toolbar()
        self._create_central_ui()
        self._refresh_recent_projects_menu()
        self._create_log_panel()

        self._log("Application started.")
        self._log("SQLite database initialized.")
        self._log("PDF preview module loaded.")
        self._log("Selection module loaded.")
        self._log("Poster export module loaded.")

        QTimer.singleShot(0, self.showMaximized)
        QTimer.singleShot(350, self._show_welcome_dialog)



    def _create_app_icon(self) -> QIcon:
        pixmap = QPixmap(64, 64)
        pixmap.fill(QColor("#00000000"))

        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        # Pastel background circle
        painter.setBrush(QBrush(QColor("#DDF3F5")))
        painter.setPen(QPen(QColor("#8CCFD6"), 2))
        painter.drawEllipse(3, 3, 58, 58)

        # Paper
        painter.setBrush(QBrush(QColor("#FFFFFF")))
        painter.setPen(QPen(QColor("#6C8EA4"), 2))
        painter.drawRoundedRect(17, 10, 30, 42, 4, 4)

        # Fold corner
        painter.setBrush(QBrush(QColor("#EAF7FF")))
        painter.setPen(QPen(QColor("#6C8EA4"), 1))
        painter.drawLine(39, 10, 47, 18)
        painter.drawLine(47, 18, 47, 19)

        # Poster split guide
        painter.setPen(QPen(QColor("#9BB7FF"), 2))
        painter.drawLine(32, 16, 32, 47)
        painter.drawLine(21, 31, 43, 31)

        # Selection rectangle
        painter.setBrush(QBrush(QColor(255, 214, 165, 90)))
        painter.setPen(QPen(QColor("#FF9F68"), 2))
        painter.drawRoundedRect(22, 20, 20, 18, 3, 3)

        # Small PDF label
        painter.setFont(QFont("Segoe UI", 7, QFont.Weight.Bold))
        painter.setPen(QColor("#4F6F8F"))
        painter.drawText(20, 50, "PDF")

        painter.end()
        return QIcon(pixmap)

    def _show_welcome_dialog(self) -> None:
        if hasattr(self, "workspace_items") and self.workspace_items:
            return

        dialog = QDialog(self)
        dialog.setWindowTitle(t("welcome_dialog_title"))
        dialog.setModal(True)
        dialog.setMinimumWidth(720)
        dialog.setWindowIcon(self.windowIcon())

        layout = QVBoxLayout(dialog)
        layout.setContentsMargins(26, 24, 26, 24)
        layout.setSpacing(14)

        dialog.setStyleSheet("""
            QDialog {
                background-color: #FFF8F0;
            }
            QLabel#welcomeTitle {
                color: #395B64;
                font-size: 24px;
                font-weight: 900;
            }
            QLabel#welcomeSubtitle {
                color: #4F6F8F;
                font-size: 13px;
            }
            QPushButton.taskCard {
                color: #395B64;
                background-color: #EAF7F7;
                border: 1px solid #BFE8E8;
                border-radius: 12px;
                padding: 14px 12px;
                font-size: 15px;
                font-weight: 800;
                text-align: left;
                min-height: 70px;
            }
            QPushButton.taskCard:hover {
                background-color: #DDF3F5;
                border: 1px solid #9EDDE2;
            }
            QPushButton.taskCard:pressed {
                background-color: #CDECEF;
            }
            QPushButton.bottomButton {
                color: #395B64;
                background-color: #F6E7CB;
                border: 1px solid #E4CFA8;
                border-radius: 8px;
                padding: 9px 16px;
                font-weight: 700;
            }
            QPushButton.bottomButton:hover {
                background-color: #EFDDBA;
            }
        """)

        title = QLabel(t("app_title"))
        title.setObjectName("welcomeTitle")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        subtitle = QLabel(
            t("welcome_subtitle")
        )
        subtitle.setObjectName("welcomeSubtitle")
        subtitle.setWordWrap(True)
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(subtitle)

        prompt = QLabel(t("welcome_prompt"))
        prompt.setStyleSheet("font-size: 16px; font-weight: 800; color: #395B64;")
        prompt.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(prompt)

        grid = QGridLayout()
        grid.setSpacing(10)

        def add_task_button(row: int, col: int, text: str, callback) -> None:
            button = QPushButton(text)
            button.setProperty("class", "taskCard")
            button.clicked.connect(lambda: run_task(callback))
            grid.addWidget(button, row, col)

        def run_task(callback) -> None:
            dialog.accept()
            callback()

        add_task_button(
            0,
            0,
            t("welcome_task_make_poster"),
            self.task_make_poster,
        )
        add_task_button(
            0,
            1,
            t("welcome_task_merge_pdfs"),
            self.task_merge_pdfs,
        )
        add_task_button(
            1,
            0,
            t("welcome_task_extract_pages"),
            self.task_extract_pages,
        )
        add_task_button(
            1,
            1,
            t("welcome_task_selected_area_pdf"),
            self.task_selected_area_pdf,
        )
        add_task_button(
            2,
            0,
            t("welcome_task_rotate_pages"),
            self.task_rotate_pages,
        )
        add_task_button(
            2,
            1,
            t("welcome_task_open_project"),
            self.open_project,
        )

        layout.addLayout(grid)

        bottom_layout = QHBoxLayout()
        bottom_layout.addStretch()

        open_files_button = QPushButton(t("open_pdfs_images"))
        open_files_button.setProperty("class", "bottomButton")
        open_files_button.clicked.connect(lambda: run_task(self.open_pdfs))

        continue_button = QPushButton(t("continue"))
        continue_button.setProperty("class", "bottomButton")
        continue_button.clicked.connect(dialog.reject)

        bottom_layout.addWidget(open_files_button)
        bottom_layout.addWidget(continue_button)
        bottom_layout.addStretch()

        layout.addLayout(bottom_layout)

        note = QLabel(
            t("welcome_tip")
        )
        note.setAlignment(Qt.AlignmentFlag.AlignCenter)
        note.setStyleSheet("color: #7A8D96; font-size: 12px;")
        layout.addWidget(note)

        dialog.exec()





