    def on_poster_size_preset_changed(self) -> None:
        if not hasattr(self, "poster_size_preset_combo"):
            return

        preset_value = self.poster_size_preset_combo.currentData()

        if preset_value is None:
            self.update_poster_sheet_estimate()
            return

        # Backward compatibility: old preset data was just an integer scale.
        if isinstance(preset_value, dict):
            scale_value = int(preset_value.get("scale", 100))
            paper_size = preset_value.get("paper_size")
        else:
            scale_value = int(preset_value)
            paper_size = None

        # A-series / ANSI / Arch presets may define paper_size.
        # Hobby presets intentionally do not define paper_size and keep the current Output Paper Size.
        if paper_size and hasattr(self, "paper_size_combo"):
            self.paper_size_combo.blockSignals(True)
            self._apply_combo_data(self.paper_size_combo, paper_size)
            self.paper_size_combo.blockSignals(False)

        if hasattr(self, "poster_scale_spin"):
            self.poster_scale_spin.blockSignals(True)
            self.poster_scale_spin.setValue(scale_value)
            self.poster_scale_spin.blockSignals(False)

        self.update_poster_sheet_estimate()



    def on_poster_scale_changed(self) -> None:
        if hasattr(self, "poster_size_preset_combo"):
            current_preset = self.poster_size_preset_combo.currentData()

            preset_scale = None

            if isinstance(current_preset, dict):
                try:
                    preset_scale = int(current_preset.get("scale"))
                except Exception:
                    preset_scale = None
            elif current_preset is not None:
                try:
                    preset_scale = int(current_preset)
                except Exception:
                    preset_scale = None

            if preset_scale is not None and preset_scale != int(self.poster_scale_spin.value()):
                self.poster_size_preset_combo.blockSignals(True)
                self.poster_size_preset_combo.setCurrentIndex(0)
                self.poster_size_preset_combo.blockSignals(False)

        self.update_poster_sheet_estimate()



    def _get_fixed_a_series_tile_grid(self) -> tuple[int | None, int | None]:
        """Return fixed tile grid for known poster size presets.

        User expectation:
        - Poster Small / A3 / ANSI B / Arch B -> 2 sheets
        - Poster Medium / A2 / ANSI C / Arch C -> 4 sheets
        - Poster Large / A1 / ANSI D / Arch D -> 8 sheets
        - Poster Huge / A0 / ANSI E / Arch E -> 16 sheets

        Hobby presets respect the currently selected Output Paper Size.
        A-series presets set A4. ANSI/Arch presets set US Letter.
        """
        if not hasattr(self, "poster_size_preset_combo"):
            return None, None

        preset_text = self.poster_size_preset_combo.currentText()
        split_layout = self.split_layout_combo.currentData() if hasattr(self, "split_layout_combo") else "left_right"

        if not preset_text or "Manual" in preset_text or "Custom" in preset_text:
            return None, None

        # 2 sheets
        if (
            preset_text.startswith("Poster Small")
            or preset_text.startswith("A3 ")
            or preset_text.startswith("ANSI B")
            or preset_text.startswith("Arch B")
        ):
            return (1, 2) if split_layout == "top_bottom" else (2, 1)

        # 4 sheets
        if (
            preset_text.startswith("Poster Medium")
            or preset_text.startswith("A2 ")
            or preset_text.startswith("ANSI C")
            or preset_text.startswith("Arch C")
        ):
            return 2, 2

        # 8 sheets
        if (
            preset_text.startswith("Poster Large")
            or preset_text.startswith("A1 ")
            or preset_text.startswith("ANSI D")
            or preset_text.startswith("Arch D")
        ):
            return (2, 4) if split_layout == "top_bottom" else (4, 2)

        # 16 sheets
        if (
            preset_text.startswith("Poster Huge")
            or preset_text.startswith("A0 ")
            or preset_text.startswith("ANSI E")
            or preset_text.startswith("Arch E")
        ):
            return 4, 4

        return None, None






    def update_tiling_preview(self, cols: int | None = None, rows: int | None = None) -> None:
        if not hasattr(self, "tiling_preview_label"):
            return

        if not cols or not rows or cols <= 0 or rows <= 0:
            self.tiling_preview_label.setText("-")
            return

        max_cells = 40
        total = cols * rows

        # Keep the preview compact for very large posters.
        display_cols = min(cols, 8)
        display_rows = min(rows, 6)

        html = []
        html.append(
            "<div style='font-family: Segoe UI, Arial; color:#395B64;'>"
            f"<div style='font-weight:700; margin-bottom:6px;'>"
            f"{cols} x {rows} = {total} sheets"
            "</div>"
        )

        html.append(
            "<table cellspacing='4' cellpadding='0' "
            "style='border-collapse:separate;'>"
        )

        sheet_no = 1

        for row in range(display_rows):
            html.append("<tr>")

            for col in range(display_cols):
                actual_sheet_no = row * cols + col + 1

                if actual_sheet_no > max_cells:
                    cell_text = "..."
                else:
                    cell_text = str(actual_sheet_no)

                html.append(
                    "<td style='"
                    "min-width:34px;"
                    "height:28px;"
                    "text-align:center;"
                    "vertical-align:middle;"
                    "background-color:#EAF7F7;"
                    "border:1px solid #9EDDE2;"
                    "border-radius:6px;"
                    "font-weight:700;"
                    "color:#395B64;"
                    "'>"
                    f"{cell_text}"
                    "</td>"
                )

                sheet_no += 1

            if cols > display_cols:
                html.append(
                    "<td style='"
                    "min-width:28px;"
                    "height:28px;"
                    "text-align:center;"
                    "vertical-align:middle;"
                    "color:#7A8D96;"
                    "font-weight:700;"
                    "'>...</td>"
                )

            html.append("</tr>")

        if rows > display_rows:
            html.append(
                "<tr><td colspan='99' style='"
                "text-align:center;"
                "color:#7A8D96;"
                "font-weight:700;"
                "padding-top:2px;"
                "'>...</td></tr>"
            )

        html.append("</table>")

        if total > max_cells:
            html.append(
                f"<div style='font-size:11px; color:#7A8D96; margin-top:4px;'>"
                f"Large layout preview is shortened. Total sheets: {total}."
                "</div>"
            )

        html.append("</div>")

        self.tiling_preview_label.setText("".join(html))




    def update_poster_sheet_estimate(self) -> None:
        if not hasattr(self, "poster_sheet_estimate_label"):
            return

        try:
            if self.page_count <= 0:
                self.poster_sheet_estimate_label.setText(t("estimated_sheets_empty"))
                self.update_tiling_preview()
                return

            paper = self.paper_size_combo.currentData() if hasattr(self, "paper_size_combo") else "a4"
            scale_percent = self.poster_scale_spin.value() if hasattr(self, "poster_scale_spin") else 100
            scale = max(scale_percent / 100.0, 0.1)

            fixed_cols, fixed_rows = self._get_fixed_a_series_tile_grid()

            if fixed_cols and fixed_rows:
                total = fixed_cols * fixed_rows

                preset_text = self.poster_size_preset_combo.currentText() if hasattr(self, "poster_size_preset_combo") else ""

                if preset_text.startswith("Poster "):
                    current_paper = self.paper_size_combo.currentText() if hasattr(self, "paper_size_combo") else "current paper"
                    if total == 2:
                        size_text = f"Approx Poster Size: Small Poster on {current_paper}"
                    elif total == 4:
                        size_text = f"Approx Poster Size: Medium Poster on {current_paper}"
                    elif total == 8:
                        size_text = f"Approx Poster Size: Large Poster on {current_paper}"
                    elif total == 16:
                        size_text = f"Approx Poster Size: Huge Poster on {current_paper}"
                    else:
                        size_text = f"Approx Poster Size: Poster preset on {current_paper}"
                elif "ANSI" in preset_text:
                    if total == 2:
                        size_text = "Approx Poster Size: ANSI B / Tabloid"
                    elif total == 4:
                        size_text = "Approx Poster Size: ANSI C"
                    elif total == 8:
                        size_text = "Approx Poster Size: ANSI D"
                    elif total == 16:
                        size_text = "Approx Poster Size: ANSI E"
                    else:
                        size_text = "Approx Poster Size: ANSI preset"
                elif "Arch" in preset_text:
                    if total == 2:
                        size_text = "Approx Poster Size: Arch B"
                    elif total == 4:
                        size_text = "Approx Poster Size: Arch C"
                    elif total == 8:
                        size_text = "Approx Poster Size: Arch D"
                    elif total == 16:
                        size_text = "Approx Poster Size: Arch E"
                    else:
                        size_text = "Approx Poster Size: Arch preset"
                else:
                    if total == 2:
                        size_text = "Approx Poster Size: A3"
                    elif total == 4:
                        size_text = "Approx Poster Size: A2"
                    elif total == 8:
                        size_text = "Approx Poster Size: A1"
                    elif total == 16:
                        size_text = "Approx Poster Size: A0"
                    else:
                        size_text = "Approx Poster Size: preset"

                self.poster_sheet_estimate_label.setText(
                    f"Estimated Sheets: {fixed_cols} x {fixed_rows} = {total}\n{size_text}"
                )
                self.update_tiling_preview(cols=fixed_cols, rows=fixed_rows)
                return

            rect = self.preview_label.get_selection_rect()

            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                rect = self.page_selections.get(self.current_page_index, QRect())

            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                self.poster_sheet_estimate_label.setText(t("estimated_sheets_select_area"))
                self.update_tiling_preview()
                return

            selection = self._preview_rect_to_pdf_selection(rect)

            if paper == "letter":
                page_w = 8.5 * 72
                page_h = 11 * 72
                paper_name = t("us_letter")
            else:
                page_w = 210 * 72 / 25.4
                page_h = 297 * 72 / 25.4
                paper_name = "A4"

            margin = 5 * 72 / 25.4
            printable_w = max(page_w - margin * 2, 1)
            printable_h = max(page_h - margin * 2, 1)

            poster_w_pt = selection.width * scale
            poster_h_pt = selection.height * scale

            import math
            cols = max(1, math.ceil(poster_w_pt / printable_w))
            rows = max(1, math.ceil(poster_h_pt / printable_h))
            total = cols * rows

            poster_w_mm = poster_w_pt * 25.4 / 72
            poster_h_mm = poster_h_pt * 25.4 / 72

            self.poster_sheet_estimate_label.setText(
                f"Estimated Sheets: {cols} x {rows} = {total} "
                f"({paper_name}, {scale_percent}%)\n"
                f"Approx Poster Size: {poster_w_mm:.0f} x {poster_h_mm:.0f} mm"
            )
            self.update_tiling_preview(cols=cols, rows=rows)

        except Exception as exc:
            self.poster_sheet_estimate_label.setText(t("estimated_sheets_empty"))
            self.update_tiling_preview()
            self._log(f"Poster sheet estimate error: {exc}")





    def toggle_preview_floating_toolbar(self) -> None:
        if not hasattr(self, "preview_floating_toolbar"):
            return

        self.preview_floating_toolbar_expanded = not getattr(
            self,
            "preview_floating_toolbar_expanded",
            False,
        )

        expanded = self.preview_floating_toolbar_expanded

        if hasattr(self, "preview_floating_toggle_button"):
            self.preview_floating_toggle_button.setText("View ▾" if expanded else "View ▸")

        for button in getattr(self, "preview_floating_buttons", []):
            button.setVisible(expanded)

        self._refresh_preview_floating_toolbar()


    def _refresh_preview_floating_toolbar(self) -> None:
        if not hasattr(self, "preview_floating_toolbar"):
            return

        self.preview_floating_toolbar.adjustSize()
        self.preview_floating_toolbar.move(12, 12)
        self.preview_floating_toolbar.raise_()
        self.preview_floating_toolbar.show()



    def _set_combo_by_data_if_exists(self, combo_name: str, data) -> None:
        combo = getattr(self, combo_name, None)
        if combo is not None:
            self._apply_combo_data(combo, data)


    def build_print_order_from_all_source_pages(self) -> int:
        if not hasattr(self, "workspace_items") or not self.workspace_items:
            return 0

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        total_added = 0

        for workspace_index, item in enumerate(self.workspace_items):
            page_count = int(item.get("page_count", 0) or 0)

            checked_pages = set(range(page_count))
            item["checked_pages"] = checked_pages

            for page_index in range(page_count):
                self._add_export_order_item(workspace_index, page_index)
                total_added += 1

        if self.current_workspace_index is not None:
            self._load_workspace_index(self.current_workspace_index)
        elif self.workspace_items:
            self._load_workspace_index(0)

        self._refresh_workspace_list_text()
        self._update_checked_pages_label()
        self.is_modified = True

        self._log(f"Print Order built from all source pages: {total_added} pages")
        self.update_action_summary()
        return total_added


    def task_merge_pdfs(self) -> None:
        self._set_combo_by_data_if_exists("output_area_combo", "whole_page")
        self._set_combo_by_data_if_exists("export_type_combo", "selection_only")
        self._set_combo_by_data_if_exists("batch_output_combo", "single_pdf")
        self.update_export_option_states()
        self.update_output_area_states()

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            self.open_pdfs()

            if not hasattr(self, "workspace_items") or not self.workspace_items:
                return

        self._auto_sync_print_order_enabled = True
        total_added = self.build_print_order_from_all_source_pages()

        QMessageBox.information(
            self,
            t("merge_pdfs"),
            f"Merge setup completed.\n\n"
            f"Pages added to Print Order: {total_added}\n\n"
            "Output Area: Whole Page\n"
            "Output Files: One PDF\n"
            "Mode: Single Page PDF\n\n"
            "Click Create Single Page PDF to create the merged PDF."
        )

        if hasattr(self, "settings_tabs"):
            # Status tab is usually index 1 when Home exists.
            for index in range(self.settings_tabs.count()):
                if self.settings_tabs.tabText(index) == t("status"):
                    self.settings_tabs.setCurrentIndex(index)
                    break




    def build_print_order_from_page_range(self, range_text: str) -> int:
        if not hasattr(self, "workspace_items") or not self.workspace_items:
            return 0

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        total_added = 0

        for workspace_index, item in enumerate(self.workspace_items):
            page_count = int(item.get("page_count", 0) or 0)

            page_indices = self._parse_page_range_text(range_text, page_count)
            checked_pages = set(item.get("checked_pages", set()))

            for page_index in page_indices:
                checked_pages.add(page_index)
                self._add_export_order_item(workspace_index, page_index)
                total_added += 1

            item["checked_pages"] = checked_pages

        if self.current_workspace_index is not None:
            self._load_workspace_index(self.current_workspace_index)
        elif self.workspace_items:
            self._load_workspace_index(0)

        self._refresh_workspace_list_text()
        self._update_checked_pages_label()
        self.is_modified = True

        self._log(f"Print Order built from page range '{range_text}': {total_added} pages")
        self.update_action_summary()
        return total_added


    def task_extract_pages(self) -> None:
        self._set_combo_by_data_if_exists("output_area_combo", "whole_page")
        self._set_combo_by_data_if_exists("export_type_combo", "selection_only")
        self._set_combo_by_data_if_exists("batch_output_combo", "separate_pdf_per_page")
        self.update_export_option_states()
        self.update_output_area_states()

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            self.open_pdfs()

            if not hasattr(self, "workspace_items") or not self.workspace_items:
                return

        range_text, ok = QInputDialog.getText(
            self,
            t("extract_pages"),
            "Enter page range to extract from each source file:\n"
            "Examples: all, 1-10, 1,3,5, 10-20,35",
            text="all",
        )

        if not ok:
            return

        range_text = range_text.strip() or "all"

        try:
            self._auto_sync_print_order_enabled = True
            total_added = self.build_print_order_from_page_range(range_text)
        except Exception as exc:
            QMessageBox.warning(
                self,
                t("extract_pages"),
                f"Invalid page range or extraction failed.\n\n{exc}"
            )
            return

        QMessageBox.information(
            self,
            t("extract_pages"),
            f"Extract setup completed.\n\n"
            f"Pages added to Print Order: {total_added}\n"
            f"Range: {range_text}\n\n"
            "Output Area: Whole Page\n"
            "Mode: Single Page PDF\n"
            "Output Files: Separate PDF per selected page\n\n"
            "Click Create Single Page PDF to export each selected page as a separate PDF.\n\n"
            "If you want one combined PDF instead, change Output Files to One PDF."
        )

        if hasattr(self, "settings_tabs"):
            for index in range(self.settings_tabs.count()):
                if self.settings_tabs.tabText(index) == t("status"):
                    self.settings_tabs.setCurrentIndex(index)
                    break






    def open_one_source_file_for_poster(self) -> bool:
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            t("open_one_pdf_or_image_for_poster"),
            "",
            t("all_files")
        )

        if not file_path:
            return False

        try:
            pdf_path = self._prepare_source_file_for_workspace(file_path)

            self.workspace_items = [self._make_workspace_item(pdf_path)]
            self.current_workspace_index = None

            if hasattr(self, "workspace_pdf_list"):
                self.workspace_pdf_list.clear()
            if hasattr(self, "export_order_list"):
                self.export_order_list.clear()

            self._refresh_workspace_list_text()
            self._load_workspace_index(0)

            self.is_modified = True
            self._log(f"Opened one source file for poster: {file_path}")
            return True

        except Exception as exc:
            QMessageBox.critical(
                self,
                "Open One File",
                f"Failed to open file.\\n\\n{exc}"
            )
            self._log(f"Open one source file for poster error: {exc}")
            return False


    def task_make_poster(self) -> None:
        has_sources = hasattr(self, "workspace_items") and bool(self.workspace_items)

        if has_sources:
            source_dialog = QMessageBox(self)
            source_dialog.setWindowTitle(t("make_poster"))
            source_dialog.setIcon(QMessageBox.Icon.Question)
            source_dialog.setText(t("choose_source_files_for_poster"))
            source_dialog.setInformativeText(
                "Open One File is best for a single map, poster, image, or drawing.\n\n"
                "Use Current Source PDFs keeps the files already loaded in Source PDFs."
            )

            open_one_button = source_dialog.addButton("Open One File", QMessageBox.ButtonRole.AcceptRole)
            use_current_button = source_dialog.addButton("Use Current Source PDFs", QMessageBox.ButtonRole.ActionRole)
            cancel_button = source_dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

            source_dialog.setDefaultButton(open_one_button)
            source_dialog.exec()

            clicked = source_dialog.clickedButton()

            if clicked == cancel_button:
                return

            if clicked == open_one_button:
                if not self.open_one_source_file_for_poster():
                    return

            elif clicked == use_current_button:
                pass

            else:
                return

        else:
            if not self.open_one_source_file_for_poster():
                return

        self._set_combo_by_data_if_exists("export_type_combo", "a3_split")

        area_dialog = QMessageBox(self)
        area_dialog.setWindowTitle(t("make_poster"))
        area_dialog.setIcon(QMessageBox.Icon.Question)
        area_dialog.setText(t("what_area_for_poster"))
        area_dialog.setInformativeText(
            "Whole Page uses the full page or image.\n\n"
            "Selected Area uses only the area you select in the preview."
        )

        whole_button = area_dialog.addButton(t("use_whole_page"), QMessageBox.ButtonRole.AcceptRole)
        selected_button = area_dialog.addButton(t("use_selected_area"), QMessageBox.ButtonRole.ActionRole)
        cancel_button = area_dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

        area_dialog.setDefaultButton(whole_button)
        area_dialog.exec()

        clicked = area_dialog.clickedButton()

        if clicked == cancel_button:
            return

        if clicked == whole_button:
            self._set_combo_by_data_if_exists("output_area_combo", "whole_page")
            area_message = (
                "Output Area set to Whole Page.\n\n"
                "Choose Poster Size Preset, check Tiling Preview, then click Poster PDF in the toolbar."
            )
        elif clicked == selected_button:
            self._set_combo_by_data_if_exists("output_area_combo", "selected_area")
            area_message = (
                "Output Area set to Selected Area.\n\n"
                "Drag to select an area or use Auto Select, then Build Print Order and click Poster PDF."
            )
        else:
            return

        self.update_export_option_states()
        self.update_output_area_states()
        self.update_action_summary()

        if hasattr(self, "settings_tabs") and hasattr(self, "a3_split_group"):
            self.settings_tabs.setCurrentWidget(self.a3_split_group)

        QMessageBox.information(
            self,
            t("make_poster"),
            area_message
        )









    def task_rotate_pages(self) -> None:
        if self.page_count <= 0:
            self.open_pdfs()

            if self.page_count <= 0:
                return

        target_dialog = QMessageBox(self)
        target_dialog.setWindowTitle(t("rotate_pages"))
        target_dialog.setText("Which pages do you want to rotate?")

        current_button = target_dialog.addButton(t("current_page"), QMessageBox.ButtonRole.AcceptRole)
        checked_button = target_dialog.addButton(t("checked_pages"), QMessageBox.ButtonRole.ActionRole)
        all_button = target_dialog.addButton(t("all_pages"), QMessageBox.ButtonRole.ActionRole)
        cancel_button = target_dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

        target_dialog.exec()
        target_clicked = target_dialog.clickedButton()

        if target_clicked == cancel_button:
            return

        if target_clicked == current_button:
            target_pages = [self.current_page_index]
        elif target_clicked == checked_button:
            if not self.checked_pages:
                QMessageBox.information(
                    self,
                    t("rotate_pages"),
                    "No checked pages exist.\n\nCheck pages first or choose Current Page / All Pages."
                )
                return
            target_pages = sorted(self.checked_pages)
        elif target_clicked == all_button:
            target_pages = list(range(self.page_count))
        else:
            return

        op_dialog = QMessageBox(self)
        op_dialog.setWindowTitle(t("rotate_pages"))
        op_dialog.setText(f"Rotation target: {len(target_pages)} page(s)\n\nChoose rotation operation.")

        left_button = op_dialog.addButton(t("rotate_left"), QMessageBox.ButtonRole.AcceptRole)
        right_button = op_dialog.addButton(t("rotate_right"), QMessageBox.ButtonRole.ActionRole)
        reset_button = op_dialog.addButton(t("reset_rotation"), QMessageBox.ButtonRole.ActionRole)
        cancel_button = op_dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

        op_dialog.exec()
        op_clicked = op_dialog.clickedButton()

        if op_clicked == cancel_button:
            return

        self._push_undo_state()
        self._save_current_selection()

        for page_index in target_pages:
            old_degrees = int(self.page_rotations.get(page_index, 0)) % 360

            if op_clicked == left_button:
                new_degrees = (old_degrees - 90) % 360
            elif op_clicked == right_button:
                new_degrees = (old_degrees + 90) % 360
            elif op_clicked == reset_button:
                new_degrees = 0
            else:
                continue

            if new_degrees == 0:
                self.page_rotations.pop(page_index, None)
            else:
                self.page_rotations[page_index] = new_degrees

        # Prepare output workflow for saving rotated pages.
        self._set_combo_by_data_if_exists("output_area_combo", "whole_page")
        self._set_combo_by_data_if_exists("export_type_combo", "selection_only")
        self._set_combo_by_data_if_exists("batch_output_combo", "single_pdf")
        self.update_export_option_states()
        self.update_output_area_states()

        self.checked_pages = set(target_pages)

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

            workspace_index = self.current_workspace_index if self.current_workspace_index is not None else 0

            for page_index in target_pages:
                self._add_export_order_item(workspace_index, page_index)

        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()
        self._refresh_page_list_all_text()
        self._refresh_current_page_check_state()
        self._update_checked_pages_label()
        self._refresh_workspace_list_text()
        self.update_action_summary()

        self.is_modified = True

        if hasattr(self, "settings_tabs"):
            for index in range(self.settings_tabs.count()):
                if self.settings_tabs.tabText(index) == t("status"):
                    self.settings_tabs.setCurrentIndex(index)
                    break

        QMessageBox.information(
            self,
            t("rotate_pages"),
            f"Rotation updated for {len(target_pages)} page(s).\n\n"
            "Print Order was prepared using Whole Page mode.\n"
            "Click Single Page PDF in the toolbar to save the rotated PDF."
        )





    def task_selected_area_pdf(self) -> None:
        if not hasattr(self, "workspace_items") or not self.workspace_items:
            self.open_pdfs()

            if not hasattr(self, "workspace_items") or not self.workspace_items:
                return

        self._set_combo_by_data_if_exists("output_area_combo", "selected_area")
        self._set_combo_by_data_if_exists("export_type_combo", "selection_only")
        self.update_export_option_states()
        self.update_output_area_states()
        self.update_action_summary()

        dialog = QMessageBox(self)
        dialog.setWindowTitle(t("selected_area_pdf"))
        dialog.setIcon(QMessageBox.Icon.Question)
        dialog.setText("How do you want to select the area?")
        dialog.setInformativeText(
            "Auto Select detects the content area on the current page.\n\n"
            "Select Manually lets you drag an area in the preview."
        )

        auto_button = dialog.addButton("Auto Select Current Page", QMessageBox.ButtonRole.AcceptRole)
        manual_button = dialog.addButton(t("select_manually"), QMessageBox.ButtonRole.ActionRole)
        cancel_button = dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

        dialog.setDefaultButton(auto_button)
        dialog.exec()

        clicked = dialog.clickedButton()

        if clicked == cancel_button:
            return

        if hasattr(self, "settings_tabs") and hasattr(self, "selection_only_group"):
            self.settings_tabs.setCurrentWidget(self.selection_only_group)

        if clicked == auto_button:
            if self.page_count <= 0:
                QMessageBox.information(
                    self,
                    t("selected_area_pdf"),
                    "Please open a PDF or image first."
                )
                return

            self.auto_select_content()

            QMessageBox.information(
                self,
                t("selected_area_pdf"),
                "Auto Select completed for the current page.\n\n"
                "Click Build Print Order, then click Single Page PDF in the toolbar."
            )
            return

        if clicked == manual_button:
            QMessageBox.information(
                self,
                t("selected_area_pdf"),
                "Drag on the preview to select an area.\n\n"
                "Then click Build Print Order and click Single Page PDF in the toolbar."
            )









    def update_action_summary(self):
        if not hasattr(self, "action_summary_label"):
            return

        print_order_count = 0
        if hasattr(self, "export_order_list"):
            print_order_count = self.export_order_list.count()

        output_text = t("one_pdf")
        if hasattr(self, "batch_output_combo"):
            output_text = self.batch_output_combo.currentText()

        area_text = t("whole_page")
        if hasattr(self, "output_area_combo"):
            area_text = self.output_area_combo.currentText()

        self.action_summary_label.setText(
            f"{t('print_order')}: {print_order_count} item(s) | "
            f"{t('output_files')}: {output_text} | {t('output_area')}: {area_text}\n"
            f"{t('use_toolbar_create_pdf')}"
        )

    def update_output_area_states(self) -> None:
        is_selected_area = True

        if hasattr(self, "output_area_combo"):
            is_selected_area = self.output_area_combo.currentData() == "selected_area"

        disabled_tip = (
            t("auto_select_disabled_tip")
        )
        enabled_tip_current = "Automatically detect the content area on the current page."
        enabled_tip_all = "Automatically detect content areas on all pages."

        if hasattr(self, "auto_current_action"):
            self.auto_current_action.setEnabled(is_selected_area)
            self.auto_current_action.setToolTip(enabled_tip_current if is_selected_area else disabled_tip)

        if hasattr(self, "auto_all_action"):
            self.auto_all_action.setEnabled(is_selected_area)
            self.auto_all_action.setToolTip(enabled_tip_all if is_selected_area else disabled_tip)

        if hasattr(self, "auto_range_action"):
            self.auto_range_action.setEnabled(is_selected_area)
            self.auto_range_action.setToolTip(
                "Automatically detect content areas for a specific page range."
                if is_selected_area else disabled_tip
            )


    def update_export_option_states(self) -> None:
        export_type = self.export_type_combo.currentData()

        is_a3_split = export_type == "a3_split"
        is_single_page = export_type == "selection_only"

        self.selection_only_group.setEnabled(is_single_page)
        self.a3_split_group.setEnabled(is_a3_split)

        self.selection_fit_mode_title.setEnabled(is_single_page)
        self.selection_fit_mode_combo.setEnabled(is_single_page)
        self.page_orientation_title.setEnabled(is_single_page)
        self.page_orientation_combo.setEnabled(is_single_page)

        self.output_mode_title.setEnabled(is_a3_split)
        self.output_mode_combo.setEnabled(is_a3_split)
        self.split_layout_title.setEnabled(is_a3_split)
        self.split_layout_combo.setEnabled(is_a3_split)
        self.numbering_check.setEnabled(is_a3_split)
        self.cut_guides_check.setEnabled(is_a3_split)

        if is_single_page:
            self._log("Export Type changed: Single Page Mode. Poster Print options disabled.")
        else:
            self._log("Export Type changed: Poster Print Mode. Single Page options disabled.")

    def update_export_option_states(self) -> None:
        export_type = self.export_type_combo.currentData()

        is_a3_split = export_type == "a3_split"
        is_single_page = export_type == "selection_only"

        self.selection_only_group.setEnabled(is_single_page)
        self.a3_split_group.setEnabled(is_a3_split)

        self.selection_fit_mode_title.setEnabled(is_single_page)
        self.selection_fit_mode_combo.setEnabled(is_single_page)
        self.page_orientation_title.setEnabled(is_single_page)
        self.page_orientation_combo.setEnabled(is_single_page)

        self.output_mode_title.setEnabled(is_a3_split)
        self.output_mode_combo.setEnabled(is_a3_split)
        self.split_layout_title.setEnabled(is_a3_split)
        self.split_layout_combo.setEnabled(is_a3_split)
        self.numbering_check.setEnabled(is_a3_split)
        self.cut_guides_check.setEnabled(is_a3_split)

        if is_single_page:
            self._log("Export Type changed: Single Page Mode. Poster Print options disabled.")
        else:
            self._log("Export Type changed: Poster Print Mode. Single Page options disabled.")
    def _create_log_panel(self) -> None:
        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)

        self.log_dock = QDockWidget("Log", self)
        self.log_dock.setWidget(self.log_text)
        self.addDockWidget(Qt.DockWidgetArea.BottomDockWidgetArea, self.log_dock)

        self.log_dock.hide()
    def _log(self, message: str) -> None:
        if hasattr(self, "log_text"):
            self.log_text.append(message)

    def _update_checked_pages_label(self) -> None:
        self.checked_pages_label.setText(f"Checked pages: {len(self.checked_pages)}")

    def _refresh_current_page_check_state(self) -> None:
        if not hasattr(self, "page_complete_check"):
            return

        self.page_complete_check.blockSignals(True)
        self.page_complete_check.setChecked(self.current_page_index in self.checked_pages)
        self.page_complete_check.blockSignals(False)
        self._update_checked_pages_label()

    def on_page_complete_changed(self, state: int) -> None:
        if self.page_count <= 0:
            return

        if self.page_complete_check.isChecked():
            if not self._is_whole_page_output_area():
                rect = self.preview_label.get_selection_rect()
                if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    self.page_complete_check.blockSignals(True)
                    self.page_complete_check.setChecked(False)
                    self.page_complete_check.blockSignals(False)
                    QMessageBox.warning(
                        self,
                        t("no_selection"),
                        "Please select an area before checking this page, or choose Output Area = Whole Page."
                    )
                    return

                self._save_current_selection()

            self.checked_pages.add(self.current_page_index)
            self._log(f"Page checked for export: {self.current_page_index + 1}")
        else:
            self.checked_pages.discard(self.current_page_index)
            self._log(f"Page unchecked for export: {self.current_page_index + 1}")

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self._update_checked_pages_label()

        if getattr(self, "_auto_sync_print_order_enabled", False):
            self.sync_print_order_from_checked_pages_quiet()

    def on_page_jump_changed(self, value: int) -> None:
        if self.page_count <= 0:
            return

        target_index = value - 1
        if target_index == self.current_page_index:
            return

        if target_index < 0 or target_index >= self.page_count:
            return

        self._save_current_selection()
        self.current_page_index = target_index
        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()

    def _sync_page_jump_spin(self) -> None:
        if not hasattr(self, "page_jump_spin"):
            return

        self.page_jump_spin.blockSignals(True)
        self.page_jump_spin.setMaximum(max(1, self.page_count))
        self.page_jump_spin.setValue(max(1, self.current_page_index + 1))
        self.page_jump_spin.blockSignals(False)

    def mark_current_page_checked_if_has_selection(self) -> None:
        rect = self.preview_label.get_selection_rect()
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            return

        self.checked_pages.add(self.current_page_index)
        self._refresh_current_page_check_state()

    def _is_whole_page_output_area(self) -> bool:
        return hasattr(self, "output_area_combo") and self.output_area_combo.currentData() == "whole_page"

    def _get_full_page_selection_for_pdf(self, pdf_path: str, page_index: int) -> SelectionRect:
        doc = fitz.open(str(pdf_path))
        try:
            page = doc.load_page(page_index)
            rect = page.rect
            return SelectionRect(
                x=float(rect.x0),
                y=float(rect.y0),
                width=float(rect.width),
                height=float(rect.height),
            )
        finally:
            doc.close()

    def _get_full_page_selection(self, page_index: int) -> SelectionRect:
        if not self.current_pdf_path:
            raise RuntimeError("No PDF is open.")
        return self._get_full_page_selection_for_pdf(self.current_pdf_path, page_index)


    def _selection_exists_for_page(self, page_index: int) -> bool:
        if self._is_whole_page_output_area():
            return self.page_count > 0 and 0 <= page_index < self.page_count

        rect = self.page_selections.get(page_index)
        return rect is not None and not rect.isNull() and rect.width() > 0 and rect.height() > 0

    def _page_list_text(self, page_index: int) -> str:
        page_no = page_index + 1

        if self._selection_exists_for_page(page_index):
            status = "Selected"
        else:
            status = "No selection"

        if page_index == self.current_page_index:
            return f"▶ Page {page_no} - {status}"

        return f"Page {page_no} - {status}"

    def _rebuild_page_list(self) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        self._updating_page_list = True
        self.page_list_widget.clear()

        for page_index in range(self.page_count):
            item = QListWidgetItem(self._page_list_text(page_index))
            item.setData(Qt.ItemDataRole.UserRole, page_index)
            item.setFlags(
                item.flags()
                | Qt.ItemFlag.ItemIsUserCheckable
                | Qt.ItemFlag.ItemIsEnabled
                | Qt.ItemFlag.ItemIsSelectable
            )

            if page_index in self.checked_pages:
                item.setCheckState(Qt.CheckState.Checked)
            else:
                item.setCheckState(Qt.CheckState.Unchecked)

            self.page_list_widget.addItem(item)

        self._updating_page_list = False
        self._update_checked_pages_label()

    def _refresh_page_list_item(self, page_index: int) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        if page_index < 0 or page_index >= self.page_list_widget.count():
            return

        self._updating_page_list = True

        item = self.page_list_widget.item(page_index)
        item.setText(self._page_list_text(page_index))

        if page_index in self.checked_pages:
            item.setCheckState(Qt.CheckState.Checked)
        else:
            item.setCheckState(Qt.CheckState.Unchecked)

        self._updating_page_list = False

    def _refresh_page_list_all_text(self) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        self._updating_page_list = True

        for index in range(self.page_list_widget.count()):
            item = self.page_list_widget.item(index)
            page_index = item.data(Qt.ItemDataRole.UserRole)
            item.setText(self._page_list_text(page_index))

            if page_index in self.checked_pages:
                item.setCheckState(Qt.CheckState.Checked)
            else:
                item.setCheckState(Qt.CheckState.Unchecked)

        self._updating_page_list = False
        self._update_checked_pages_label()

    def on_page_list_item_clicked(self, item: QListWidgetItem) -> None:
        page_index = item.data(Qt.ItemDataRole.UserRole)

        if page_index is None:
            return

        if page_index == self.current_page_index:
            return

        if page_index < 0 or page_index >= self.page_count:
            return

        self._save_current_selection()
        self.current_page_index = page_index
        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()

    def on_page_list_item_changed(self, item: QListWidgetItem) -> None:
        if self._updating_page_list:
            return

        page_index = item.data(Qt.ItemDataRole.UserRole)

        if page_index is None:
            return

        if item.checkState() == Qt.CheckState.Checked:
            if not self._selection_exists_for_page(page_index):
                self._updating_page_list = True
                item.setCheckState(Qt.CheckState.Unchecked)
                self._updating_page_list = False

                QMessageBox.warning(
                    self,
                    t("no_selection"),
                    f"Page {page_index + 1} has no selection area. Choose Output Area = Whole Page to use the full page."
                )
                return

            self.checked_pages.add(page_index)
            self._log(f"Page checked from list: {page_index + 1}")
        else:
            self.checked_pages.discard(page_index)
            self._log(f"Page unchecked from list: {page_index + 1}")

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(page_index)
        self._update_checked_pages_label()

        if getattr(self, "_auto_sync_print_order_enabled", False):
            self.sync_print_order_from_checked_pages_quiet()

    def _get_preview_display_size_tuple(self) -> tuple[int, int]:
        pixmap = None

        try:
            pixmap = getattr(self.preview_label, "preview_pixmap", None)
        except Exception:
            pixmap = None

        if pixmap is None:
            try:
                pixmap = self.preview_label.pixmap()
            except Exception:
                pixmap = None

        if pixmap is not None and hasattr(pixmap, "isNull") and not pixmap.isNull():
            return max(1, pixmap.width()), max(1, pixmap.height())

        return (
            max(1, int(getattr(self, "current_display_base_width", 1))),
            max(1, int(getattr(self, "current_display_base_height", 1))),
        )

    def _remember_selection_display_size(self, page_index: int) -> None:
        if page_index < 0:
            return

        self.page_selection_display_sizes[page_index] = self._get_preview_display_size_tuple()

    def _scale_selection_rect_to_current_display(self, page_index: int, rect: QRect) -> QRect:
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            return QRect()

        old_size = self.page_selection_display_sizes.get(page_index)

        if not old_size:
            return QRect(rect)

        old_w, old_h = old_size
        new_w, new_h = self._get_preview_display_size_tuple()

        old_w = max(1, int(old_w))
        old_h = max(1, int(old_h))
        new_w = max(1, int(new_w))
        new_h = max(1, int(new_h))

        if old_w == new_w and old_h == new_h:
            return QRect(rect)

        sx = new_w / old_w
        sy = new_h / old_h

        return QRect(
            int(round(rect.x() * sx)),
            int(round(rect.y() * sy)),
            max(1, int(round(rect.width() * sx))),
            max(1, int(round(rect.height() * sy))),
        )


    def _save_current_selection(self) -> None:
        if self.page_count <= 0:
            return

        rect = self.preview_label.get_selection_rect()

        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            self.page_selections.pop(self.current_page_index, None)
            self.page_selection_display_sizes.pop(self.current_page_index, None)
            return

        self.page_selections[self.current_page_index] = QRect(rect)
        self._remember_selection_display_size(self.current_page_index)


    def _restore_current_selection(self) -> None:
        rect = self.page_selections.get(self.current_page_index, QRect())
        scaled_rect = self._scale_selection_rect_to_current_display(self.current_page_index, rect)

        # After scaling, update the stored rect and its display size to the current preview.
        if not scaled_rect.isNull() and scaled_rect.width() > 0 and scaled_rect.height() > 0:
            self.page_selections[self.current_page_index] = QRect(scaled_rect)
            self._remember_selection_display_size(self.current_page_index)

        self.preview_label.set_selection_rect(scaled_rect)
        self._update_selection_info(scaled_rect)


    def _update_selection_info(self, rect: QRect) -> None:
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            self.selection_info_label.setText(t("selection_none"))
            return

        self.selection_info_label.setText(
            f"Selection: x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}"
        )

    def _get_rotated_pixmap(self) -> QPixmap:
        if self.current_pixmap is None:
            raise RuntimeError("No pixmap is available.")

        angle = self._get_current_rotation_degrees() % 360

        if angle == 0:
            return self.current_pixmap

        transform = QTransform()
        transform.rotate(angle)
        return self.current_pixmap.transformed(
            transform,
            Qt.TransformationMode.SmoothTransformation,
        )

    def _show_pixmap(self) -> None:
        if self.current_pixmap is None:
            return

        display_base = self._get_rotated_pixmap()
        self.current_display_base_width = display_base.width()
        self.current_display_base_height = display_base.height()

        if self.fit_to_page_enabled:
            viewport_size = self.preview_scroll.viewport().size()
            scaled = display_base.scaled(
                viewport_size,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            self.current_display_scale_x = scaled.width() / display_base.width()
            self.current_display_scale_y = scaled.height() / display_base.height()

            self.preview_label.set_preview_pixmap(scaled)
            self.render_info_label.setText(
                f"Preview: Rendered, fitted {scaled.width()} x {scaled.height()}"
            )
            self.zoom_info_label.setText(t("zoom_fit_page"))
        else:
            scaled_width = max(1, int(display_base.width() * self.preview_zoom_factor))
            scaled_height = max(1, int(display_base.height() * self.preview_zoom_factor))

            scaled = display_base.scaled(
                scaled_width,
                scaled_height,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            self.current_display_scale_x = scaled.width() / display_base.width()
            self.current_display_scale_y = scaled.height() / display_base.height()

            self.preview_label.set_preview_pixmap(scaled)
            self.render_info_label.setText(
                f"Preview: Rendered, zoomed {scaled.width()} x {scaled.height()}"
            )
            self.zoom_info_label.setText(
                f"Zoom: {int(self.preview_zoom_factor * 100)}%"
            )

        self.rotation_info_label.setText(f"Rotation: {self._get_current_rotation_degrees() % 360}°")
        self._restore_current_selection()


    def _get_current_rotation_degrees(self) -> int:
        # Page rotation must be independent.
        # If the current page has no saved rotation, use 0 degrees.
        return int(self.page_rotations.get(self.current_page_index, 0)) % 360

    def _set_current_rotation_degrees(self, degrees: int) -> None:
        degrees = int(degrees) % 360

        if degrees == 0:
            self.page_rotations.pop(self.current_page_index, None)
        else:
            self.page_rotations[self.current_page_index] = degrees

        self.rotation_degrees = degrees

    def _get_page_rotation_degrees(self, page_index: int) -> int:
        return int(self.page_rotations.get(page_index, 0)) % 360


    def _render_current_page(self) -> None:
        if self.page_count <= 0:
            self._log("Render skipped: page count is zero.")
            return

        try:
            self._log(f"Rendering page {self.current_page_index + 1}/{self.page_count}...")
            self.current_pixmap = self.pdf_renderer.render_page(
                self.current_page_index,
                zoom=self.render_zoom,
            )
            self._show_pixmap()

            self.page_label.setText(
                f"Page: {self.current_page_index + 1} / {self.page_count}"
            )

            self._update_page_buttons()
            self._sync_page_jump_spin()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()

            self._log(
                f"Rendered page {self.current_page_index + 1}/{self.page_count}, "
                f"pixmap={self.current_pixmap.width()}x{self.current_pixmap.height()}."
            )

        except Exception as exc:
            QMessageBox.critical(
                self,
                "Render Error",
                f"Failed to render PDF page.\n\n{exc}"
            )
            self._log(f"Render error: {exc}")

    def _update_page_buttons(self) -> None:
        has_pdf = self.page_count > 0
        self.prev_button.setEnabled(has_pdf and self.current_page_index > 0)
        self.next_button.setEnabled(has_pdf and self.current_page_index < self.page_count - 1)

    def _map_rotated_point_to_original_render(self, x: float, y: float) -> tuple[float, float]:
        if self.current_pixmap is None:
            raise RuntimeError("No pixmap is available.")

        original_w = float(self.current_pixmap.width())
        original_h = float(self.current_pixmap.height())
        angle = self._get_current_rotation_degrees() % 360

        if angle == 0:
            return x, y

        if angle == 90:
            return y, original_h - x

        if angle == 180:
            return original_w - x, original_h - y

        if angle == 270:
            return original_w - y, x

        return x, y

    def _preview_rect_to_pdf_selection(self, rect: QRect) -> SelectionRect:
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            raise RuntimeError("Invalid selection rectangle.")

        x0 = rect.x() / self.current_display_scale_x
        y0 = rect.y() / self.current_display_scale_y
        x1 = (rect.x() + rect.width()) / self.current_display_scale_x
        y1 = (rect.y() + rect.height()) / self.current_display_scale_y

        points = [
            self._map_rotated_point_to_original_render(x0, y0),
            self._map_rotated_point_to_original_render(x1, y0),
            self._map_rotated_point_to_original_render(x0, y1),
            self._map_rotated_point_to_original_render(x1, y1),
        ]

        xs = [point[0] for point in points]
        ys = [point[1] for point in points]

        render_x0 = min(xs)
        render_y0 = min(ys)
        render_x1 = max(xs)
        render_y1 = max(ys)

        pdf_x = render_x0 / self.render_zoom
        pdf_y = render_y0 / self.render_zoom
        pdf_w = (render_x1 - render_x0) / self.render_zoom
        pdf_h = (render_y1 - render_y0) / self.render_zoom

        return SelectionRect(
            x=pdf_x,
            y=pdf_y,
            width=pdf_w,
            height=pdf_h,
        )

    def _build_export_selections(self) -> dict[int, SelectionRect]:
        self._save_current_selection()

        if not self.checked_pages:
            if self._is_whole_page_output_area() and self.page_count > 0:
                self.checked_pages.add(self.current_page_index)
            else:
                raise RuntimeError(
                    "No checked pages exist. Please select an area and check pages for export, "
                    "or choose Output Area = Whole Page."
                )

        result = {}

        for page_index in sorted(self.checked_pages):
            if self._is_whole_page_output_area():
                result[page_index] = self._get_full_page_selection(page_index)
                continue

            rect = self.page_selections.get(page_index)

            if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                continue

            result[page_index] = self._preview_rect_to_pdf_selection(rect)

        if not result:
            if self._is_whole_page_output_area():
                raise RuntimeError("No valid pages were found for Whole Page export.")

            raise RuntimeError(
                "Checked pages do not have valid selections. "
                "Select an area or choose Output Area = Whole Page."
            )

        return result


    def on_selection_changed(self, rect: QRect) -> None:
        self._push_undo_state()
        self._update_selection_info(rect)

        if self.page_count > 0:
            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                self.page_selections.pop(self.current_page_index, None)
                self.page_selection_display_sizes.pop(self.current_page_index, None)
                self.checked_pages.discard(self.current_page_index)
                self._refresh_current_page_check_state()
                self._refresh_page_list_item(self.current_page_index)
                self._log(f"Selection cleared for page {self.current_page_index + 1}.")
            else:
                if hasattr(self, "output_area_combo") and self.output_area_combo.currentData() != "selected_area":
                    self._apply_combo_data(self.output_area_combo, "selected_area")
                    self.update_output_area_states()
                    self._log("Output Area automatically changed to Selected Area.")

                    if not getattr(self, "_selection_output_area_notice_shown", False):
                        self._selection_output_area_notice_shown = True
                        QMessageBox.information(
                            self,
                            "Output Area Changed",
                            "Output Area changed to Selected Area.\n\n"
                            "Because you selected an area manually, the output will use "
                            "the selected area instead of the whole page."
                        )

                self.page_selections[self.current_page_index] = QRect(rect)
                self._remember_selection_display_size(self.current_page_index)
                self.checked_pages.add(self.current_page_index)
                self._refresh_current_page_check_state()
                self._refresh_page_list_item(self.current_page_index)
                self._log(
                    f"Selection changed on page {self.current_page_index + 1}: "
                    f"x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}"
                )

            self.is_modified = True
            self.update_poster_sheet_estimate()

    def new_project(self) -> None:
        if not self._confirm_discard_changes():
            return

        self.page_selections.clear()
        self.page_selection_display_sizes.clear()
        self.page_rotations.clear()
        self.checked_pages.clear()

        if hasattr(self, "workspace_items"):
            self.workspace_items.clear()
            self.current_workspace_index = None
        if hasattr(self, "workspace_pdf_list"):
            self.workspace_pdf_list.clear()
        self.undo_stack.clear()
        self.redo_stack.clear()
        self._update_undo_redo_actions()
        self.last_exported_pdf_path = None
        self.current_pdf_path = None
        self.current_project_path = None
        self.current_page_index = 0
        self.page_count = 0
        self.current_pixmap = None
        self.rotation_degrees = 0
        self.preview_zoom_factor = 1.0
        self.fit_to_page_enabled = True
        self.preview_label.clear_preview()
        self.pdf_path_label.setText(t("pdf_not_selected"))
        self.pdf_info_label.setText(t("pages_empty"))
        self.render_info_label.setText(t("preview_not_rendered"))
        self.zoom_info_label.setText(t("zoom_fit_page"))
        self.rotation_info_label.setText(t("rotation_zero"))
        self.selection_info_label.setText(t("selection_none"))
        self.checked_pages_label.setText(t("checked_pages_zero"))
        self.page_label.setText(t("page_empty"))
        if hasattr(self, "page_list_widget"):
            self.page_list_widget.clear()
        self._update_page_buttons()
        self.is_modified = False
        self._log("New Project selected.")

    def open_project(self) -> None:
        if not self._confirm_discard_changes():
            return

        file_path, _ = QFileDialog.getOpenFileName(
            self,
            t("menu_open_project"),
            str(PROJECTS_DIR),
            t("project_files")
        )

        if not file_path:
            return

        self.load_project_from_path(file_path)

    def save_project(self) -> None:
        if not self.current_project_path:
            self.save_project_as()
            return

        try:
            data = self._collect_project_data()
            self.project_manager.save_project(self.current_project_path, data)
            self._add_recent_project(self.current_project_path)
            self.is_modified = False
            self._log(f"Project saved: {self.current_project_path}")
        except Exception as exc:
            QMessageBox.critical(
                self,
                t("save_project_error"),
                f"Failed to save project.\n\n{exc}"
            )
            self._log(f"Save project error: {exc}")

    def save_project_as(self) -> None:
        default_path = PROJECTS_DIR / "project.a4a3proj"

        file_path, _ = QFileDialog.getSaveFileName(
            self,
            t("menu_save_project_as"),
            str(default_path),
            t("project_files")
        )

        if not file_path:
            return

        try:
            data = self._collect_project_data()
            self.project_manager.save_project(file_path, data)
            saved_path = Path(file_path)
            if saved_path.suffix.lower() != ".a4a3proj":
                saved_path = saved_path.with_suffix(".a4a3proj")

            self.current_project_path = str(saved_path)
            self._add_recent_project(self.current_project_path)
            self.is_modified = False
            self._log(f"Project saved as: {self.current_project_path}")
        except Exception as exc:
            QMessageBox.critical(
                self,
                t("save_project_error"),
                f"Failed to save project.\n\n{exc}"
            )
            self._log(f"Save project error: {exc}")


    def _make_workspace_item(self, pdf_path: str) -> dict:
        page_count = 0
        try:
            doc = fitz.open(pdf_path)
            page_count = doc.page_count
            doc.close()
        except Exception:
            page_count = 0

        return {
            "pdf_path": pdf_path,
            "page_count": page_count,
            "current_page_index": 0,
            "page_selections": {},
            "checked_pages": set(),
        }

    def _save_current_workspace_state(self) -> None:
        if self.current_workspace_index is None:
            return

        if self.current_workspace_index < 0 or self.current_workspace_index >= len(self.workspace_items):
            return

        if self.page_count > 0:
            self._save_current_selection()

        item = self.workspace_items[self.current_workspace_index]
        item["current_page_index"] = self.current_page_index
        item["page_selections"] = {page: QRect(rect) for page, rect in self.page_selections.items()}
        item["checked_pages"] = set(self.checked_pages)
        item["page_rotations"] = {int(page): int(deg) % 360 for page, deg in self.page_rotations.items()}

        self._refresh_workspace_list_text()

    def _load_workspace_index(self, index: int) -> None:
        if index < 0 or index >= len(self.workspace_items):
            return

        if self.current_workspace_index is not None and self.current_workspace_index != index:
            self._save_current_workspace_state()

        item = self.workspace_items[index]
        pdf_path = item["pdf_path"]

        self._log(f"Loading source PDF: {pdf_path}")

        self.page_count = self.pdf_renderer.open(pdf_path)
        self.current_pdf_path = pdf_path
        self.current_workspace_index = index

        self.page_selections = {
            int(page): QRect(rect)
            for page, rect in item.get("page_selections", {}).items()
        }
        self.checked_pages = set(item.get("checked_pages", set()))
        self.page_rotations = {
            int(page): int(deg) % 360
            for page, deg in item.get("page_rotations", {}).items()
        }

        target_page = int(item.get("current_page_index", 0))
        self.current_page_index = max(0, min(target_page, self.page_count - 1))
        self.rotation_degrees = self._get_current_rotation_degrees()

        self.pdf_path_label.setText(f"PDF: {pdf_path}")
        self.pdf_info_label.setText(f"Pages: {self.page_count}")
        self.selection_info_label.setText(t("selection_none"))

        self._render_current_page()
        self._rebuild_page_list()
        self._refresh_workspace_list_text()

        if hasattr(self, "workspace_pdf_list"):
            self.workspace_pdf_list.blockSignals(True)
            self.workspace_pdf_list.setCurrentRow(index)
            self.workspace_pdf_list.blockSignals(False)

    def _workspace_item_text(self, index: int, item: dict) -> str:
        pdf_path = item.get("pdf_path", "")
        name = Path(pdf_path).name
        page_count = item.get("page_count", 0)
        checked_count = len(item.get("checked_pages", set()))
        prefix = "▶ " if index == self.current_workspace_index else ""
        return f"{prefix}{index + 1}. {name}  |  {page_count} pages  |  checked {checked_count}"

    def _refresh_workspace_list_text(self) -> None:
        if not hasattr(self, "workspace_pdf_list"):
            return

        self._updating_workspace_list = True

        current_row = self.workspace_pdf_list.currentRow()
        self.workspace_pdf_list.clear()

        for index, item in enumerate(self.workspace_items):
            list_item = QListWidgetItem(self._workspace_item_text(index, item))
            list_item.setData(Qt.ItemDataRole.UserRole, item.get("pdf_path", ""))
            list_item.setToolTip(item.get("pdf_path", ""))
            self.workspace_pdf_list.addItem(list_item)

        if self.current_workspace_index is not None and 0 <= self.current_workspace_index < self.workspace_pdf_list.count():
            self.workspace_pdf_list.setCurrentRow(self.current_workspace_index)
        elif 0 <= current_row < self.workspace_pdf_list.count():
            self.workspace_pdf_list.setCurrentRow(current_row)

        self._updating_workspace_list = False



    def _is_supported_image_path(self, file_path: str) -> bool:
        suffix = Path(file_path).suffix.lower()
        return suffix in {".png", ".jpg", ".jpeg", ".bmp", ".webp"}

    def _prepare_source_file_for_workspace(self, file_path: str) -> str:
        suffix = Path(file_path).suffix.lower()

        if suffix == ".pdf":
            return file_path

        if self._is_supported_image_path(file_path):
            return self._convert_image_to_temp_pdf(file_path)

        raise RuntimeError(f"Unsupported file type: {file_path}")

    def _convert_image_to_temp_pdf(self, image_path: str) -> str:
        image_file = Path(image_path)

        if not image_file.exists():
            raise RuntimeError(f"Image file not found: {image_path}")

        # Temporary image imports are stored under data/image_imports.
        temp_dir = DATA_DIR / "image_imports"
        temp_dir.mkdir(parents=True, exist_ok=True)

        safe_stem = "".join(ch if ch not in '<>:"/\\\\|?*' else "_" for ch in image_file.stem)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        output_pdf = temp_dir / f"{safe_stem}_{timestamp}.pdf"

        doc = fitz.open()
        img_doc = None

        try:
            img_doc = fitz.open(str(image_file))
            rect = img_doc[0].rect

            if rect.width <= 0 or rect.height <= 0:
                raise RuntimeError("Invalid image size.")

            page = doc.new_page(width=rect.width, height=rect.height)
            page.insert_image(page.rect, filename=str(image_file))
            doc.save(str(output_pdf), garbage=4, deflate=True)

        finally:
            doc.close()
            if img_doc is not None:
                img_doc.close()

        self._log(f"Image converted to temporary PDF: {image_file} -> {output_pdf}")
        return str(output_pdf)


    def open_pdfs(self) -> None:
        file_paths, _ = QFileDialog.getOpenFileNames(
            self,
            "Open PDFs or Images",
            "",
            t("all_files")
        )

        if not file_paths:
            return

        try:
            self.workspace_items = []
            self.current_workspace_index = None

            if hasattr(self, "workspace_pdf_list"):
                self.workspace_pdf_list.clear()
            if hasattr(self, "export_order_list"):
                self.export_order_list.clear()

            for source_path in file_paths:
                pdf_path = self._prepare_source_file_for_workspace(source_path)
                self.workspace_items.append(self._make_workspace_item(pdf_path))

            self._refresh_workspace_list_text()

            if self.workspace_items:
                self._load_workspace_index(0)

            self.is_modified = True
            self._log(f"Open PDFs: {len(self.workspace_items)} file(s) loaded.")

        except Exception as exc:
            QMessageBox.critical(
                self,
                t("open_pdfs_error"),
                f"Failed to open PDFs.\n\n{exc}"
            )
            self._log(f"Open PDFs error: {exc}")


    def open_multiple_pdfs_workspace(self) -> None:
        file_paths, _ = QFileDialog.getOpenFileNames(
            self,
            t("open_pdfs_images"),
            "",
            t("pdf_files")
        )

        if not file_paths:
            return

        self.workspace_items = []
        self.current_workspace_index = None

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        for pdf_path in file_paths:
            self.workspace_items.append(self._make_workspace_item(pdf_path))

        self._refresh_workspace_list_text()

        if self.workspace_items:
            self._load_workspace_index(0)

        self.is_modified = True
        self._log(f"Workspace opened: {len(self.workspace_items)} PDFs")

    def add_pdfs_to_workspace(self) -> None:
        file_paths, _ = QFileDialog.getOpenFileNames(
            self,
            "Add PDFs or Images to Source PDFs",
            "",
            t("all_files")
        )

        if not file_paths:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        existing = {item.get("pdf_path") for item in self.workspace_items}

        for source_path in file_paths:
            pdf_path = self._prepare_source_file_for_workspace(source_path)

            if pdf_path not in existing:
                self.workspace_items.append(self._make_workspace_item(pdf_path))

        self._refresh_workspace_list_text()

        if self.current_workspace_index is None and self.workspace_items:
            self._load_workspace_index(0)

        self.is_modified = True

    def remove_selected_workspace_pdf(self) -> None:
        if not hasattr(self, "workspace_pdf_list"):
            return

        row = self.workspace_pdf_list.currentRow()

        if row < 0 or row >= len(self.workspace_items):
            return

        del self.workspace_items[row]

        if not self.workspace_items:
            self.current_workspace_index = None
            self.current_pdf_path = None
            self.page_count = 0
            self.current_page_index = 0
            self.page_selections.clear()
            self.page_selection_display_sizes.clear()
            self.page_rotations.clear()
            self.checked_pages.clear()
            self.preview_label.clear_preview()
            self.page_list_widget.clear()
            self.pdf_path_label.setText(t("pdf_not_selected"))
            self.pdf_info_label.setText(t("pages_empty"))
            self.selection_info_label.setText(t("selection_none"))
            self.checked_pages_label.setText(t("checked_pages_zero"))
            self._refresh_workspace_list_text()
            return

        if self.current_workspace_index is not None:
            if row == self.current_workspace_index:
                self.current_workspace_index = None
                self._load_workspace_index(min(row, len(self.workspace_items) - 1))
            elif row < self.current_workspace_index:
                self.current_workspace_index -= 1

        self._refresh_workspace_list_text()
        self.is_modified = True

    def on_workspace_pdf_clicked(self, item: QListWidgetItem) -> None:
        if self._updating_workspace_list:
            return

        row = self.workspace_pdf_list.row(item)

        if row < 0:
            return

        self._load_workspace_index(row)

    def on_workspace_rows_moved(self, *args) -> None:
        if self._updating_workspace_list:
            return

        if not hasattr(self, "workspace_pdf_list"):
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        old_items_by_path = {
            item.get("pdf_path"): item
            for item in self.workspace_items
        }

        new_items = []
        new_current_index = None

        for row in range(self.workspace_pdf_list.count()):
            list_item = self.workspace_pdf_list.item(row)
            pdf_path = list_item.data(Qt.ItemDataRole.UserRole)

            if pdf_path in old_items_by_path:
                new_items.append(old_items_by_path[pdf_path])

                if pdf_path == self.current_pdf_path:
                    new_current_index = row

        if len(new_items) == len(self.workspace_items):
            self.workspace_items = new_items
            self.current_workspace_index = new_current_index
            self._refresh_workspace_list_text()
            self.is_modified = True
            self._log("Source PDF order changed.")

    def _workspace_has_multiple_pdfs(self) -> bool:
        return hasattr(self, "workspace_items") and len(self.workspace_items) > 1


    def _export_order_item_text(self, workspace_index: int, page_index: int) -> str:
        item = self.workspace_items[workspace_index]
        pdf_name = Path(item.get("pdf_path", "")).name
        return f"{pdf_name}  -  Page {page_index + 1}"


    def _create_export_order_thumbnail(self, workspace_index: int, page_index: int) -> QIcon:
        try:
            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                return QIcon()

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path", "")

            if not pdf_path:
                return QIcon()

            renderer = PdfRenderer()
            renderer.open(pdf_path)
            pixmap = renderer.render_page(page_index, zoom=0.35)

            page_rotation = 0
            try:
                page_rotation = int(item.get("page_rotations", {}).get(page_index, 0)) % 360
            except Exception:
                page_rotation = 0

            if page_rotation:
                transform = QTransform()
                transform.rotate(page_rotation)
                pixmap = pixmap.transformed(
                    transform,
                    Qt.TransformationMode.SmoothTransformation,
                )

            if pixmap.isNull():
                return QIcon()

            canvas = QPixmap(96, 128)
            canvas.fill(QColor("#FFF8F0"))

            painter = QPainter(canvas)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)

            scaled = pixmap.scaled(
                86,
                118,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            x = int((96 - scaled.width()) / 2)
            y = int((128 - scaled.height()) / 2)

            painter.setBrush(QBrush(QColor("#FFFFFF")))
            painter.setPen(QPen(QColor("#B7C9D6"), 1))
            painter.drawRoundedRect(x - 2, y - 2, scaled.width() + 4, scaled.height() + 4, 4, 4)
            painter.drawPixmap(x, y, scaled)

            # Do not draw selection overlay here.
            # The selection rectangle is based on preview display coordinates and can be misleading
            # after thumbnail scaling. Double-click the item to review the exact selection in Preview.

            painter.end()
            return QIcon(canvas)

        except Exception as exc:
            self._log(f"Thumbnail creation failed: workspace={workspace_index}, page={page_index + 1}, error={exc}")
            return QIcon()




    def _add_export_order_item(self, workspace_index: int, page_index: int) -> None:
        if not hasattr(self, "export_order_list"):
            return

        list_item = QListWidgetItem(self._export_order_item_text(workspace_index, page_index))
        list_item.setData(
            Qt.ItemDataRole.UserRole,
            {
                "workspace_index": workspace_index,
                "page_index": page_index,
            }
        )

        pdf_path = self.workspace_items[workspace_index].get("pdf_path", "")
        list_item.setToolTip(f"{pdf_path}\nPage {page_index + 1}")
        list_item.setIcon(self._create_export_order_thumbnail(workspace_index, page_index))
        self.export_order_list.addItem(list_item)


    def sync_print_order_from_checked_pages_quiet(self) -> None:
        """Rebuild Print Order from checked pages without showing dialogs."""
        if not hasattr(self, "export_order_list"):
            return

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        self.export_order_list.clear()

        for workspace_index, item in enumerate(self.workspace_items):
            checked_pages = sorted(list(item.get("checked_pages", set())))

            for page_index in checked_pages:
                self._add_export_order_item(workspace_index, page_index)

        self._refresh_workspace_list_text()
        self._log(f"Print Order auto-synced: {self.export_order_list.count()} pages")
        self.update_action_summary()


    def refresh_export_order_from_checked_pages(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            QMessageBox.information(self, t("print_order"), "Workspace is empty.")
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        self.export_order_list.clear()

        for workspace_index, item in enumerate(self.workspace_items):
            checked_pages = sorted(list(item.get("checked_pages", set())))

            for page_index in checked_pages:
                self._add_export_order_item(workspace_index, page_index)

        if self.export_order_list.count() <= 0:
            QMessageBox.information(
                self,
                t("print_order"),
                "No selected pages found.\n\nSelect areas on pages first."
            )
            return

        self._auto_sync_print_order_enabled = True
        self._log(f"Print order refreshed: {self.export_order_list.count()} pages")
        self.update_action_summary()

    def _move_export_order_row(self, source_row: int, target_row: int) -> None:
        if not hasattr(self, "export_order_list"):
            return

        count = self.export_order_list.count()

        if source_row < 0 or source_row >= count:
            return

        if target_row < 0 or target_row >= count:
            return

        item = self.export_order_list.takeItem(source_row)
        self.export_order_list.insertItem(target_row, item)
        self.export_order_list.setCurrentRow(target_row)
        self.update_action_summary()

        # User manually changed order; stop automatic rebuild to preserve custom order.
        self._auto_sync_print_order_enabled = False

    def move_export_order_item_up(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        row = self.export_order_list.currentRow()

        if row <= 0:
            return

        self._move_export_order_row(row, row - 1)

    def move_export_order_item_down(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        row = self.export_order_list.currentRow()

        if row < 0 or row >= self.export_order_list.count() - 1:
            return

        self._move_export_order_row(row, row + 1)


    def on_export_order_item_double_clicked(self, item: QListWidgetItem) -> None:
        if item is None:
            return

        data = item.data(Qt.ItemDataRole.UserRole)

        if not isinstance(data, dict):
            return

        try:
            workspace_index = int(data.get("workspace_index"))
            page_index = int(data.get("page_index"))
        except Exception:
            return

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            return

        if workspace_index < 0 or workspace_index >= len(self.workspace_items):
            return

        try:
            if self.current_workspace_index != workspace_index:
                self._load_workspace_index(workspace_index)

            if page_index < 0 or page_index >= self.page_count:
                return

            self._save_current_selection()
            self.current_page_index = page_index
            self._render_current_page()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()

            self._log(
                f"Jumped from Print Order to source PDF {workspace_index + 1}, "
                f"page {page_index + 1}."
            )

        except Exception as exc:
            QMessageBox.warning(
                self,
                t("print_order"),
                f"Failed to jump to selected page.\n\n{exc}"
            )
            self._log(f"Print Order jump failed: {exc}")


    def _get_export_order_entries(self) -> list[tuple[int, int]]:
        entries: list[tuple[int, int]] = []

        if not hasattr(self, "export_order_list"):
            return entries

        for row in range(self.export_order_list.count()):
            item = self.export_order_list.item(row)
            data = item.data(Qt.ItemDataRole.UserRole)

            if not isinstance(data, dict):
                continue

            try:
                workspace_index = int(data.get("workspace_index"))
                page_index = int(data.get("page_index"))
            except Exception:
                continue

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            entries.append((workspace_index, page_index))

        return entries


    def _export_workspace_to_separate_pdfs(self, output_path: str, options: ExportOptions) -> list[str]:
        if not self.workspace_items:
            raise RuntimeError("Workspace is empty.")

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        export_order_entries = self._get_export_order_entries()

        if not export_order_entries:
            for workspace_index, item in enumerate(self.workspace_items):
                checked_pages = sorted(list(item.get("checked_pages", set())))
                for page_index in checked_pages:
                    export_order_entries.append((workspace_index, page_index))

        if not export_order_entries:
            raise RuntimeError("No pages are checked for export.")

        base_path = Path(output_path)
        output_files: list[str] = []
        exporter = PosterExporter()

        self._log(
            f"Separate export started. "
            f"mode={options.export_type}, paper={getattr(options, 'paper_size', 'a4')}, "
            f"scale={getattr(options, 'poster_scale', 1.0)}"
        )

        for order_index, entry in enumerate(export_order_entries, 1):
            workspace_index, page_index = entry

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path")
            selections_qrect = item.get("page_selections", {})
            checked_pages = set(item.get("checked_pages", set()))

            if not pdf_path:
                continue

            if page_index not in checked_pages:
                continue

            # Load correct PDF/page so coordinate conversion uses correct page data.
            self.page_count = self.pdf_renderer.open(pdf_path)
            self.current_pdf_path = pdf_path
            self.current_page_index = page_index
            self.current_pixmap = self.pdf_renderer.render_page(page_index, zoom=self.render_zoom)

            if self._is_whole_page_output_area():
                converted = {
                    page_index: self._get_full_page_selection_for_pdf(pdf_path, page_index)
                }
            else:
                rect = selections_qrect.get(page_index)

                if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    continue

                converted = {
                    page_index: self._preview_rect_to_pdf_selection(rect)
                }

            source_stem = Path(pdf_path).stem
            safe_source_stem = "".join(ch if ch not in '<>:"/\\\\|?*' else "_" for ch in source_stem)

            page_output = base_path.with_name(
                f"{base_path.stem}_{order_index:03d}_{safe_source_stem}_page_{page_index + 1:03d}{base_path.suffix}"
            )

            options.page_rotations = dict(item.get("page_rotations", {}))

            exporter.export(
                source_pdf_path=pdf_path,
                output_pdf_path=str(page_output),
                selections=converted,
                options=options,
            )

            output_files.append(str(page_output))
            self._log(f"Separate PDF created: {page_output}")

        if not output_files:
            raise RuntimeError("No valid selected pages were found for export.")

        self.last_exported_pdf_path = output_files[0]
        self._log(f"Separate export completed. Files created: {len(output_files)}")

        return output_files


    def _export_workspace_to_pdf(self, output_path: str, options: ExportOptions) -> None:
        if not self.workspace_items:
            raise RuntimeError("Workspace is empty.")

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        # Print Order list has priority.
        export_order_entries = self._get_export_order_entries()

        # If user did not prepare Print Order, build it from checked pages automatically.
        if not export_order_entries:
            for workspace_index, item in enumerate(self.workspace_items):
                checked_pages = sorted(list(item.get("checked_pages", set())))
                for page_index in checked_pages:
                    export_order_entries.append((workspace_index, page_index))

        if not export_order_entries:
            raise RuntimeError("No pages are checked for export.")

        temp_dir = DATA_DIR / "workspace_export_temp"
        temp_dir.mkdir(parents=True, exist_ok=True)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        temp_outputs = []
        exporter = PosterExporter()

        for order_index, entry in enumerate(export_order_entries):
            workspace_index, page_index = entry

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path")
            selections_qrect = item.get("page_selections", {})
            checked_pages = set(item.get("checked_pages", set()))

            if not pdf_path:
                continue

            if page_index not in checked_pages:
                continue

            # Load correct PDF/page so coordinate conversion uses correct page data.
            self.page_count = self.pdf_renderer.open(pdf_path)
            self.current_pdf_path = pdf_path
            self.current_page_index = page_index
            self.current_pixmap = self.pdf_renderer.render_page(page_index, zoom=self.render_zoom)

            if self._is_whole_page_output_area():
                converted = {
                    page_index: self._get_full_page_selection_for_pdf(pdf_path, page_index)
                }
            else:
                rect = selections_qrect.get(page_index)

                if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    continue

                converted = {
                    page_index: self._preview_rect_to_pdf_selection(rect)
                }

            part_path = temp_dir / f"workspace_order_{timestamp}_{order_index + 1:04d}.pdf"

            options.page_rotations = dict(item.get("page_rotations", {}))

            exporter.export(
                source_pdf_path=pdf_path,
                output_pdf_path=str(part_path),
                selections=converted,
                options=options,
            )

            temp_outputs.append(part_path)

        if not temp_outputs:
            raise RuntimeError("No valid selected pages were found for export.")

        merged = fitz.open()

        try:
            for part_path in temp_outputs:
                src = fitz.open(str(part_path))
                merged.insert_pdf(src)
                src.close()

            merged.save(output_path)
        finally:
            merged.close()

        self.last_exported_pdf_path = output_path
        self._log(f"Workspace export completed with custom page order: {output_path}")


    def _open_pdf_path(self, file_path: str, clear_selections: bool = True) -> None:
        if clear_selections and hasattr(self, "workspace_items"):
            self.workspace_items.clear()
            self.current_workspace_index = None
            if hasattr(self, "workspace_pdf_list"):
                self.workspace_pdf_list.clear()
            if hasattr(self, "export_order_list"):
                self.export_order_list.clear()

        self._log(f"Opening PDF: {file_path}")
        self.page_count = self.pdf_renderer.open(file_path)
        self.current_page_index = 0
        self.current_pdf_path = file_path

        if clear_selections:
            self.page_selections.clear()
            self.page_selection_display_sizes.clear()
            self.page_rotations.clear()
            self.checked_pages.clear()

        self.pdf_path_label.setText(f"PDF: {file_path}")
        self.pdf_info_label.setText(f"Pages: {self.page_count}")
        self.selection_info_label.setText(t("selection_none"))

        self._log(f"PDF opened: {file_path}")
        self._log(f"PDF page count: {self.page_count}")

        self._render_current_page()
        self._rebuild_page_list()

    def open_pdf(self) -> None:
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Open PDF",
            "",
            t("pdf_files")
        )

        if not file_path:
            return

        try:
            self._open_pdf_path(file_path, clear_selections=True)
            self.is_modified = True

        except Exception as exc:
            QMessageBox.critical(
                self,
                t("open_pdf_error"),
                f"Failed to open PDF.\n\n{exc}"
            )
            self._log(f"Open PDF error: {exc}")


    def go_to_page_dialog(self) -> None:
        if self.page_count <= 0:
            QMessageBox.information(self, t("go_to_page"), "Please open a PDF or image first.")
            return

        page_no, ok = QInputDialog.getInt(
            self,
            t("go_to_page"),
            f"Enter page number (1 - {self.page_count}):",
            value=self.current_page_index + 1,
            min=1,
            max=self.page_count,
        )

        if not ok:
            return

        target_index = page_no - 1

        if target_index == self.current_page_index:
            return

        self._save_current_selection()
        self.current_page_index = target_index
        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()
        self._log(f"Go to page: {page_no}")

    def find_text_dialog(self) -> None:
        if not self.current_pdf_path or self.page_count <= 0:
            QMessageBox.information(self, t("find_text"), "Please open a PDF first.")
            return

        text, ok = QInputDialog.getText(
            self,
            t("find_text"),
            "Enter text to find:",
            text=self.last_search_text,
        )

        if not ok:
            return

        query = text.strip()

        if not query:
            return

        self.last_search_text = query
        self.last_search_page_index = self.current_page_index - 1
        self.find_next_text()

    def find_next_text(self) -> None:
        if not self.current_pdf_path or self.page_count <= 0:
            QMessageBox.information(self, t("find_next"), "Please open a PDF first.")
            return

        query = (self.last_search_text or "").strip()

        if not query:
            self.find_text_dialog()
            return

        start_index = self.last_search_page_index + 1

        if start_index < 0:
            start_index = 0

        try:
            doc = fitz.open(self.current_pdf_path)

            try:
                # Search from the next page to the end, then wrap to the beginning.
                search_order = list(range(start_index, len(doc))) + list(range(0, start_index))

                for page_index in search_order:
                    page = doc.load_page(page_index)
                    hits = page.search_for(query)

                    if hits:
                        self._save_current_selection()
                        self.current_page_index = page_index
                        self.last_search_page_index = page_index
                        self.rotation_degrees = self._get_current_rotation_degrees()
                        self._render_current_page()

                        QMessageBox.information(
                            self,
                            t("find_text"),
                            f"Found '{query}' on page {page_index + 1}."
                        )
                        self._log(f"Find Text: '{query}' found on page {page_index + 1}")
                        return

            finally:
                doc.close()

            QMessageBox.information(
                self,
                t("find_text"),
                f"'{query}' was not found.\n\n"
                "Find Text works only with PDFs that already contain text.\n"
                "Scanned PDFs or image-only PDFs may require OCR in another tool before searching."
            )
            self._log(f"Find Text: '{query}' not found")

        except Exception as exc:
            QMessageBox.warning(
                self,
                t("find_text"),
                f"Search failed.\n\n{exc}"
            )
            self._log(f"Find Text error: {exc}")


    def previous_page(self) -> None:
        if self.current_page_index <= 0:
            return

        self._save_current_selection()
        self.current_page_index -= 1
        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()

    def next_page(self) -> None:
        if self.current_page_index >= self.page_count - 1:
            return

        self._save_current_selection()
        self.current_page_index += 1
        self.rotation_degrees = self._get_current_rotation_degrees()
        self._render_current_page()

    def on_wheel_zoom_requested(self, direction: int) -> None:
        if direction > 0:
            self.zoom_in()
        elif direction < 0:
            self.zoom_out()


    def _sync_zoom_factor_from_current_display(self) -> None:
        """When leaving Fit Page mode, sync zoom factor to the current displayed size.

        Without this, the first Zoom Out from Fit Page can look like Zoom In,
        because internal zoom may still be 100% while the fitted page is much smaller.
        """
        try:
            base_w = max(1, int(getattr(self, "current_display_base_width", 1)))
            base_h = max(1, int(getattr(self, "current_display_base_height", 1)))

            display_w, display_h = self._get_preview_display_size_tuple()

            factor_w = display_w / base_w
            factor_h = display_h / base_h
            factor = min(factor_w, factor_h)

            if factor > 0:
                self.preview_zoom_factor = max(
                    self.preview_zoom_min,
                    min(factor, self.preview_zoom_max),
                )

        except Exception as exc:
            self._log(f"Zoom sync skipped: {exc}")


    def zoom_in(self) -> None:
        if self.page_count <= 0:
            return

        self._save_current_selection()

        if self.fit_to_page_enabled:
            self._sync_zoom_factor_from_current_display()

        self.fit_to_page_enabled = False
        self.preview_zoom_factor = min(
            self.preview_zoom_factor * self.preview_zoom_step,
            self.preview_zoom_max,
        )

        self._render_current_page()
        self._log(f"Zoom In applied: {int(self.preview_zoom_factor * 100)}%.")


    def zoom_out(self) -> None:
        if self.page_count <= 0:
            return

        self._save_current_selection()

        if self.fit_to_page_enabled:
            self._sync_zoom_factor_from_current_display()

        self.fit_to_page_enabled = False
        self.preview_zoom_factor = max(
            self.preview_zoom_factor / self.preview_zoom_step,
            self.preview_zoom_min,
        )

        self._render_current_page()
        self._log(f"Zoom Out applied: {int(self.preview_zoom_factor * 100)}%.")


    def fit_page(self) -> None:
        self._push_undo_state()
        self._save_current_selection()
        self.fit_to_page_enabled = True
        self._show_pixmap()
        self._log("Fit Page applied.")

    def actual_size(self) -> None:
        self._push_undo_state()
        self._save_current_selection()
        self.fit_to_page_enabled = False
        self.preview_zoom_factor = 1.0
        self._show_pixmap()
        self._log("Actual Size applied.")

    def _make_display_basis_pixmap(self, source_pixmap: QPixmap) -> QPixmap:
        display_base = source_pixmap

        angle = self._get_current_rotation_degrees() % 360
        if angle != 0:
            transform = QTransform()
            transform.rotate(angle)
            display_base = source_pixmap.transformed(
                transform,
                Qt.TransformationMode.SmoothTransformation,
            )

        if self.fit_to_page_enabled:
            viewport_size = self.preview_scroll.viewport().size()
            return display_base.scaled(
                viewport_size,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

        scaled_width = max(1, int(display_base.width() * self.preview_zoom_factor))
        scaled_height = max(1, int(display_base.height() * self.preview_zoom_factor))

        return display_base.scaled(
            scaled_width,
            scaled_height,
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
    def _get_auto_select_threshold(self) -> int:
        if hasattr(self, "auto_select_sensitivity_combo"):
            return int(self.auto_select_sensitivity_combo.currentData())
        return 245

    def _auto_select_rect_from_pixmap(self, pixmap: QPixmap, threshold: int, padding: int = 8) -> QRect:
        image = pixmap.toImage()
        width = image.width()
        height = image.height()

        if width <= 0 or height <= 0:
            return QRect()

        min_x = width
        min_y = height
        max_x = -1
        max_y = -1

        step = max(1, min(width, height) // 1000)

        for y in range(0, height, step):
            for x in range(0, width, step):
                color = image.pixelColor(x, y)

                if (
                    color.red() < threshold
                    or color.green() < threshold
                    or color.blue() < threshold
                ):
                    min_x = min(min_x, x)
                    min_y = min(min_y, y)
                    max_x = max(max_x, x)
                    max_y = max(max_y, y)

        if max_x < min_x or max_y < min_y:
            return QRect()

        min_x = max(0, min_x - padding)
        min_y = max(0, min_y - padding)
        max_x = min(width - 1, max_x + padding)
        max_y = min(height - 1, max_y + padding)

        return QRect(
            min_x,
            min_y,
            max_x - min_x + 1,
            max_y - min_y + 1,
        ).normalized()

    def auto_select_content(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            QMessageBox.warning(self, t("no_pdf"), "Please open a PDF first.")
            return

        threshold = self._get_auto_select_threshold()
        rect = self.preview_label.auto_select_content(threshold=threshold, padding=8)

        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            QMessageBox.information(
                self,
                t("auto_select"),
                "No visible content was detected. Please select an area manually."
            )
            self._log("Auto Select Current Page: no content detected.")
            return

        self.page_selections[self.current_page_index] = QRect(rect)
        self.checked_pages.add(self.current_page_index)

        self._update_selection_info(rect)
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self._update_checked_pages_label()

        self.is_modified = True

        self._log(
            f"Auto Select Current Page {self.current_page_index + 1}: "
            f"x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}, "
            f"threshold={threshold}"
        )


    def _auto_select_all_pages_for_current_pdf_no_prompt(
        self,
        progress_dialog=None,
        progress_offset: int = 0,
        progress_label_prefix: str = "",
    ) -> int:
        if not self.current_pdf_path or self.page_count <= 0:
            return 0

        threshold = 245
        if hasattr(self, "auto_select_sensitivity_combo"):
            threshold = int(self.auto_select_sensitivity_combo.currentData())

        selected_count = 0
        original_page_index = self.current_page_index

        for page_index in range(self.page_count):
            if progress_dialog is not None:
                progress_dialog.setValue(progress_offset + page_index)
                progress_dialog.setLabelText(
                    f"{progress_label_prefix}Page {page_index + 1} / {self.page_count}"
                )
                QApplication.processEvents()

                if progress_dialog.wasCanceled():
                    break

            try:
                # Use the normal render path so this behaves like Auto Select Current Page.
                self.current_page_index = page_index
                self._render_current_page()
                QApplication.processEvents()

                rect = self.preview_label.auto_select_content(threshold=threshold, padding=8)

                if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    self.page_selections.pop(page_index, None)
                    self.page_selection_display_sizes.pop(page_index, None)
                    self.checked_pages.discard(page_index)
                    continue

                self.page_selections[page_index] = QRect(rect)
                self._remember_selection_display_size(page_index)
                self.checked_pages.add(page_index)
                selected_count += 1

            except Exception as exc:
                self._log(f"Auto Select failed on page {page_index + 1}: {exc}")

        self.current_page_index = max(0, min(original_page_index, self.page_count - 1))
        self._render_current_page()
        self._refresh_page_list_all_text()
        self._refresh_current_page_check_state()
        self._update_checked_pages_label()

        return selected_count


    def auto_select_all_workspace_pages(self) -> None:
        if not hasattr(self, "workspace_items") or not self.workspace_items:
            QMessageBox.information(self, t("auto_select_all_pages"), "Workspace is empty.")
            return

        result = QMessageBox.question(
            self,
            "Auto Select All Workspace Pages",
            "Automatically detect content area for all pages in all source PDFs?\n\n"
            "Existing selections may be replaced.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        original_workspace_index = self.current_workspace_index
        total_pages = 0

        for item in self.workspace_items:
            try:
                total_pages += int(item.get("page_count", 0))
            except Exception:
                pass

        if total_pages <= 0:
            QMessageBox.warning(self, t("auto_select_all_pages"), "No pages found in workspace.")
            return

        progress = QProgressDialog(
            t("preparing_auto_selection"),
            t("cancel"),
            0,
            total_pages,
            self,
        )
        progress.setWindowTitle(t("auto_select_all_pages"))
        progress.setWindowModality(Qt.WindowModality.ApplicationModal)
        progress.setMinimumDuration(0)
        progress.setValue(0)

        total_selected = 0
        processed_pages = 0
        canceled = False

        try:
            for workspace_index, item in enumerate(self.workspace_items):
                if progress.wasCanceled():
                    canceled = True
                    break

                pdf_name = Path(item.get("pdf_path", "")).name

                try:
                    self._load_workspace_index(workspace_index)
                    QApplication.processEvents()

                    selected_count = self._auto_select_all_pages_for_current_pdf_no_prompt(
                        progress_dialog=progress,
                        progress_offset=processed_pages,
                        progress_label_prefix=f"{pdf_name} - ",
                    )

                    total_selected += selected_count
                    processed_pages += self.page_count

                    self._save_current_workspace_state()

                    self._log(
                        f"Workspace auto selected: {pdf_name}, "
                        f"selected={selected_count}/{self.page_count}"
                    )

                except Exception as exc:
                    processed_pages += int(item.get("page_count", 0) or 0)
                    self._log(f"Workspace auto select failed: {item.get('pdf_path', '')}: {exc}")

            progress.setValue(total_pages)
            QApplication.processEvents()

        finally:
            progress.close()

        if original_workspace_index is not None and 0 <= original_workspace_index < len(self.workspace_items):
            self._load_workspace_index(original_workspace_index)
        elif self.workspace_items:
            self._load_workspace_index(0)

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        self.is_modified = True

        if canceled:
            QMessageBox.information(
                self,
                "Auto Select All Workspace Pages",
                f"Auto selection was canceled.\n\nSelected pages before cancel: {total_selected}"
            )
        else:
            QMessageBox.information(
                self,
                "Auto Select All Workspace Pages",
                f"Auto selection completed.\n\nSelected pages: {total_selected}/{total_pages}"
            )



    def _parse_page_range_text(self, range_text: str, page_count: int) -> list[int]:
        text = (range_text or "").strip().lower()

        if text in ("", "all", "*"):
            return list(range(page_count))

        result: list[int] = []

        for part in text.split(","):
            part = part.strip()

            if not part:
                continue

            if "-" in part:
                start_text, end_text = part.split("-", 1)
                start_page = int(start_text.strip())
                end_page = int(end_text.strip())

                if start_page <= 0 or end_page <= 0:
                    raise ValueError("Page numbers must be greater than zero.")

                if start_page > end_page:
                    raise ValueError(f"Invalid page range: {part}")

                for page_no in range(start_page, end_page + 1):
                    if page_no > page_count:
                        raise ValueError(f"Page {page_no} is out of range. Total pages: {page_count}")
                    page_index = page_no - 1
                    if page_index not in result:
                        result.append(page_index)
            else:
                page_no = int(part)

                if page_no <= 0:
                    raise ValueError("Page numbers must be greater than zero.")

                if page_no > page_count:
                    raise ValueError(f"Page {page_no} is out of range. Total pages: {page_count}")

                page_index = page_no - 1
                if page_index not in result:
                    result.append(page_index)

        if not result:
            raise ValueError("No valid pages were specified.")

        return result

    def auto_select_page_range(self) -> None:
        if self._is_whole_page_output_area():
            QMessageBox.information(
                self,
                t("auto_select_page_range"),
                "Auto Select is only needed when Output Area is Selected Area."
            )
            return

        if not self.current_pdf_path or self.page_count <= 0:
            QMessageBox.information(
                self,
                t("auto_select_page_range"),
                "Please open a PDF or image first."
            )
            return

        range_text, ok = QInputDialog.getText(
            self,
            t("auto_select_page_range"),
            "Enter page range to auto select:\n"
            "Examples: all, 1-50, 1,3,5, 10-20,35",
            text="1-50" if self.page_count >= 50 else "all",
        )

        if not ok:
            return

        try:
            page_indices = self._parse_page_range_text(range_text, self.page_count)
        except Exception as exc:
            QMessageBox.warning(
                self,
                "Invalid Page Range",
                str(exc)
            )
            return

        if not page_indices:
            return

        if len(page_indices) >= 200:
            result = QMessageBox.question(
                self,
                "Large Page Range",
                f"You selected {len(page_indices)} pages.\n\n"
                "Auto Select may take several minutes.\n"
                "You can cancel during processing.\n\n"
                "Continue?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )

            if result != QMessageBox.StandardButton.Yes:
                return

        threshold = self._get_auto_select_threshold()
        selected_count = 0
        original_page_index = self.current_page_index

        progress = QProgressDialog(
            t("preparing_auto_selection"),
            t("cancel"),
            0,
            len(page_indices),
            self,
        )
        progress.setWindowTitle(t("auto_select_page_range"))
        progress.setWindowModality(Qt.WindowModality.ApplicationModal)
        progress.setMinimumDuration(0)
        progress.setValue(0)
        progress.show()
        QApplication.processEvents()

        try:
            for position, page_index in enumerate(page_indices):
                progress.setValue(position)
                progress.setLabelText(
                    f"Auto selecting page {page_index + 1} / {self.page_count}"
                )
                QApplication.processEvents()

                if progress.wasCanceled():
                    break

                try:
                    self.current_page_index = page_index
                    self._render_current_page()
                    QApplication.processEvents()

                    rect = self.preview_label.auto_select_content(threshold=threshold, padding=8)

                    if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                        self.page_selections.pop(page_index, None)
                        self.checked_pages.discard(page_index)
                        continue

                    self.page_selections[page_index] = QRect(rect)
                    self.checked_pages.add(page_index)
                    selected_count += 1

                except Exception as exc:
                    self._log(f"Auto Select Page Range failed on page {page_index + 1}: {exc}")

            progress.setValue(len(page_indices))
            QApplication.processEvents()

        finally:
            progress.close()

            self.current_page_index = max(0, min(original_page_index, self.page_count - 1))
            self._render_current_page()
            self._refresh_page_list_all_text()
            self._refresh_current_page_check_state()
            self._update_checked_pages_label()

            if hasattr(self, "export_order_list"):
                self.export_order_list.clear()

        self.is_modified = True

        QMessageBox.information(
            self,
            t("auto_select_page_range"),
            f"Auto selection completed.\n\n"
            f"Selected pages: {selected_count}/{len(page_indices)}"
        )

        self._log(
            f"Auto Select Page Range completed: selected={selected_count}/{len(page_indices)}, "
            f"range={range_text}"
        )


    def auto_select_all_pages(self) -> None:
        if hasattr(self, "workspace_items") and len(self.workspace_items) > 1:
            self.auto_select_all_workspace_pages()
            return

        if not self.current_pdf_path or self.page_count <= 0:
            QMessageBox.information(
                self,
                t("auto_select_all_pages"),
                "Please open a PDF or image first."
            )
            return

        # Large PDFs can take a long time. Warn before starting.
        large_page_threshold = 200
        if self.page_count >= large_page_threshold:
            large_result = QMessageBox.question(
                self,
                "Large PDF Detected",
                f"This file has {self.page_count} pages.\n\n"
                "Auto Select All Pages may take several minutes and can use significant CPU.\n"
                "You can cancel during processing.\n\n"
                "Continue?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )

            if large_result != QMessageBox.StandardButton.Yes:
                return

        result = QMessageBox.question(
            self,
            t("auto_select_all_pages"),
            "Automatically detect content area for all pages?\n\n"
            "Existing selections may be replaced.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        progress = QProgressDialog(
            t("preparing_auto_selection"),
            t("cancel"),
            0,
            self.page_count,
            self,
        )
        progress.setWindowTitle(t("auto_select_all_pages"))
        progress.setWindowModality(Qt.WindowModality.ApplicationModal)
        progress.setMinimumDuration(0)
        progress.setValue(0)
        progress.show()
        QApplication.processEvents()

        selected_count = 0
        canceled = False

        try:
            selected_count = self._auto_select_all_pages_for_current_pdf_no_prompt(
                progress_dialog=progress,
                progress_offset=0,
                progress_label_prefix="",
            )

            if progress.wasCanceled():
                canceled = True

            progress.setValue(self.page_count)
            QApplication.processEvents()

        except Exception as exc:
            QMessageBox.critical(
                self,
                t("auto_select_all_pages"),
                f"Auto selection failed.\n\n{exc}"
            )
            self._log(f"Auto Select All Pages error: {exc}")
            return

        finally:
            progress.close()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        self.is_modified = True

        if canceled:
            QMessageBox.information(
                self,
                t("auto_select_all_pages"),
                f"Auto selection was canceled.\n\nSelected pages before cancel: {selected_count}"
            )
        else:
            QMessageBox.information(
                self,
                t("auto_select_all_pages"),
                f"Auto selection completed.\n\nSelected pages: {selected_count}/{self.page_count}"
            )

        self._log(
            f"Auto Select All Pages completed: selected={selected_count}/{self.page_count}"
        )





    def clear_all_selections(self) -> None:
        if not self.current_pdf_path and not getattr(self, "workspace_items", []):
            return

        result = QMessageBox.question(
            self,
            "Clear All Selections",
            "Clear all selected areas and checked pages?\n\n"
            "This affects the current workspace.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        if hasattr(self, "workspace_items") and self.workspace_items:
            if self.current_workspace_index is not None:
                self._save_current_workspace_state()

            for item in self.workspace_items:
                item["page_selections"] = {}
                item["checked_pages"] = set()
                item["current_page_index"] = int(item.get("current_page_index", 0))

            self.page_selections.clear()
            self.page_selection_display_sizes.clear()
            self.page_rotations.clear()
            self.checked_pages.clear()

            if self.current_workspace_index is not None:
                self._load_workspace_index(self.current_workspace_index)
            elif self.workspace_items:
                self._load_workspace_index(0)

            self._refresh_workspace_list_text()

        else:
            self.page_selections.clear()
            self.page_selection_display_sizes.clear()
            self.page_rotations.clear()
            self.checked_pages.clear()
            self.preview_label.clear_selection()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()
            self._update_checked_pages_label()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        self.selection_info_label.setText(t("selection_none"))
        self.is_modified = True
        self._log("All selections cleared.")


    def clear_selection(self) -> None:
        self._push_undo_state()
        self.preview_label.clear_selection()
        if self.page_count > 0:
            self.page_selections.pop(self.current_page_index, None)
            self.page_selection_display_sizes.pop(self.current_page_index, None)
            self.checked_pages.discard(self.current_page_index)
        self.selection_info_label.setText(t("selection_none"))
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self.is_modified = True
        self._log("Selection cleared.")

    def apply_selection_to_all_pages(self) -> None:
        self._push_undo_state()
        if self.page_count <= 0:
            QMessageBox.warning(self, t("no_pdf"), "Please open a PDF first.")
            return

        rect = self.preview_label.get_selection_rect()

        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            QMessageBox.warning(self, t("no_selection"), "Please select an area first.")
            return

        for page_index in range(self.page_count):
            self.page_selections[page_index] = QRect(rect)
            self._remember_selection_display_size(page_index)
            self.checked_pages.add(page_index)

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_all_text()
        self._log(
            f"Selection applied to all pages: x={rect.x()}, y={rect.y()}, "
            f"w={rect.width()}, h={rect.height()}, pages={self.page_count}"
        )
        QMessageBox.information(
            self,
            t("applied"),
            f"Selection was applied to all {self.page_count} pages."
        )


    def refresh_print_order_thumbnails(self) -> None:
        """Rebuild Print Order items so thumbnails reflect page rotation changes."""
        if not hasattr(self, "export_order_list"):
            return

        if self.export_order_list.count() <= 0:
            return

        entries = self._get_export_order_entries()

        if not entries:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        current_row = self.export_order_list.currentRow()

        self.export_order_list.clear()

        for workspace_index, page_index in entries:
            self._add_export_order_item(workspace_index, page_index)

        if 0 <= current_row < self.export_order_list.count():
            self.export_order_list.setCurrentRow(current_row)

        if hasattr(self, "update_action_summary"):
            self.update_action_summary()

        self._log("Print Order thumbnails refreshed.")


    def rotate_left(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            return

        self._save_current_selection()
        new_degrees = (self._get_current_rotation_degrees() - 90) % 360
        self._set_current_rotation_degrees(new_degrees)
        self._show_pixmap()
        self.refresh_print_order_thumbnails()
        self._log(f"Rotate Left applied on page {self.current_page_index + 1}: {new_degrees} degrees.")


    def rotate_right(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            return

        self._save_current_selection()
        new_degrees = (self._get_current_rotation_degrees() + 90) % 360
        self._set_current_rotation_degrees(new_degrees)
        self._show_pixmap()
        self.refresh_print_order_thumbnails()
        self._log(f"Rotate Right applied on page {self.current_page_index + 1}: {new_degrees} degrees.")



    def reset_view(self) -> None:
        """Reset preview view state for current page: rotation + zoom + fit page."""
        if self.page_count <= 0:
            return

        self._save_current_selection()

        self._set_current_rotation_degrees(0)
        self.preview_zoom_factor = 1.0
        self.fit_to_page_enabled = True

        self._render_current_page()

        if hasattr(self, "rotation_info_label"):
            self.rotation_info_label.setText(t("rotation_zero"))

        if hasattr(self, "zoom_info_label"):
            self.zoom_info_label.setText(t("zoom_fit_page"))

        self.refresh_print_order_thumbnails()
        self._log("View reset for current page: rotation=0°, zoom=Fit Page.")



    def reset_rotation(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            return

        self._save_current_selection()
        self._set_current_rotation_degrees(0)
        self._show_pixmap()
        self.refresh_print_order_thumbnails()
        self._log(f"Rotation reset on page {self.current_page_index + 1}.")


    def _build_export_confirmation_lines(self, limit: int = 30) -> list[str]:
        lines: list[str] = []

        if self._workspace_has_multiple_pdfs():
            if self.current_workspace_index is not None:
                self._save_current_workspace_state()

            entries = self._get_export_order_entries()

            if not entries:
                for workspace_index, item in enumerate(self.workspace_items):
                    checked_pages = sorted(list(item.get("checked_pages", set())))
                    for page_index in checked_pages:
                        entries.append((workspace_index, page_index))

            for order_no, (workspace_index, page_index) in enumerate(entries, 1):
                if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                    continue

                pdf_name = Path(self.workspace_items[workspace_index].get("pdf_path", "")).name
                lines.append(f"{order_no}. {pdf_name} - Page {page_index + 1}")

                if len(lines) >= limit:
                    remaining = len(entries) - limit
                    if remaining > 0:
                        lines.append(f"... and {remaining} more page(s)")
                    break

            return lines

        try:
            export_selections = self._build_export_selections()
        except Exception:
            return []

        for order_no, page_index in enumerate(sorted(export_selections.keys()), 1):
            pdf_name = Path(self.current_pdf_path or "").name
            lines.append(f"{order_no}. {pdf_name} - Page {page_index + 1}")

            if len(lines) >= limit:
                remaining = len(export_selections) - limit
                if remaining > 0:
                    lines.append(f"... and {remaining} more page(s)")
                break

        return lines

    def _confirm_export_order(self, output_path: str) -> bool:
        lines = self._build_export_confirmation_lines()

        if not lines:
            QMessageBox.warning(
                self,
                t("export"),
                "No selected pages were found for export."
            )
            return False

        preview = "\n".join(lines)
        message = (
            f"Create the print PDF using this page order?\n\n"
            f"{preview}\n\n"
            f"Output:\n{output_path}"
        )

        result = QMessageBox.question(
            self,
            t("confirm_export"),
            message,
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        return result == QMessageBox.StandardButton.Yes



    def _prompt_export_type(self) -> bool:
        dialog = QMessageBox(self)
        dialog.setWindowTitle(t("choose_export_type"))
        dialog.setIcon(QMessageBox.Icon.Question)
        dialog.setText("How do you want to export?")
        dialog.setInformativeText(
            "Poster Print Mode: split the selected area into A4 pages for poster printing.\n\n"
            "Single Page Mode: export the selected area as clean single-page output."
        )

        a3_button = dialog.addButton(t("poster_print_mode"), QMessageBox.ButtonRole.AcceptRole)
        selection_button = dialog.addButton(t("single_page_mode"), QMessageBox.ButtonRole.ActionRole)
        cancel_button = dialog.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)

        dialog.setDefaultButton(a3_button)
        dialog.exec()

        clicked = dialog.clickedButton()

        if clicked == cancel_button:
            return False

        if clicked == a3_button:
            self._apply_combo_data(self.export_type_combo, "a3_split")
            self.update_export_option_states()
            self._log("Export type selected from prompt: Poster Print Mode")
            return True

        if clicked == selection_button:
            self._apply_combo_data(self.export_type_combo, "selection_only")
            self.update_export_option_states()
            self._log("Export type selected from prompt: Single Page Mode")
            return True

        return False



    def create_poster_pdf(self) -> None:
        if hasattr(self, "export_type_combo"):
            self._apply_combo_data(self.export_type_combo, "a3_split")
            self.update_export_option_states()

        self.export_print_pdf(skip_type_prompt=True)

    def create_single_page_pdf(self) -> None:
        if hasattr(self, "export_type_combo"):
            self._apply_combo_data(self.export_type_combo, "selection_only")
            self.update_export_option_states()

        self.export_print_pdf(skip_type_prompt=True)


    def export_print_pdf(self, skip_type_prompt: bool = False) -> None:
        if not self.current_pdf_path:
            QMessageBox.warning(self, t("no_pdf"), "Please open a PDF file first.")
            return

        if not skip_type_prompt:
            if not self._prompt_export_type():
                return

        workspace_mode = self._workspace_has_multiple_pdfs()

        if not workspace_mode:
            try:
                export_selections = self._build_export_selections()
            except Exception as exc:
                QMessageBox.warning(self, t("no_selection"), str(exc))
                return
        else:
            export_selections = {}

        if workspace_mode:
            default_name = "workspace_export_A4.pdf"
        elif self.export_type_combo.currentData() == "selection_only":
            default_name = Path(self.current_pdf_path).stem + "_single_page.pdf"
        else:
            default_name = Path(self.current_pdf_path).stem + "_poster_print.pdf"
        default_path = EXPORTS_DIR / default_name

        output_path, _ = QFileDialog.getSaveFileName(
            self,
            t("menu_export_pdf"),
            str(default_path),
            t("pdf_files")
        )

        if not output_path:
            return

        if not self._confirm_export_order(output_path):
            return

        options = ExportOptions(
            export_type=self.export_type_combo.currentData(),
            selection_fit_mode=self.selection_fit_mode_combo.currentData(),
            page_orientation=self.page_orientation_combo.currentData(),
            output_mode=self.output_mode_combo.currentData(),
            split_layout=self.split_layout_combo.currentData(),
            add_numbers=self.numbering_check.isChecked(),
            add_cut_guides=self.cut_guides_check.isChecked(),
            quality_scale=float(self.export_quality_combo.currentData()),
            paper_size=self.paper_size_combo.currentData() if hasattr(self, "paper_size_combo") else "a4",
            poster_scale=(self.poster_scale_spin.value() / 100.0) if hasattr(self, "poster_scale_spin") else 1.0,
            tile_cols=self._get_fixed_a_series_tile_grid()[0] if hasattr(self, "_get_fixed_a_series_tile_grid") else None,
            tile_rows=self._get_fixed_a_series_tile_grid()[1] if hasattr(self, "_get_fixed_a_series_tile_grid") else None,
            page_rotations=dict(getattr(self, "page_rotations", {})),
        )

        try:
            self._log("Export started.")
            self._log(f"Output: {output_path}")
            self._log(f"Export type: {options.export_type}")
            self._log(f"Selection fit mode: {options.selection_fit_mode}")
            self._log(f"Page orientation: {options.page_orientation}")
            self._log(f"Export quality scale: {options.quality_scale}")
            self._log(f"Tiling method: {options.output_mode}")
            self._log(f"Split layout: {options.split_layout}")
            self._log(f"Cut guide lines: {options.add_cut_guides}")
            self._log(f"Selected pages: {len(export_selections)}")
            self._log("Batch output: single_pdf")
            self._log(f"Auto select sensitivity: {self.auto_select_sensitivity_combo.currentText()} / {self.auto_select_sensitivity_combo.currentData()}")

            if workspace_mode:
                if self.batch_output_combo.currentData() == "separate_pdf_per_page":
                    output_files = self._export_workspace_to_separate_pdfs(output_path, options)

                    QMessageBox.information(
                        self,
                        t("export_complete"),
                        "Separate PDF files were created:\n\n" + "\n".join(output_files[:10])
                    )

                    if output_files:
                        self._open_file_with_default_app(output_files[0])

                    return

                self._export_workspace_to_pdf(output_path, options)
                QMessageBox.information(
                    self,
                    t("export_complete"),
                    f"Print output PDF was created:\n\n{output_path}"
                )
                return

            exporter = PosterExporter()

            if self.batch_output_combo.currentData() == "separate_pdf_per_page":
                base_path = Path(output_path)
                output_files = []

                for page_index, selection in export_selections.items():
                    page_output = base_path.with_name(
                        f"{base_path.stem}_page_{page_index + 1:03d}{base_path.suffix}"
                    )

                    exporter.export(
                        source_pdf_path=self.current_pdf_path,
                        output_pdf_path=str(page_output),
                        selections={page_index: selection},
                        options=options,
                    )
                    output_files.append(str(page_output))

                if output_files:
                    self.last_exported_pdf_path = output_files[0]

                self._log(f"Export completed. Files created: {len(output_files)}")
                QMessageBox.information(
                    self,
                    t("export_complete"),
                    "Separate PDF files were created:\n\n" + "\n".join(output_files[:10])
                )
                try:
                    if output_files:
                        self._open_file_with_default_app(output_files[0])
                        self._log(f"Opened first exported PDF: {output_files[0]}")
                except Exception as exc:
                    self._log(f"Open exported PDF failed: {exc}")
            else:
                exporter.export(
                    source_pdf_path=self.current_pdf_path,
                    output_pdf_path=output_path,
                    selections=export_selections,
                    options=options,
                )

                self.last_exported_pdf_path = output_path

                self._log("Export completed.")
                QMessageBox.information(
                    self,
                    t("export_complete"),
                    f"Output PDF was created:\n\n{output_path}"
                )
                try:
                    self._open_file_with_default_app(output_path)
                    self._log(f"Opened exported PDF: {output_path}")
                except Exception as exc:
                    self._log(f"Open exported PDF failed: {exc}")

        except Exception as exc:
            QMessageBox.critical(
                self,
                t("export_error"),
                f"Failed to export split print PDF.\n\n{exc}"
            )
            self._log(f"Export error: {exc}")

    def _create_temp_print_pdf(self) -> str:
        if not self.current_pdf_path:
            raise RuntimeError("Please open a PDF first.")

        export_selections = self._build_export_selections()

        temp_dir = DATA_DIR / "temp_print"
        temp_dir.mkdir(parents=True, exist_ok=True)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        temp_path = temp_dir / f"temp_print_{timestamp}.pdf"

        options = ExportOptions(
            export_type=self.export_type_combo.currentData(),
            selection_fit_mode=self.selection_fit_mode_combo.currentData(),
            page_orientation=self.page_orientation_combo.currentData(),
            output_mode=self.output_mode_combo.currentData(),
            split_layout=self.split_layout_combo.currentData(),
            add_numbers=self.numbering_check.isChecked(),
            add_cut_guides=self.cut_guides_check.isChecked(),
            quality_scale=float(self.export_quality_combo.currentData()),
            paper_size=self.paper_size_combo.currentData() if hasattr(self, "paper_size_combo") else "a4",
            poster_scale=(self.poster_scale_spin.value() / 100.0) if hasattr(self, "poster_scale_spin") else 1.0,
            tile_cols=self._get_fixed_a_series_tile_grid()[0] if hasattr(self, "_get_fixed_a_series_tile_grid") else None,
            tile_rows=self._get_fixed_a_series_tile_grid()[1] if hasattr(self, "_get_fixed_a_series_tile_grid") else None,
            page_rotations=dict(getattr(self, "page_rotations", {})),
        )

        exporter = PosterExporter()
        exporter.export(
            source_pdf_path=self.current_pdf_path,
            output_pdf_path=str(temp_path),
            selections=export_selections,
            options=options,
        )

        self.last_temp_print_pdf_path = str(temp_path)
        self._log(f"Temporary print PDF created: {temp_path}")

        return str(temp_path)
    def open_page_collector_dialog(self) -> None:
        dialog = PageCollectorDialog(self)
        dialog.exec()

    def _open_file_with_default_app(self, file_path: str) -> None:
        try:
            path = Path(file_path).resolve()

            if not path.exists():
                self._log(f"Open file skipped, not found: {path}")
                return

            os.startfile(str(path))
            self._log(f"Opened file with default app: {path}")

        except Exception as exc:
            self._log(f"Open file with default app failed: {exc}")


    def open_exports_folder(self) -> None:
        try:
            EXPORTS_DIR.mkdir(parents=True, exist_ok=True)
            os.startfile(str(EXPORTS_DIR))
            self._log(f"Opened exports folder: {EXPORTS_DIR}")
        except Exception as exc:
            QMessageBox.critical(
                self,
                t("open_exports_folder"),
                f"Failed to open exports folder.\n\n{exc}"
            )
            self._log(f"Open exports folder error: {exc}")


    def open_last_exported_pdf(self) -> None:
        if not self.last_exported_pdf_path:
            QMessageBox.information(
                self,
                t("menu_open_last_exported_pdf"),
                "No exported PDF is available yet.\n\nPlease export a PDF first."
            )
            return

        path = Path(self.last_exported_pdf_path)

        if not path.exists():
            QMessageBox.warning(
                self,
                t("menu_open_last_exported_pdf"),
                f"The last exported PDF was not found:\n\n{path}"
            )
            return

        try:
            os.startfile(str(path))
            self._log(f"Opened last exported PDF: {path}")
        except Exception as exc:
            QMessageBox.critical(
                self,
                t("open_error"),
                f"Failed to open the exported PDF.\n\n{exc}"
            )
            self._log(f"Open last exported PDF error: {exc}")

    def direct_print_last_exported_pdf(self) -> None:
        self.print_last_exported_pdf_with_dialog()

    def print_last_exported_pdf_with_dialog(self) -> None:
        if not self.last_exported_pdf_path:
            QMessageBox.information(
                self,
                "Print",
                "No exported PDF is available yet.\n\nPlease export a PDF first."
            )
            return

        path = Path(self.last_exported_pdf_path)

        if not path.exists():
            QMessageBox.warning(
                self,
                "Print",
                f"The last exported PDF was not found:\n\n{path}"
            )
            return

        printer = QPrinter(QPrinter.PrinterMode.HighResolution)
        printer.setResolution(self.print_dpi)
        printer.setFullPage(False)

        dialog = QPrintDialog(printer, self)
        dialog.setWindowTitle(t("print_exported_pdf"))

        if dialog.exec() != QPrintDialog.DialogCode.Accepted:
            self._log("Print canceled.")
            return

        try:
            self._print_pdf_to_printer(str(path), printer)
            self._log(f"Printed PDF with Qt Print Dialog: {path}")
            QMessageBox.information(
                self,
                "Print",
                "Print job was sent to the printer."
            )
        except Exception as exc:
            QMessageBox.critical(
                self,
                t("print_error"),
                f"Failed to print PDF.\n\n{exc}"
            )
            self._log(f"Qt print error: {exc}")

    def _print_pdf_to_printer(self, pdf_path: str, printer: QPrinter) -> None:
        document = fitz.open(pdf_path)
        painter = QPainter()

        if not painter.begin(printer):
            document.close()
            raise RuntimeError("Failed to start printer painter.")

        try:
            page_count = len(document)
            dpi = max(150, int(printer.resolution()))
            zoom = dpi / 72.0

            page_rect = printer.pageRect(QPrinter.Unit.DevicePixel)
            target_width = int(page_rect.width())
            target_height = int(page_rect.height())

            for page_index in range(page_count):
                if page_index > 0:
                    printer.newPage()

                page = document.load_page(page_index)
                matrix = fitz.Matrix(zoom, zoom)

                pix = page.get_pixmap(
                    matrix=matrix,
                    alpha=False,
                    colorspace=fitz.csRGB,
                )

                image = QImage(
                    pix.samples,
                    pix.width,
                    pix.height,
                    pix.stride,
                    QImage.Format.Format_RGB888,
                ).copy()

                scaled = image.scaled(
                    target_width,
                    target_height,
                    Qt.AspectRatioMode.KeepAspectRatio,
                    Qt.TransformationMode.SmoothTransformation,
                )

                x = int((target_width - scaled.width()) / 2)
                y = int((target_height - scaled.height()) / 2)

                painter.drawImage(x, y, scaled)

        finally:
            painter.end()
            document.close()
    def print_pdf(self) -> None:
        self._log("Print selected.")

        if not self.current_pdf_path:
            QMessageBox.information(
                self,
                "Print",
                "Please open a PDF first."
            )
            return

        if not self._prompt_export_type():
            return

        try:
            if hasattr(self, "print_quality_combo"):
                self.print_dpi = int(self.print_quality_combo.currentData())

            self._log("Creating temporary PDF for printing...")
            temp_pdf_path = self._create_temp_print_pdf()
        except Exception as exc:
            QMessageBox.warning(
                self,
                "Print",
                f"Failed to create temporary print PDF.\n\n{exc}"
            )
            self._log(f"Temporary print PDF error: {exc}")
            return

        result = QMessageBox.question(
            self,
            "Print",
            "A temporary print PDF was created from the current settings.\n\n"
            "Yes: Print now with printer selection dialog\n"
            "No: Open the temporary PDF and print manually",
            QMessageBox.StandardButton.Yes |
            QMessageBox.StandardButton.No |
            QMessageBox.StandardButton.Cancel
        )

        if result == QMessageBox.StandardButton.Yes:
            old_last_exported = self.last_exported_pdf_path
            self.last_exported_pdf_path = temp_pdf_path

            try:
                self.print_last_exported_pdf_with_dialog()
            finally:
                self.last_exported_pdf_path = old_last_exported

        elif result == QMessageBox.StandardButton.No:
            try:
                os.startfile(temp_pdf_path)
                self._log(f"Opened temporary print PDF: {temp_pdf_path}")
            except Exception as exc:
                QMessageBox.critical(
                    self,
                    t("open_error"),
                    f"Failed to open temporary print PDF.\n\n{exc}"
                )
                self._log(f"Open temporary print PDF error: {exc}")
    def set_basic_mode(self) -> None:
        self.mode_label.setText(t("mode_basic"))
        self._log("Switched to Basic Mode.")

    def set_advanced_mode(self) -> None:
        self.mode_label.setText(t("mode_advanced"))
        self._log("Switched to Advanced Mode.")

    def show_log_panel(self) -> None:
        self.log_dock.show()
        self._log("Log panel shown.")

    def show_quick_start(self) -> None:
        QMessageBox.information(
            self,
            t("quick_start"),
            "1. Open PDF\n2. Drag on preview to select area\n3. Choose output mode\n4. Choose split layout\n5. Export split-print PDF\n6. Print the exported PDF with an A4 printer"
        )

    def run_diagnostics(self) -> None:
        self._log("Diagnostics started.")
        self._log(f"PDF loaded: {bool(self.current_pdf_path)}")
        self._log(f"Page count: {self.page_count}")
        self._log(f"Current page index: {self.current_page_index}")
        self._log(f"Pixmap exists: {self.current_pixmap is not None}")
        self._log(f"Selection pages: {len(self.page_selections)}")
        self._log(f"Checked pages: {len(self.checked_pages)}")
        self._log(f"Batch output: {self.batch_output_combo.currentData()}")
        self._log(f"Auto select sensitivity: {self.auto_select_sensitivity_combo.currentText()} / {self.auto_select_sensitivity_combo.currentData()}")
        self._log(f"Export type: {self.export_type_combo.currentData()}")
        self._log(f"Selection fit mode: {self.selection_fit_mode_combo.currentData()}")
        self._log(f"Page orientation: {self.page_orientation_combo.currentData()}")
        self._log(f"Export quality: {self.export_quality_combo.currentText()} / {self.export_quality_combo.currentData()}")
        self._log(f"Cut guides enabled: {self.cut_guides_check.isChecked()}")
        self._log(f"Display scale x: {self.current_display_scale_x}")
        self._log(f"Display scale y: {self.current_display_scale_y}")
        self._log(f"Render zoom: {self.render_zoom}")
        self._log(f"Preview zoom factor: {self.preview_zoom_factor}")
        self._log(f"Rotation degrees: {self.rotation_degrees}")
        self._log("Export quality scale: 2.5")

        current_rect = self.preview_label.get_selection_rect()
        self._log(
            f"Current selection: x={current_rect.x()}, y={current_rect.y()}, "
            f"w={current_rect.width()}, h={current_rect.height()}"
        )

        if self.current_pixmap is not None:
            self._log(
                f"Pixmap size: {self.current_pixmap.width()} x {self.current_pixmap.height()}"
            )

        self._log("Diagnostics finished.")

    def check_menu_actions(self) -> None:
        self._log("Menu action check started.")

        checks = [
            ("File > New Project", callable(self.new_project)),
            ("File > Open Project", callable(self.open_project)),
            ("File > Save Project", callable(self.save_project)),
            ("File > Save Project As", callable(self.save_project_as)),
            ("File > Open PDFs", callable(self.open_pdfs)),
                        ("File > Export PDF", callable(self.export_print_pdf)),
            ("File > Open Last Exported PDF", callable(self.open_last_exported_pdf)),
            ("File > Print", callable(self.print_pdf)),
            ("File > Direct Print Last Exported PDF", callable(self.direct_print_last_exported_pdf)),
            ("File > Qt Print Dialog", callable(self.print_last_exported_pdf_with_dialog)),
            ("Edit > Clear Selection", callable(self.clear_selection)),
            ("Edit > Apply Selection to All Pages", callable(self.apply_selection_to_all_pages)),
            ("View > Previous Page", callable(self.previous_page)),
            ("View > Next Page", callable(self.next_page)),
            ("View > Zoom In", callable(self.zoom_in)),
            ("View > Zoom Out", callable(self.zoom_out)),
            ("View > Fit Page", callable(self.fit_page)),
            ("View > Actual Size", callable(self.actual_size)),
            ("View > Rotate Left", callable(self.rotate_left)),
            ("View > Rotate Right", callable(self.rotate_right)),
            ("View > Reset Rotation", callable(self.reset_rotation)),
            ("View > Auto Select Current Page", callable(self.auto_select_content)),
            ("View > Auto Select All Pages", callable(self.auto_select_all_pages)),
        ]

        failed = []

        for name, ok in checks:
            if ok:
                self._log(f"OK: {name}")
            else:
                failed.append(name)
                self._log(f"FAILED: {name}")

        self._log(f"Menu action check completed. OK={len(checks) - len(failed)}, Failed={len(failed)}")

        if failed:
            QMessageBox.warning(
                self,
                t("menu_check"),
                "Some menu actions are not connected.\n\n" + "\n".join(failed)
            )
        else:
            QMessageBox.information(
                self,
                t("menu_check"),
                "All checked menu actions are connected."
            )



    def send_feedback(self) -> None:
        try:
            webbrowser.open("https://github.com/winjjungk-ar/pdf-poster-studio/issues/new")
            self._log("Opened feedback page.")
        except Exception as exc:
            QMessageBox.warning(
                self,
                t("send_feedback"),
                f"Failed to open feedback page.\\n\\n{exc}"
            )
            self._log(f"Open feedback page error: {exc}")


    def show_user_guide(self) -> None:
        guides = {
            "English": """
<h2>PDF Poster Studio - User Guide</h2>
<p>PDF Poster Studio creates print-ready PDFs from PDF and image files. It supports merging, page extraction, poster tiling, page rotation, and selected-area output.</p>
<hr>
<h3>1. Basic Workflow</h3>
<ol>
<li>Open PDFs / Images.</li>
<li>Choose a task from Home or toolbar.</li>
<li>Choose Output Area: Whole Page or Selected Area.</li>
<li>Build Print Order.</li>
<li>Create Poster PDF or Single Page PDF.</li>
</ol>
<hr>
<h3>2. Home Task Launcher</h3>
<ul>
<li><b>Merge PDFs</b>: combine full pages into one PDF.</li>
<li><b>Extract Pages</b>: export chosen page ranges.</li>
<li><b>Make Poster</b>: tile maps, posters, images, or drawings.</li>
<li><b>Rotate Pages</b>: rotate current, checked, or all pages.</li>
<li><b>Selected Area PDF</b>: export only a selected area.</li>
</ul>
<hr>
<h3>3. Make Poster</h3>
<ol>
<li>Choose Make Poster.</li>
<li>Select Open One File or Use Current Source PDFs.</li>
<li>Choose Whole Page or Selected Area.</li>
<li>Choose A4 or US Letter.</li>
<li>Choose Poster Small/Medium/Large/Huge, A-series, ANSI, or Arch preset.</li>
<li>Check Tiling Preview.</li>
<li>Build Print Order and click Poster PDF.</li>
</ol>
<hr>
<h3>4. Whole Page vs Selected Area</h3>
<ul>
<li><b>Whole Page</b>: uses the full page or image. Good for merging, extracting, or full-map posters.</li>
<li><b>Selected Area</b>: uses only the selected region. Good for zooming into part of a map or drawing.</li>
</ul>
<p>Dragging a selection automatically switches Output Area to Selected Area.</p>
<hr>
<h3>5. Merge PDFs</h3>
<ol>
<li>Choose Merge PDFs.</li>
<li>Open PDF/image files if needed.</li>
<li>The app uses Whole Page, One PDF, and Single Page Mode.</li>
<li>All source pages are added to Print Order.</li>
<li>Click Single Page PDF.</li>
</ol>
<hr>
<h3>6. Extract Pages</h3>
<ol>
<li>Choose Extract Pages.</li>
<li>Enter a range: all, 1-10, 1,3,5, or 10-20,35.</li>
<li>The default output is Separate PDF per selected page.</li>
<li>Change Output Files to One PDF if you want one combined file.</li>
<li>Click Single Page PDF.</li>
</ol>
<hr>
<h3>7. Rotate Pages</h3>
<ol>
<li>Choose Rotate Pages.</li>
<li>Select Current Page, Checked Pages, or All Pages.</li>
<li>Choose Rotate Left, Rotate Right, or Reset Rotation.</li>
<li>Print Order is prepared automatically.</li>
<li>Click Single Page PDF to save the rotated output.</li>
</ol>
<hr>
<h3>8. Single Page PDF</h3>
<p>Single Page PDF exports full pages or selected areas without poster tiling.</p>
<ul>
<li>Fit Width</li>
<li>Fit Whole Area</li>
<li>Fill Page Crop</li>
<li>Fit Height</li>
</ul>
<hr>
<h3>9. Output Files</h3>
<ul>
<li><b>One PDF</b>: combine all Print Order items into one PDF.</li>
<li><b>Separate PDF per selected page</b>: create one PDF for each item.</li>
</ul>
<hr>
<h3>10. Auto Select / Text Search / OCR</h3>
<ul>
<li><b>Auto Current</b>: auto-select current page content.</li>
<li><b>Auto All</b>: auto-select all pages.</li>
<li><b>Auto Range</b>: auto-select a range such as 1-20.</li>
<li><b>Find Text</b>: works only with PDFs that contain text. Scanned/image-only PDFs may require OCR in another tool.</li>
</ul>
<hr>
<h3>11. Exported Files and Projects</h3>
<ul>
<li>Generated PDFs are saved to the exports folder.</li>
<li>Use Open Exports Folder to find output files.</li>
<li>Use Save Project As to save Source PDFs, selections, Print Order, and settings.</li>
</ul>
""",

            "한국어": """
<h2>PDF Poster Studio - 사용 방법</h2>
<p>PDF Poster Studio는 PDF와 이미지 파일로 출력용 PDF를 만드는 프로그램입니다. PDF 합치기, 페이지 추출, 포스터 분할, 페이지 회전, 선택 영역 출력이 가능합니다.</p>
<hr>
<h3>1. 기본 작업 순서</h3>
<ol>
<li>Open PDFs / Images로 파일을 엽니다.</li>
<li>Home 또는 툴바에서 작업을 선택합니다.</li>
<li>Output Area를 Whole Page 또는 Selected Area로 선택합니다.</li>
<li>Build Print Order를 실행합니다.</li>
<li>Poster PDF 또는 Single Page PDF를 만듭니다.</li>
</ol>
<hr>
<h3>2. Home 작업 메뉴</h3>
<ul>
<li><b>Merge PDFs</b>: 전체 페이지를 하나의 PDF로 합칩니다.</li>
<li><b>Extract Pages</b>: 원하는 페이지 범위만 추출합니다.</li>
<li><b>Make Poster</b>: 지도, 포스터, 이미지, 도면을 여러 장으로 나눕니다.</li>
<li><b>Rotate Pages</b>: 현재/체크/전체 페이지를 회전합니다.</li>
<li><b>Selected Area PDF</b>: 선택한 영역만 PDF로 출력합니다.</li>
</ul>
<hr>
<h3>3. 포스터 만들기</h3>
<ol>
<li>Make Poster를 선택합니다.</li>
<li>Open One File 또는 Use Current Source PDFs를 선택합니다.</li>
<li>Whole Page 또는 Selected Area를 선택합니다.</li>
<li>A4 또는 US Letter를 선택합니다.</li>
<li>Poster Small/Medium/Large/Huge, A-series, ANSI, Arch 프리셋을 선택합니다.</li>
<li>Tiling Preview를 확인합니다.</li>
<li>Build Print Order 후 Poster PDF를 누릅니다.</li>
</ol>
<hr>
<h3>4. Whole Page / Selected Area</h3>
<ul>
<li><b>Whole Page</b>: 전체 페이지 또는 전체 이미지를 사용합니다. PDF 합치기, 페이지 추출, 전체 지도/포스터 출력에 좋습니다.</li>
<li><b>Selected Area</b>: 선택한 영역만 사용합니다. 지도나 도면 일부 확대에 좋습니다.</li>
</ul>
<p>마우스로 영역을 선택하면 Output Area가 자동으로 Selected Area로 바뀝니다.</p>
<hr>
<h3>5. PDF 합치기</h3>
<ol>
<li>Merge PDFs를 선택합니다.</li>
<li>필요하면 PDF/이미지를 엽니다.</li>
<li>앱이 Whole Page, One PDF, Single Page Mode로 자동 설정합니다.</li>
<li>모든 Source 페이지가 Print Order에 추가됩니다.</li>
<li>Single Page PDF를 누릅니다.</li>
</ol>
<hr>
<h3>6. 페이지 추출</h3>
<ol>
<li>Extract Pages를 선택합니다.</li>
<li>all, 1-10, 1,3,5, 10-20,35 같은 범위를 입력합니다.</li>
<li>기본 출력은 Separate PDF per selected page입니다.</li>
<li>하나의 PDF로 만들려면 Output Files를 One PDF로 바꿉니다.</li>
<li>Single Page PDF를 누릅니다.</li>
</ol>
<hr>
<h3>7. 페이지 회전</h3>
<ol>
<li>Rotate Pages를 선택합니다.</li>
<li>Current Page, Checked Pages, All Pages 중 선택합니다.</li>
<li>Rotate Left, Rotate Right, Reset Rotation을 선택합니다.</li>
<li>Print Order가 자동 준비됩니다.</li>
<li>Single Page PDF를 눌러 회전된 결과를 저장합니다.</li>
</ol>
<hr>
<h3>8. Single Page PDF</h3>
<p>Single Page PDF는 포스터 분할 없이 전체 페이지나 선택 영역을 일반 PDF 페이지로 출력합니다.</p>
<ul>
<li>Fit Width</li>
<li>Fit Whole Area</li>
<li>Fill Page Crop</li>
<li>Fit Height</li>
</ul>
<hr>
<h3>9. Output Files</h3>
<ul>
<li><b>One PDF</b>: Print Order 항목을 하나의 PDF로 만듭니다.</li>
<li><b>Separate PDF per selected page</b>: 각 항목을 별도 PDF로 만듭니다.</li>
</ul>
<hr>
<h3>10. Auto Select / 텍스트 검색 / OCR</h3>
<ul>
<li><b>Auto Current</b>: 현재 페이지 내용을 자동 선택합니다.</li>
<li><b>Auto All</b>: 모든 페이지를 자동 선택합니다.</li>
<li><b>Auto Range</b>: 1-20 같은 범위만 자동 선택합니다.</li>
<li><b>Find Text</b>: 텍스트 정보가 있는 PDF에서만 동작합니다. 스캔/이미지 PDF는 OCR이 필요할 수 있습니다.</li>
</ul>
<hr>
<h3>11. 출력 파일과 프로젝트</h3>
<ul>
<li>생성된 PDF는 exports 폴더에 저장됩니다.</li>
<li>Open Exports Folder로 출력 폴더를 열 수 있습니다.</li>
<li>Save Project As로 Source PDFs, 선택 영역, Print Order, 설정을 저장할 수 있습니다.</li>
</ul>
""",

            "日本語": """
<h2>PDF Poster Studio - 使い方</h2>
<p>PDF Poster Studio は、PDF と画像ファイルから印刷用 PDF を作成するツールです。PDF結合、ページ抽出、ポスター分割、ページ回転、選択範囲出力に対応しています。</p>
<hr>
<h3>1. 基本の流れ</h3>
<ol><li>Open PDFs / Images でファイルを開きます。</li><li>Home またはツールバーから作業を選びます。</li><li>Output Area を Whole Page または Selected Area にします。</li><li>Build Print Order を実行します。</li><li>Poster PDF または Single Page PDF を作成します。</li></ol>
<hr>
<h3>2. Home タスク</h3>
<ul><li><b>Merge PDFs</b>: ページ全体を1つのPDFにまとめます。</li><li><b>Extract Pages</b>: 指定ページ範囲だけを抽出します。</li><li><b>Make Poster</b>: 地図、ポスター、画像、図面を複数枚に分割します。</li><li><b>Rotate Pages</b>: 現在/チェック/全ページを回転します。</li><li><b>Selected Area PDF</b>: 選択範囲だけを出力します。</li></ul>
<hr>
<h3>3. ポスター作成</h3>
<ol><li>Make Poster を選びます。</li><li>Open One File または Use Current Source PDFs を選びます。</li><li>Whole Page または Selected Area を選びます。</li><li>A4 または US Letter を選びます。</li><li>Poster / A-series / ANSI / Arch プリセットを選びます。</li><li>Tiling Preview を確認します。</li><li>Build Print Order 後、Poster PDF を押します。</li></ol>
<hr>
<h3>4. Whole Page / Selected Area</h3>
<ul><li><b>Whole Page</b>: ページ全体または画像全体を使います。</li><li><b>Selected Area</b>: 選択した範囲だけを使います。</li></ul><p>手動で範囲選択すると、Selected Area に自動変更されます。</p>
<hr>
<h3>5. PDF結合</h3>
<ol><li>Merge PDFs を選びます。</li><li>必要に応じてファイルを開きます。</li><li>Whole Page、One PDF、Single Page Mode に自動設定されます。</li><li>全ページが Print Order に追加されます。</li><li>Single Page PDF を押します。</li></ol>
<hr>
<h3>6. ページ抽出</h3>
<ol><li>Extract Pages を選びます。</li><li>all、1-10、1,3,5 などを入力します。</li><li>初期設定は Separate PDF per selected page です。</li><li>1つにまとめる場合は One PDF に変更します。</li><li>Single Page PDF を押します。</li></ol>
<hr>
<h3>7. ページ回転</h3>
<ol><li>Rotate Pages を選びます。</li><li>Current Page、Checked Pages、All Pages を選びます。</li><li>Rotate Left / Right または Reset を選びます。</li><li>Print Order が準備されます。</li><li>Single Page PDF で保存します。</li></ol>
<hr>
<h3>8. Single Page PDF</h3><p>ポスター分割せず、通常のPDFページとして出力します。</p><ul><li>Fit Width</li><li>Fit Whole Area</li><li>Fill Page Crop</li><li>Fit Height</li></ul>
<hr>
<h3>9. Output Files</h3><ul><li><b>One PDF</b>: 1つのPDFにまとめます。</li><li><b>Separate PDF per selected page</b>: 各項目を別PDFにします。</li></ul>
<hr>
<h3>10. Auto Select / 検索 / OCR</h3><ul><li>Auto Current</li><li>Auto All</li><li>Auto Range</li><li>Find Text はテキスト情報を含むPDFのみ検索できます。スキャンPDFはOCRが必要な場合があります。</li></ul>
<hr>
<h3>11. 出力ファイルとプロジェクト</h3><ul><li>PDFは exports フォルダに保存されます。</li><li>Open Exports Folder で開けます。</li><li>Save Project As で作業を保存できます。</li></ul>
""",

            "中文（简体）": """
<h2>PDF Poster Studio - 使用指南</h2>
<p>PDF Poster Studio 可以从 PDF 和图片文件创建可打印 PDF，支持合并、页面提取、海报分割、页面旋转和选区输出。</p>
<hr>
<h3>1. 基本流程</h3>
<ol><li>使用 Open PDFs / Images 打开文件。</li><li>从 Home 或工具栏选择任务。</li><li>选择 Output Area：Whole Page 或 Selected Area。</li><li>执行 Build Print Order。</li><li>创建 Poster PDF 或 Single Page PDF。</li></ol>
<hr>
<h3>2. Home 任务</h3>
<ul><li><b>Merge PDFs</b>：把完整页面合并为一个PDF。</li><li><b>Extract Pages</b>：只提取指定页面范围。</li><li><b>Make Poster</b>：把地图、海报、图片、图纸分割成多张纸。</li><li><b>Rotate Pages</b>：旋转当前/勾选/全部页面。</li><li><b>Selected Area PDF</b>：只输出选择区域。</li></ul>
<hr>
<h3>3. 制作海报</h3>
<ol><li>选择 Make Poster。</li><li>选择 Open One File 或 Use Current Source PDFs。</li><li>选择 Whole Page 或 Selected Area。</li><li>选择 A4 或 US Letter。</li><li>选择 Poster / A-series / ANSI / Arch 预设。</li><li>查看 Tiling Preview。</li><li>Build Print Order 后点击 Poster PDF。</li></ol>
<hr>
<h3>4. Whole Page / Selected Area</h3>
<ul><li><b>Whole Page</b>：使用整页或整张图片。</li><li><b>Selected Area</b>：只使用选择区域。</li></ul><p>手动选择区域时，会自动切换为 Selected Area。</p>
<hr>
<h3>5. 合并PDF</h3>
<ol><li>选择 Merge PDFs。</li><li>根据需要打开文件。</li><li>程序会自动设置 Whole Page、One PDF、Single Page Mode。</li><li>所有页面会加入 Print Order。</li><li>点击 Single Page PDF。</li></ol>
<hr>
<h3>6. 页面提取</h3>
<ol><li>选择 Extract Pages。</li><li>输入 all、1-10、1,3,5 等范围。</li><li>默认输出为 Separate PDF per selected page。</li><li>如需合并为一个文件，请改为 One PDF。</li><li>点击 Single Page PDF。</li></ol>
<hr>
<h3>7. 页面旋转</h3>
<ol><li>选择 Rotate Pages。</li><li>选择 Current Page、Checked Pages 或 All Pages。</li><li>选择 Rotate Left / Right 或 Reset。</li><li>程序会准备 Print Order。</li><li>点击 Single Page PDF 保存。</li></ol>
<hr>
<h3>8. Single Page PDF</h3><p>不进行海报分割，按普通PDF页面输出。</p><ul><li>Fit Width</li><li>Fit Whole Area</li><li>Fill Page Crop</li><li>Fit Height</li></ul>
<hr>
<h3>9. Output Files</h3><ul><li><b>One PDF</b>：合并为一个PDF。</li><li><b>Separate PDF per selected page</b>：每个项目生成单独PDF。</li></ul>
<hr>
<h3>10. Auto Select / 搜索 / OCR</h3><ul><li>Auto Current</li><li>Auto All</li><li>Auto Range</li><li>Find Text 只能搜索包含文本层的PDF。扫描PDF可能需要OCR。</li></ul>
<hr>
<h3>11. 输出文件和项目</h3><ul><li>生成的PDF保存在 exports 文件夹。</li><li>可用 Open Exports Folder 打开。</li><li>可用 Save Project As 保存工作。</li></ul>
"""
        }

        dialog = QDialog(self)
        dialog.setWindowTitle(t("user_guide"))
        dialog.setMinimumSize(820, 660)
        dialog.setWindowIcon(self.windowIcon())

        layout = QVBoxLayout(dialog)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        language_layout = QHBoxLayout()
        language_label = QLabel(t("language"))
        language_combo = QComboBox()
        language_combo.addItems(["English", "한국어", "日本語", "中文（简体）"])
        language_combo.setCurrentText("English")
        language_layout.addWidget(language_label)
        language_layout.addWidget(language_combo)
        language_layout.addStretch()

        guide_view = QTextEdit()
        guide_view.setReadOnly(True)
        guide_view.setHtml(guides["English"])
        guide_view.setStyleSheet("""
            QTextEdit {
                background-color: #FFFDF8;
                color: #2F4F5F;
                border: 1px solid #EADBC8;
                border-radius: 8px;
                padding: 10px;
                font-family: Segoe UI, Arial;
                font-size: 10.5pt;
            }
        """)

        def change_language() -> None:
            guide_view.setHtml(guides.get(language_combo.currentText(), guides["English"]))

        language_combo.currentIndexChanged.connect(change_language)

        close_button = QPushButton(t("close"))
        close_button.clicked.connect(dialog.accept)

        button_layout = QHBoxLayout()
        button_layout.addStretch()
        button_layout.addWidget(close_button)

        layout.addLayout(language_layout)
        layout.addWidget(guide_view)
        layout.addLayout(button_layout)

        dialog.exec()









    # RELEASE NOTES UPDATE POLICY:
    # Whenever user-facing features are changed, update this method and the welcome "What's new" text together.
    def show_release_notes(self) -> None:
        notes = """
<h2>PDF Poster Studio - Release Notes</h2>

<h3>Version 0.9.6</h3>
<ul>
  <li><b>Equal 11-section multilingual User Guide</b>: English, Korean, Japanese, and Simplified Chinese guides now share the same 11-section structure.</li>
</ul>
<hr>


<h3>Version 0.9.6</h3>
<ul>
  <li><b>Task Launcher welcome screen</b>: Startup popup now shows large workflow cards.</li>
  <li><b>Home task cards</b>: Merge PDFs, Extract Pages, Make Poster, Rotate Pages, and Selected Area PDF workflows.</li>
  <li><b>Make Poster source choice</b>: Choose Open One File or Use Current Source PDFs.</li>
  <li><b>Make Poster area choice</b>: Choose Whole Page or Selected Area.</li>
  <li><b>Selected Area PDF task choice</b>: Choose Auto Select Current Page or Select Manually.</li>
  <li><b>Merge PDFs automation</b>: Adds all source pages to Print Order using Whole Page and One PDF.</li>
  <li><b>Extract Pages page ranges</b>: Supports all, 1-10, 1,3,5, and mixed ranges.</li>
  <li><b>Rotate Pages workflow</b>: Rotate current, checked, or all pages and prepare Print Order.</li>
  <li><b>Output Area</b>: Whole Page or Selected Area.</li>
  <li><b>Auto Select Page Range</b>: Process only selected page ranges for large PDFs.</li>
  <li><b>Preview floating toolbar</b>: Collapsible view controls over the preview.</li>
  <li><b>Zoom and Reset View improvements</b>: Better zoom behavior and reset handling.</li>
  <li><b>Page-specific rotation</b>: Rotating one page no longer rotates every page.</li>
  <li><b>Export respects rotation</b>: Output PDF now follows the rotation shown in preview.</li>
  <li><b>Print Order thumbnail refresh</b>: Thumbnails update after rotation.</li>
  <li><b>Image import support</b>: PNG, JPG, JPEG, BMP, and WEBP files are supported.</li>
  <li><b>Multilingual User Guide</b>: English, 한국어, 日本語, 中文（简体）.</li>
</ul>

<hr>

<h3>Version 0.9.5 and earlier highlights</h3>
<ul>
  <li>Poster Print and Single Page workflows.</li>
  <li>One PDF and Separate PDF output modes.</li>
  <li>A4 and US Letter support.</li>
  <li>A-series, ANSI, Arch, and Hobby poster presets.</li>
  <li>Tiling Preview.</li>
  <li>Project save/load.</li>
  <li>Vector PDF quality preservation where possible.</li>
</ul>

<hr>

<h3>Known Notes</h3>
<ul>
  <li>This is still a beta version.</li>
  <li>Large PDFs may take time to process.</li>
  <li>Image files are converted internally to temporary PDF pages.</li>
  <li>Find Text works only with PDFs that already contain text. Scanned PDFs may require OCR in another tool.</li>
</ul>
"""

        dialog = QDialog(self)
        dialog.setWindowTitle(t("release_notes"))
        dialog.setMinimumSize(760, 620)
        dialog.setWindowIcon(self.windowIcon())

        layout = QVBoxLayout(dialog)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        notes_view = QTextEdit()
        notes_view.setReadOnly(True)
        notes_view.setHtml(notes)
        notes_view.setStyleSheet("""
            QTextEdit {
                background-color: #FFFDF8;
                color: #2F4F5F;
                border: 1px solid #EADBC8;
                border-radius: 8px;
                padding: 10px;
                font-family: Segoe UI, Arial;
                font-size: 10.5pt;
            }
        """)

        close_button = QPushButton(t("close"))
        close_button.clicked.connect(dialog.accept)

        button_layout = QHBoxLayout()
        button_layout.addStretch()
        button_layout.addWidget(close_button)

        layout.addWidget(notes_view)
        layout.addLayout(button_layout)

        dialog.exec()





    def show_about(self) -> None:
        QMessageBox.about(
            self,
            t("about"),
            f"PDF Poster Studio\nVersion: 0.9.6\nCreator: {CREATOR}"
        )

    def not_implemented(self) -> None:
        self._log("Not implemented menu selected.")
        QMessageBox.information(self, t("not_implemented"), "This function will be implemented later.")

    def resizeEvent(self, event) -> None:
        super().resizeEvent(event)

        if self.current_pixmap is not None and self.fit_to_page_enabled:
            self._save_current_selection()
            self._show_pixmap()


    def show_language_settings(self):
        languages = {
            t("korean"): "ko",
            t("english"): "en",
        }

        current = current_language()
        current_label = t("korean") if current == "ko" else t("english")

        selected, ok = QInputDialog.getItem(
            self,
            t("language_settings"),
            t("select_language"),
            list(languages.keys()),
            0 if current_label == t("korean") else 1,
            False,
        )

        if not ok:
            return

        set_language(languages[selected])

        QMessageBox.information(
            self,
            t("language_settings"),
            t("language_changed_restart"),
        )


    def closeEvent(self, event) -> None:
        if self.is_modified:
            result = QMessageBox.question(
                self,
                t("unsaved_changes"),
                "There are unsaved changes. Save before exit?",
                QMessageBox.StandardButton.Save |
                QMessageBox.StandardButton.Discard |
                QMessageBox.StandardButton.Cancel
            )

            if result == QMessageBox.StandardButton.Save:
                self.save_project()
                if self.is_modified:
                    event.ignore()
                    return
            elif result == QMessageBox.StandardButton.Cancel:
                event.ignore()
                return

        self.pdf_renderer.close()
        self._log("Application closing.")
        event.accept()

    def find_text_dialog(self):
        if not self.current_pdf_path:
            QMessageBox.information(self, t("find_text"), t("please_open_pdf_first"))
            return

        query, ok = QInputDialog.getText(
            self,
            t("find_text"),
            "검색할 텍스트를 입력하세요:",
            text=getattr(self, "last_find_query", ""),
        )

        if not ok or not query.strip():
            return

        query = query.strip()

        # 새 검색어면 결과 캐시 초기화
        if query != getattr(self, "last_find_query", ""):
            self.search_results = []
            self.search_result_index = -1

        self.last_find_query = query
        self.find_next_text()

    def find_next_text(self):
        if not self.current_pdf_path:
            QMessageBox.information(self, t("find_text"), t("please_open_pdf_first"))
            return

        query = getattr(self, "last_find_query", "").strip()
        if not query:
            self.find_text_dialog()
            return

        try:
            if not hasattr(self, "search_results") or not self.search_results:
                self._log(f"Find Text: searching '{query}' with text layer, then OCR fallback...")

                self.search_results = search_pdf_with_optional_ocr(
                    self.current_pdf_path,
                    query,
                    use_ocr_if_needed=True,
                    language="eng+kor",
                    dpi=200,
                )
                self.search_result_index = -1

            if not self.search_results:
                QMessageBox.information(
                    self,
                    t("find_text"),
                    f"'{query}' 검색 결과가 없습니다.",
                )
                return

            self.search_result_index = (self.search_result_index + 1) % len(self.search_results)
            result = self.search_results[self.search_result_index]

            self.current_page_index = result.page_index
            self.render_current_page()
            self._highlight_search_result(result)

            source_label = "OCR" if result.source == "ocr" else "PDF 텍스트"

            message = (
                f"{source_label}에서 찾았습니다.\n"
                f"결과: {self.search_result_index + 1} / {len(self.search_results)}\n"
                f"페이지: {result.page_index + 1}\n"
                f"텍스트: {result.text}"
            )

            box = QMessageBox(self)
            box.setWindowTitle(t("find_text"))
            box.setIcon(QMessageBox.Icon.Information)
            box.setText(message)

            next_button = box.addButton("다음 찾기", QMessageBox.ButtonRole.ActionRole)
            box.addButton(t("close"), QMessageBox.ButtonRole.RejectRole)
            box.setDefaultButton(next_button)

            box.exec()

            self._log(
                f"Find Text: '{query}' result {self.search_result_index + 1}/{len(self.search_results)} "
                f"on page {result.page_index + 1} by {result.source}"
            )

            if box.clickedButton() == next_button:
                self.find_next_text()

        except Exception as exc:
            QMessageBox.warning(
                self,
                t("find_text"),
                f"검색에 실패했습니다.\n\n{exc}",
            )
            self._log(f"Find Text error: {exc}")


    def render_current_page(self):
        for method_name in (
            "load_page",
            "show_page",
            "display_page",
            "update_page",
            "update_page_view",
            "refresh_page",
            "refresh_view",
            "refresh_preview",
            "update_preview",
            "render_page",
            "render_pdf_page",
        ):
            method = getattr(self, method_name, None)
            if callable(method):
                try:
                    return method()
                except TypeError:
                    try:
                        return method(self.current_page_index)
                    except TypeError:
                        continue

        if hasattr(self, "page_jump_spin"):
            try:
                self.page_jump_spin.setValue(self.current_page_index + 1)
            except Exception:
                pass

        self._log("render_current_page fallback: no render method found.")


    def _highlight_search_result(self, result):
        if not getattr(result, "rect", None):
            return

        if not hasattr(self, "preview_label"):
            return

        pixmap = self.preview_label.pixmap()
        if pixmap is None or pixmap.isNull():
            return

        try:
            import fitz

            doc = fitz.open(self.current_pdf_path)
            page = doc[result.page_index]
            page_rect = page.rect

            highlighted = pixmap.copy()
            painter = QPainter(highlighted)

            scale_x = highlighted.width() / max(1.0, page_rect.width)
            scale_y = highlighted.height() / max(1.0, page_rect.height)

            rect = result.rect
            x = int(rect.x0 * scale_x)
            y = int(rect.y0 * scale_y)
            w = max(8, int((rect.x1 - rect.x0) * scale_x))
            h = max(8, int((rect.y1 - rect.y0) * scale_y))

            painter.fillRect(x, y, w, h, QColor(255, 230, 0, 120))
            painter.setPen(QPen(QColor(255, 140, 0), 2))
            painter.drawRect(x, y, w, h)
            painter.end()

            self.preview_label.setPixmap(highlighted)
            doc.close()

        except Exception as exc:
            self._log(f"Search highlight failed: {exc}")


