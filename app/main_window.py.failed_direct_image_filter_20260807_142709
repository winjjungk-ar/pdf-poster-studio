    def on_poster_size_preset_changed(self) -> None:
        if not hasattr(self, "poster_size_preset_combo"):
            return

        preset_value = self.poster_size_preset_combo.currentData()

        if preset_value is None:
            self.update_poster_sheet_estimate()
            return

        # Backward compatibility: old preset data was just an integer scale.
        if isinstance(preset_value, dict):
            scale_value = int(preset_value.get("scale", 100))
            paper_size = preset_value.get("paper_size")
        else:
            scale_value = int(preset_value)
            paper_size = None

        # A-series / ANSI / Arch presets may define paper_size.
        # Hobby presets intentionally do not define paper_size and keep the current Output Paper Size.
        if paper_size and hasattr(self, "paper_size_combo"):
            self.paper_size_combo.blockSignals(True)
            self._apply_combo_data(self.paper_size_combo, paper_size)
            self.paper_size_combo.blockSignals(False)

        if hasattr(self, "poster_scale_spin"):
            self.poster_scale_spin.blockSignals(True)
            self.poster_scale_spin.setValue(scale_value)
            self.poster_scale_spin.blockSignals(False)

        self.update_poster_sheet_estimate()



    def on_poster_scale_changed(self) -> None:
        if hasattr(self, "poster_size_preset_combo"):
            current_preset = self.poster_size_preset_combo.currentData()

            preset_scale = None

            if isinstance(current_preset, dict):
                try:
                    preset_scale = int(current_preset.get("scale"))
                except Exception:
                    preset_scale = None
            elif current_preset is not None:
                try:
                    preset_scale = int(current_preset)
                except Exception:
                    preset_scale = None

            if preset_scale is not None and preset_scale != int(self.poster_scale_spin.value()):
                self.poster_size_preset_combo.blockSignals(True)
                self.poster_size_preset_combo.setCurrentIndex(0)
                self.poster_size_preset_combo.blockSignals(False)

        self.update_poster_sheet_estimate()



    def _get_fixed_a_series_tile_grid(self) -> tuple[int | None, int | None]:
        """Return fixed tile grid for known poster size presets.

        User expectation:
        - Poster Small / A3 / ANSI B / Arch B -> 2 sheets
        - Poster Medium / A2 / ANSI C / Arch C -> 4 sheets
        - Poster Large / A1 / ANSI D / Arch D -> 8 sheets
        - Poster Huge / A0 / ANSI E / Arch E -> 16 sheets

        Hobby presets respect the currently selected Output Paper Size.
        A-series presets set A4. ANSI/Arch presets set US Letter.
        """
        if not hasattr(self, "poster_size_preset_combo"):
            return None, None

        preset_text = self.poster_size_preset_combo.currentText()
        split_layout = self.split_layout_combo.currentData() if hasattr(self, "split_layout_combo") else "left_right"

        if not preset_text or "Manual" in preset_text or "Custom" in preset_text:
            return None, None

        # 2 sheets
        if (
            preset_text.startswith("Poster Small")
            or preset_text.startswith("A3 ")
            or preset_text.startswith("ANSI B")
            or preset_text.startswith("Arch B")
        ):
            return (1, 2) if split_layout == "top_bottom" else (2, 1)

        # 4 sheets
        if (
            preset_text.startswith("Poster Medium")
            or preset_text.startswith("A2 ")
            or preset_text.startswith("ANSI C")
            or preset_text.startswith("Arch C")
        ):
            return 2, 2

        # 8 sheets
        if (
            preset_text.startswith("Poster Large")
            or preset_text.startswith("A1 ")
            or preset_text.startswith("ANSI D")
            or preset_text.startswith("Arch D")
        ):
            return (2, 4) if split_layout == "top_bottom" else (4, 2)

        # 16 sheets
        if (
            preset_text.startswith("Poster Huge")
            or preset_text.startswith("A0 ")
            or preset_text.startswith("ANSI E")
            or preset_text.startswith("Arch E")
        ):
            return 4, 4

        return None, None






    def update_tiling_preview(self, cols: int | None = None, rows: int | None = None) -> None:
        if not hasattr(self, "tiling_preview_label"):
            return

        if not cols or not rows or cols <= 0 or rows <= 0:
            self.tiling_preview_label.setText("-")
            return

        max_cells = 40
        total = cols * rows

        # Keep the preview compact for very large posters.
        display_cols = min(cols, 8)
        display_rows = min(rows, 6)

        html = []
        html.append(
            "<div style='font-family: Segoe UI, Arial; color:#395B64;'>"
            f"<div style='font-weight:700; margin-bottom:6px;'>"
            f"{cols} x {rows} = {total} sheets"
            "</div>"
        )

        html.append(
            "<table cellspacing='4' cellpadding='0' "
            "style='border-collapse:separate;'>"
        )

        sheet_no = 1

        for row in range(display_rows):
            html.append("<tr>")

            for col in range(display_cols):
                actual_sheet_no = row * cols + col + 1

                if actual_sheet_no > max_cells:
                    cell_text = "..."
                else:
                    cell_text = str(actual_sheet_no)

                html.append(
                    "<td style='"
                    "min-width:34px;"
                    "height:28px;"
                    "text-align:center;"
                    "vertical-align:middle;"
                    "background-color:#EAF7F7;"
                    "border:1px solid #9EDDE2;"
                    "border-radius:6px;"
                    "font-weight:700;"
                    "color:#395B64;"
                    "'>"
                    f"{cell_text}"
                    "</td>"
                )

                sheet_no += 1

            if cols > display_cols:
                html.append(
                    "<td style='"
                    "min-width:28px;"
                    "height:28px;"
                    "text-align:center;"
                    "vertical-align:middle;"
                    "color:#7A8D96;"
                    "font-weight:700;"
                    "'>...</td>"
                )

            html.append("</tr>")

        if rows > display_rows:
            html.append(
                "<tr><td colspan='99' style='"
                "text-align:center;"
                "color:#7A8D96;"
                "font-weight:700;"
                "padding-top:2px;"
                "'>...</td></tr>"
            )

        html.append("</table>")

        if total > max_cells:
            html.append(
                f"<div style='font-size:11px; color:#7A8D96; margin-top:4px;'>"
                f"Large layout preview is shortened. Total sheets: {total}."
                "</div>"
            )

        html.append("</div>")

        self.tiling_preview_label.setText("".join(html))




    def update_poster_sheet_estimate(self) -> None:
        if not hasattr(self, "poster_sheet_estimate_label"):
            return

        try:
            if self.page_count <= 0:
                self.poster_sheet_estimate_label.setText("Estimated Sheets: -")
                self.update_tiling_preview()
                return

            paper = self.paper_size_combo.currentData() if hasattr(self, "paper_size_combo") else "a4"
            scale_percent = self.poster_scale_spin.value() if hasattr(self, "poster_scale_spin") else 100
            scale = max(scale_percent / 100.0, 0.1)

            fixed_cols, fixed_rows = self._get_fixed_a_series_tile_grid()

            if fixed_cols and fixed_rows:
                total = fixed_cols * fixed_rows

                preset_text = self.poster_size_preset_combo.currentText() if hasattr(self, "poster_size_preset_combo") else ""

                if preset_text.startswith("Poster "):
                    current_paper = self.paper_size_combo.currentText() if hasattr(self, "paper_size_combo") else "current paper"
                    if total == 2:
                        size_text = f"Approx Poster Size: Small Poster on {current_paper}"
                    elif total == 4:
                        size_text = f"Approx Poster Size: Medium Poster on {current_paper}"
                    elif total == 8:
                        size_text = f"Approx Poster Size: Large Poster on {current_paper}"
                    elif total == 16:
                        size_text = f"Approx Poster Size: Huge Poster on {current_paper}"
                    else:
                        size_text = f"Approx Poster Size: Poster preset on {current_paper}"
                elif "ANSI" in preset_text:
                    if total == 2:
                        size_text = "Approx Poster Size: ANSI B / Tabloid"
                    elif total == 4:
                        size_text = "Approx Poster Size: ANSI C"
                    elif total == 8:
                        size_text = "Approx Poster Size: ANSI D"
                    elif total == 16:
                        size_text = "Approx Poster Size: ANSI E"
                    else:
                        size_text = "Approx Poster Size: ANSI preset"
                elif "Arch" in preset_text:
                    if total == 2:
                        size_text = "Approx Poster Size: Arch B"
                    elif total == 4:
                        size_text = "Approx Poster Size: Arch C"
                    elif total == 8:
                        size_text = "Approx Poster Size: Arch D"
                    elif total == 16:
                        size_text = "Approx Poster Size: Arch E"
                    else:
                        size_text = "Approx Poster Size: Arch preset"
                else:
                    if total == 2:
                        size_text = "Approx Poster Size: A3"
                    elif total == 4:
                        size_text = "Approx Poster Size: A2"
                    elif total == 8:
                        size_text = "Approx Poster Size: A1"
                    elif total == 16:
                        size_text = "Approx Poster Size: A0"
                    else:
                        size_text = "Approx Poster Size: preset"

                self.poster_sheet_estimate_label.setText(
                    f"Estimated Sheets: {fixed_cols} x {fixed_rows} = {total}\n{size_text}"
                )
                self.update_tiling_preview(cols=fixed_cols, rows=fixed_rows)
                return

            rect = self.preview_label.get_selection_rect()

            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                rect = self.page_selections.get(self.current_page_index, QRect())

            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                self.poster_sheet_estimate_label.setText("Estimated Sheets: select an area first")
                self.update_tiling_preview()
                return

            selection = self._preview_rect_to_pdf_selection(rect)

            if paper == "letter":
                page_w = 8.5 * 72
                page_h = 11 * 72
                paper_name = "US Letter"
            else:
                page_w = 210 * 72 / 25.4
                page_h = 297 * 72 / 25.4
                paper_name = "A4"

            margin = 5 * 72 / 25.4
            printable_w = max(page_w - margin * 2, 1)
            printable_h = max(page_h - margin * 2, 1)

            poster_w_pt = selection.width * scale
            poster_h_pt = selection.height * scale

            import math
            cols = max(1, math.ceil(poster_w_pt / printable_w))
            rows = max(1, math.ceil(poster_h_pt / printable_h))
            total = cols * rows

            poster_w_mm = poster_w_pt * 25.4 / 72
            poster_h_mm = poster_h_pt * 25.4 / 72

            self.poster_sheet_estimate_label.setText(
                f"Estimated Sheets: {cols} x {rows} = {total} "
                f"({paper_name}, {scale_percent}%)\n"
                f"Approx Poster Size: {poster_w_mm:.0f} x {poster_h_mm:.0f} mm"
            )
            self.update_tiling_preview(cols=cols, rows=rows)

        except Exception as exc:
            self.poster_sheet_estimate_label.setText("Estimated Sheets: -")
            self.update_tiling_preview()
            self._log(f"Poster sheet estimate error: {exc}")


