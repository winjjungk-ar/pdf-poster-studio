    def zoom_in(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            return

        self._save_current_selection()
        self.fit_to_page_enabled = False
        self.preview_zoom_factor = min(
            self.preview_zoom_factor * self.preview_zoom_step,
            self.preview_zoom_max,
        )
        self._show_pixmap()
        self._log(f"Zoom In applied: {int(self.preview_zoom_factor * 100)}%.")

    def zoom_out(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            return

        self._save_current_selection()
        self.fit_to_page_enabled = False
        self.preview_zoom_factor = max(
            self.preview_zoom_factor / self.preview_zoom_step,
            self.preview_zoom_min,
        )
        self._show_pixmap()
        self._log(f"Zoom Out applied: {int(self.preview_zoom_factor * 100)}%.")

    def fit_page(self) -> None:
        self._push_undo_state()
        self._save_current_selection()
        self.fit_to_page_enabled = True
        self._show_pixmap()
        self._log("Fit Page applied.")

    def actual_size(self) -> None:
        self._push_undo_state()
        self._save_current_selection()
        self.fit_to_page_enabled = False
        self.preview_zoom_factor = 1.0
        self._show_pixmap()
        self._log("Actual Size applied.")

    def _make_display_basis_pixmap(self, source_pixmap: QPixmap) -> QPixmap:
        display_base = source_pixmap

        angle = self.rotation_degrees % 360
        if angle != 0:
            transform = QTransform()
            transform.rotate(angle)
            display_base = source_pixmap.transformed(
                transform,
                Qt.TransformationMode.SmoothTransformation,
            )

        if self.fit_to_page_enabled:
            viewport_size = self.preview_scroll.viewport().size()
            return display_base.scaled(
                viewport_size,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

        scaled_width = max(1, int(display_base.width() * self.preview_zoom_factor))
        scaled_height = max(1, int(display_base.height() * self.preview_zoom_factor))

        return display_base.scaled(
            scaled_width,
            scaled_height,
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
    def _get_auto_select_threshold(self) -> int:
        if hasattr(self, "auto_select_sensitivity_combo"):
            return int(self.auto_select_sensitivity_combo.currentData())
        return 245

    def _auto_select_rect_from_pixmap(self, pixmap: QPixmap, threshold: int, padding: int = 8) -> QRect:
        image = pixmap.toImage()
        width = image.width()
        height = image.height()

        if width <= 0 or height <= 0:
            return QRect()

        min_x = width
        min_y = height
        max_x = -1
        max_y = -1

        step = max(1, min(width, height) // 1000)

        for y in range(0, height, step):
            for x in range(0, width, step):
                color = image.pixelColor(x, y)

                if (
                    color.red() < threshold
                    or color.green() < threshold
                    or color.blue() < threshold
                ):
                    min_x = min(min_x, x)
                    min_y = min(min_y, y)
                    max_x = max(max_x, x)
                    max_y = max(max_y, y)

        if max_x < min_x or max_y < min_y:
            return QRect()

        min_x = max(0, min_x - padding)
        min_y = max(0, min_y - padding)
        max_x = min(width - 1, max_x + padding)
        max_y = min(height - 1, max_y + padding)

        return QRect(
            min_x,
            min_y,
            max_x - min_x + 1,
            max_y - min_y + 1,
        ).normalized()

    def auto_select_content(self) -> None:
        self._push_undo_state()
        if self.current_pixmap is None:
            QMessageBox.warning(self, "No PDF", "Please open a PDF first.")
            return

        threshold = self._get_auto_select_threshold()
        rect = self.preview_label.auto_select_content(threshold=threshold, padding=8)

        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            QMessageBox.information(
                self,
                "Auto Select",
                "No visible content was detected. Please select an area manually."
            )
            self._log("Auto Select Current Page: no content detected.")
            return

        self.page_selections[self.current_page_index] = QRect(rect)
        self.checked_pages.add(self.current_page_index)

        self._update_selection_info(rect)
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self._update_checked_pages_label()

        self.is_modified = True

        self._log(
            f"Auto Select Current Page {self.current_page_index + 1}: "
            f"x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}, "
            f"threshold={threshold}"
        )


    def _auto_select_all_pages_for_current_pdf_no_prompt(
        self,
        progress_dialog=None,
        progress_offset: int = 0,
        progress_label_prefix: str = "",
    ) -> int:
        if not self.current_pdf_path or self.page_count <= 0:
            return 0

        threshold = 245
        if hasattr(self, "auto_select_sensitivity_combo"):
            threshold = int(self.auto_select_sensitivity_combo.currentData())

        selected_count = 0
        original_page_index = self.current_page_index

        for page_index in range(self.page_count):
            if progress_dialog is not None:
                progress_dialog.setValue(progress_offset + page_index)
                progress_dialog.setLabelText(
                    f"{progress_label_prefix}Page {page_index + 1} / {self.page_count}"
                )
                QApplication.processEvents()

                if progress_dialog.wasCanceled():
                    break

            try:
                # Use the normal render path so this behaves like Auto Select Current Page.
                self.current_page_index = page_index
                self._render_current_page()
                QApplication.processEvents()

                rect = self.preview_label.auto_select_content(threshold=threshold, padding=8)

                if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    self.page_selections.pop(page_index, None)
                    self.checked_pages.discard(page_index)
                    continue

                self.page_selections[page_index] = QRect(rect)
                self.checked_pages.add(page_index)
                selected_count += 1

            except Exception as exc:
                self._log(f"Auto Select failed on page {page_index + 1}: {exc}")

        self.current_page_index = max(0, min(original_page_index, self.page_count - 1))
        self._render_current_page()
        self._refresh_page_list_all_text()
        self._refresh_current_page_check_state()
        self._update_checked_pages_label()

        return selected_count


    def auto_select_all_workspace_pages(self) -> None:
        if not hasattr(self, "workspace_items") or not self.workspace_items:
            QMessageBox.information(self, "Auto Select All Pages", "Workspace is empty.")
            return

        result = QMessageBox.question(
            self,
            "Auto Select All Workspace Pages",
            "Automatically detect content area for all pages in all source PDFs?\n\n"
            "Existing selections may be replaced.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        original_workspace_index = self.current_workspace_index
        total_pages = 0

        for item in self.workspace_items:
            try:
                total_pages += int(item.get("page_count", 0))
            except Exception:
                pass

        if total_pages <= 0:
            QMessageBox.warning(self, "Auto Select All Pages", "No pages found in workspace.")
            return

        progress = QProgressDialog(
            "Preparing auto selection...",
            "Cancel",
            0,
            total_pages,
            self,
        )
        progress.setWindowTitle("Auto Select All Pages")
        progress.setWindowModality(Qt.WindowModality.ApplicationModal)
        progress.setMinimumDuration(0)
        progress.setValue(0)

        total_selected = 0
        processed_pages = 0
        canceled = False

        try:
            for workspace_index, item in enumerate(self.workspace_items):
                if progress.wasCanceled():
                    canceled = True
                    break

                pdf_name = Path(item.get("pdf_path", "")).name

                try:
                    self._load_workspace_index(workspace_index)
                    QApplication.processEvents()

                    selected_count = self._auto_select_all_pages_for_current_pdf_no_prompt(
                        progress_dialog=progress,
                        progress_offset=processed_pages,
                        progress_label_prefix=f"{pdf_name} - ",
                    )

                    total_selected += selected_count
                    processed_pages += self.page_count

                    self._save_current_workspace_state()

                    self._log(
                        f"Workspace auto selected: {pdf_name}, "
                        f"selected={selected_count}/{self.page_count}"
                    )

                except Exception as exc:
                    processed_pages += int(item.get("page_count", 0) or 0)
                    self._log(f"Workspace auto select failed: {item.get('pdf_path', '')}: {exc}")

            progress.setValue(total_pages)
            QApplication.processEvents()

        finally:
            progress.close()

        if original_workspace_index is not None and 0 <= original_workspace_index < len(self.workspace_items):
            self._load_workspace_index(original_workspace_index)
        elif self.workspace_items:
            self._load_workspace_index(0)

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        self.is_modified = True

        if canceled:
            QMessageBox.information(
                self,
                "Auto Select All Workspace Pages",
                f"Auto selection was canceled.\n\nSelected pages before cancel: {total_selected}"
            )
        else:
            QMessageBox.information(
                self,
                "Auto Select All Workspace Pages",
                f"Auto selection completed.\n\nSelected pages: {total_selected}/{total_pages}"
            )


    def auto_select_all_pages(self) -> None:
        if hasattr(self, "workspace_items") and len(self.workspace_items) > 1:
            self.auto_select_all_workspace_pages()
            return

        self._push_undo_state()
        if not self.current_pdf_path or self.page_count <= 0:
            QMessageBox.warning(self, "No PDF", "Please open a PDF first.")
            return

        result = QMessageBox.question(
            self,
            "Auto Select All Pages",
            "Automatically detect content area for all pages?\n\nExisting selections may be replaced.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        threshold = self._get_auto_select_threshold()
        selected_count = 0
        failed_pages = []

        original_page_index = self.current_page_index

        try:
            for page_index in range(self.page_count):
                pixmap = self.pdf_renderer.render_page(page_index, zoom=self.render_zoom)
                display_pixmap = self._make_display_basis_pixmap(pixmap)

                rect = self._auto_select_rect_from_pixmap(
                    pixmap=display_pixmap,
                    threshold=threshold,
                    padding=8,
                )

                if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                    self.page_selections.pop(page_index, None)
                    self.checked_pages.discard(page_index)
                    failed_pages.append(page_index + 1)
                    continue

                self.page_selections[page_index] = QRect(rect)
                self.checked_pages.add(page_index)
                selected_count += 1

            self.current_page_index = original_page_index
            self._render_current_page()
            self._refresh_page_list_all_text()
            self._refresh_current_page_check_state()
            self._update_checked_pages_label()

            self.is_modified = True

            message = f"Auto selection completed.\n\nSelected pages: {selected_count}/{self.page_count}"

            if failed_pages:
                message += "\n\nNo content detected on pages:\n"
                message += ", ".join(str(page) for page in failed_pages[:30])

            QMessageBox.information(self, "Auto Select All Pages", message)

            self._log(
                f"Auto Select All Pages completed: selected={selected_count}, "
                f"failed={len(failed_pages)}, threshold={threshold}, basis=preview_display"
            )

        except Exception as exc:
            QMessageBox.critical(
                self,
                "Auto Select Error",
                f"Failed to auto select all pages.\n\n{exc}"
            )
            self._log(f"Auto Select All Pages error: {exc}")

    def clear_all_selections(self) -> None:
        if not self.current_pdf_path and not getattr(self, "workspace_items", []):
            return

        result = QMessageBox.question(
            self,
            "Clear All Selections",
            "Clear all selected areas and checked pages?\n\n"
            "This affects the current workspace.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if result != QMessageBox.StandardButton.Yes:
            return

        if hasattr(self, "workspace_items") and self.workspace_items:
            if self.current_workspace_index is not None:
                self._save_current_workspace_state()

            for item in self.workspace_items:
                item["page_selections"] = {}
                item["checked_pages"] = set()
                item["current_page_index"] = int(item.get("current_page_index", 0))

            self.page_selections.clear()
            self.checked_pages.clear()

            if self.current_workspace_index is not None:
                self._load_workspace_index(self.current_workspace_index)
            elif self.workspace_items:
                self._load_workspace_index(0)

            self._refresh_workspace_list_text()

        else:
            self.page_selections.clear()
            self.checked_pages.clear()
            self.preview_label.clear_selection()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()
            self._update_checked_pages_label()

        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        self.selection_info_label.setText("Selection: None")
        self.is_modified = True
        self._log("All selections cleared.")


    def clear_selection(self) -> None:
        self._push_undo_state()
        self.preview_label.clear_selection()
        if self.page_count > 0:
            self.page_selections.pop(self.current_page_index, None)
            self.checked_pages.discard(self.current_page_index)
        self.selection_info_label.setText("Selection: None")
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self.is_modified = True
        self._log("Selection cleared.")

    def apply_selection_to_all_pages(self) -> None:
        self._push_undo_state()
        if self.page_count <= 0:
            QMessageBox.warning(self, "No PDF", "Please open a PDF first.")
            return

        rect = self.preview_label.get_selection_rect()

        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            QMessageBox.warning(self, "No Selection", "Please select an area first.")
            return

        for page_index in range(self.page_count):
            self.page_selections[page_index] = QRect(rect)
            self.checked_pages.add(page_index)

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_all_text()
        self._log(
            f"Selection applied to all pages: x={rect.x()}, y={rect.y()}, "
            f"w={rect.width()}, h={rect.height()}, pages={self.page_count}"
        )
        QMessageBox.information(
            self,
            "Applied",
            f"Selection was applied to all {self.page_count} pages."
        )

