    def check_menu_actions(self) -> None:
        self._log("Menu action check started.")

        checks = [
            ("File > New Project", callable(self.new_project)),
            ("File > Open Project", callable(self.open_project)),
            ("File > Save Project", callable(self.save_project)),
            ("File > Save Project As", callable(self.save_project_as)),
            ("File > Open PDFs", callable(self.open_pdfs)),
                        ("File > Export PDF", callable(self.export_print_pdf)),
            ("File > Open Last Exported PDF", callable(self.open_last_exported_pdf)),
            ("File > Print", callable(self.print_pdf)),
            ("File > Direct Print Last Exported PDF", callable(self.direct_print_last_exported_pdf)),
            ("File > Qt Print Dialog", callable(self.print_last_exported_pdf_with_dialog)),
            ("Edit > Clear Selection", callable(self.clear_selection)),
            ("Edit > Apply Selection to All Pages", callable(self.apply_selection_to_all_pages)),
            ("View > Previous Page", callable(self.previous_page)),
            ("View > Next Page", callable(self.next_page)),
            ("View > Zoom In", callable(self.zoom_in)),
            ("View > Zoom Out", callable(self.zoom_out)),
            ("View > Fit Page", callable(self.fit_page)),
            ("View > Actual Size", callable(self.actual_size)),
            ("View > Rotate Left", callable(self.rotate_left)),
            ("View > Rotate Right", callable(self.rotate_right)),
            ("View > Reset Rotation", callable(self.reset_rotation)),
            ("View > Auto Select Current Page", callable(self.auto_select_content)),
            ("View > Auto Select All Pages", callable(self.auto_select_all_pages)),
        ]

        failed = []

        for name, ok in checks:
            if ok:
                self._log(f"OK: {name}")
            else:
                failed.append(name)
                self._log(f"FAILED: {name}")

        self._log(f"Menu action check completed. OK={len(checks) - len(failed)}, Failed={len(failed)}")

        if failed:
            QMessageBox.warning(
                self,
                "Menu Check",
                "Some menu actions are not connected.\n\n" + "\n".join(failed)
            )
        else:
            QMessageBox.information(
                self,
                "Menu Check",
                "All checked menu actions are connected."
            )


