    def _update_checked_pages_label(self) -> None:
        self.checked_pages_label.setText(f"Checked pages: {len(self.checked_pages)}")

    def _refresh_current_page_check_state(self) -> None:
        if not hasattr(self, "page_complete_check"):
            return

        self.page_complete_check.blockSignals(True)
        self.page_complete_check.setChecked(self.current_page_index in self.checked_pages)
        self.page_complete_check.blockSignals(False)
        self._update_checked_pages_label()

    def on_page_complete_changed(self, state: int) -> None:
        if self.page_count <= 0:
            return

        if self.page_complete_check.isChecked():
            rect = self.preview_label.get_selection_rect()
            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                self.page_complete_check.blockSignals(True)
                self.page_complete_check.setChecked(False)
                self.page_complete_check.blockSignals(False)
                QMessageBox.warning(
                    self,
                    "No Selection",
                    "Please select an area before checking this page."
                )
                return

            self._save_current_selection()
            self.checked_pages.add(self.current_page_index)
            self._log(f"Page checked for export: {self.current_page_index + 1}")
        else:
            self.checked_pages.discard(self.current_page_index)
            self._log(f"Page unchecked for export: {self.current_page_index + 1}")

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(self.current_page_index)
        self._update_checked_pages_label()

    def on_page_jump_changed(self, value: int) -> None:
        if self.page_count <= 0:
            return

        target_index = value - 1
        if target_index == self.current_page_index:
            return

        if target_index < 0 or target_index >= self.page_count:
            return

        self._save_current_selection()
        self.current_page_index = target_index
        self._render_current_page()

    def _sync_page_jump_spin(self) -> None:
        if not hasattr(self, "page_jump_spin"):
            return

        self.page_jump_spin.blockSignals(True)
        self.page_jump_spin.setMaximum(max(1, self.page_count))
        self.page_jump_spin.setValue(max(1, self.current_page_index + 1))
        self.page_jump_spin.blockSignals(False)

    def mark_current_page_checked_if_has_selection(self) -> None:
        rect = self.preview_label.get_selection_rect()
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            return

        self.checked_pages.add(self.current_page_index)
        self._refresh_current_page_check_state()
    def _selection_exists_for_page(self, page_index: int) -> bool:
        rect = self.page_selections.get(page_index)
        return rect is not None and not rect.isNull() and rect.width() > 0 and rect.height() > 0

    def _page_list_text(self, page_index: int) -> str:
        page_no = page_index + 1

        if self._selection_exists_for_page(page_index):
            status = "Selected"
        else:
            status = "No selection"

        if page_index == self.current_page_index:
            return f"▶ Page {page_no} - {status}"

        return f"Page {page_no} - {status}"

    def _rebuild_page_list(self) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        self._updating_page_list = True
        self.page_list_widget.clear()

        for page_index in range(self.page_count):
            item = QListWidgetItem(self._page_list_text(page_index))
            item.setData(Qt.ItemDataRole.UserRole, page_index)
            item.setFlags(
                item.flags()
                | Qt.ItemFlag.ItemIsUserCheckable
                | Qt.ItemFlag.ItemIsEnabled
                | Qt.ItemFlag.ItemIsSelectable
            )

            if page_index in self.checked_pages:
                item.setCheckState(Qt.CheckState.Checked)
            else:
                item.setCheckState(Qt.CheckState.Unchecked)

            self.page_list_widget.addItem(item)

        self._updating_page_list = False
        self._update_checked_pages_label()

    def _refresh_page_list_item(self, page_index: int) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        if page_index < 0 or page_index >= self.page_list_widget.count():
            return

        self._updating_page_list = True

        item = self.page_list_widget.item(page_index)
        item.setText(self._page_list_text(page_index))

        if page_index in self.checked_pages:
            item.setCheckState(Qt.CheckState.Checked)
        else:
            item.setCheckState(Qt.CheckState.Unchecked)

        self._updating_page_list = False

    def _refresh_page_list_all_text(self) -> None:
        if not hasattr(self, "page_list_widget"):
            return

        self._updating_page_list = True

        for index in range(self.page_list_widget.count()):
            item = self.page_list_widget.item(index)
            page_index = item.data(Qt.ItemDataRole.UserRole)
            item.setText(self._page_list_text(page_index))

            if page_index in self.checked_pages:
                item.setCheckState(Qt.CheckState.Checked)
            else:
                item.setCheckState(Qt.CheckState.Unchecked)

        self._updating_page_list = False
        self._update_checked_pages_label()

    def on_page_list_item_clicked(self, item: QListWidgetItem) -> None:
        page_index = item.data(Qt.ItemDataRole.UserRole)

        if page_index is None:
            return

        if page_index == self.current_page_index:
            return

        if page_index < 0 or page_index >= self.page_count:
            return

        self._save_current_selection()
        self.current_page_index = page_index
        self._render_current_page()

    def on_page_list_item_changed(self, item: QListWidgetItem) -> None:
        if self._updating_page_list:
            return

        page_index = item.data(Qt.ItemDataRole.UserRole)

        if page_index is None:
            return

        if item.checkState() == Qt.CheckState.Checked:
            if not self._selection_exists_for_page(page_index):
                self._updating_page_list = True
                item.setCheckState(Qt.CheckState.Unchecked)
                self._updating_page_list = False

                QMessageBox.warning(
                    self,
                    "No Selection",
                    f"Page {page_index + 1} has no selection area."
                )
                return

            self.checked_pages.add(page_index)
            self._log(f"Page checked from list: {page_index + 1}")
        else:
            self.checked_pages.discard(page_index)
            self._log(f"Page unchecked from list: {page_index + 1}")

        self.is_modified = True
        self._refresh_current_page_check_state()
        self._refresh_page_list_item(page_index)
        self._update_checked_pages_label()
    def _save_current_selection(self) -> None:
        if self.page_count <= 0:
            return

        rect = self.preview_label.get_selection_rect()
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            self.page_selections.pop(self.current_page_index, None)
            return

        self.page_selections[self.current_page_index] = QRect(rect)

    def _restore_current_selection(self) -> None:
        rect = self.page_selections.get(self.current_page_index, QRect())
        self.preview_label.set_selection_rect(rect)
        self._update_selection_info(rect)

    def _update_selection_info(self, rect: QRect) -> None:
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            self.selection_info_label.setText("Selection: None")
            return

        self.selection_info_label.setText(
            f"Selection: x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}"
        )

    def _get_rotated_pixmap(self) -> QPixmap:
        if self.current_pixmap is None:
            raise RuntimeError("No pixmap is available.")

        angle = self.rotation_degrees % 360

        if angle == 0:
            return self.current_pixmap

        transform = QTransform()
        transform.rotate(angle)
        return self.current_pixmap.transformed(
            transform,
            Qt.TransformationMode.SmoothTransformation,
        )

    def _show_pixmap(self) -> None:
        if self.current_pixmap is None:
            return

        display_base = self._get_rotated_pixmap()
        self.current_display_base_width = display_base.width()
        self.current_display_base_height = display_base.height()

        if self.fit_to_page_enabled:
            viewport_size = self.preview_scroll.viewport().size()
            scaled = display_base.scaled(
                viewport_size,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            self.current_display_scale_x = scaled.width() / display_base.width()
            self.current_display_scale_y = scaled.height() / display_base.height()

            self.preview_label.set_preview_pixmap(scaled)
            self.render_info_label.setText(
                f"Preview: Rendered, fitted {scaled.width()} x {scaled.height()}"
            )
            self.zoom_info_label.setText("Zoom: Fit Page")
        else:
            scaled_width = max(1, int(display_base.width() * self.preview_zoom_factor))
            scaled_height = max(1, int(display_base.height() * self.preview_zoom_factor))

            scaled = display_base.scaled(
                scaled_width,
                scaled_height,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            self.current_display_scale_x = scaled.width() / display_base.width()
            self.current_display_scale_y = scaled.height() / display_base.height()

            self.preview_label.set_preview_pixmap(scaled)
            self.render_info_label.setText(
                f"Preview: Rendered, zoomed {scaled.width()} x {scaled.height()}"
            )
            self.zoom_info_label.setText(
                f"Zoom: {int(self.preview_zoom_factor * 100)}%"
            )

        self.rotation_info_label.setText(f"Rotation: {self.rotation_degrees % 360}°")
        self._restore_current_selection()

    def _render_current_page(self) -> None:
        if self.page_count <= 0:
            self._log("Render skipped: page count is zero.")
            return

        try:
            self._log(f"Rendering page {self.current_page_index + 1}/{self.page_count}...")
            self.current_pixmap = self.pdf_renderer.render_page(
                self.current_page_index,
                zoom=self.render_zoom,
            )
            self._show_pixmap()

            self.page_label.setText(
                f"Page: {self.current_page_index + 1} / {self.page_count}"
            )

            self._update_page_buttons()
            self._sync_page_jump_spin()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()

            self._log(
                f"Rendered page {self.current_page_index + 1}/{self.page_count}, "
                f"pixmap={self.current_pixmap.width()}x{self.current_pixmap.height()}."
            )

        except Exception as exc:
            QMessageBox.critical(
                self,
                "Render Error",
                f"Failed to render PDF page.\n\n{exc}"
            )
            self._log(f"Render error: {exc}")

    def _update_page_buttons(self) -> None:
        has_pdf = self.page_count > 0
        self.prev_button.setEnabled(has_pdf and self.current_page_index > 0)
        self.next_button.setEnabled(has_pdf and self.current_page_index < self.page_count - 1)

    def _map_rotated_point_to_original_render(self, x: float, y: float) -> tuple[float, float]:
        if self.current_pixmap is None:
            raise RuntimeError("No pixmap is available.")

        original_w = float(self.current_pixmap.width())
        original_h = float(self.current_pixmap.height())
        angle = self.rotation_degrees % 360

        if angle == 0:
            return x, y

        if angle == 90:
            return y, original_h - x

        if angle == 180:
            return original_w - x, original_h - y

        if angle == 270:
            return original_w - y, x

        return x, y

    def _preview_rect_to_pdf_selection(self, rect: QRect) -> SelectionRect:
        if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
            raise RuntimeError("Invalid selection rectangle.")

        x0 = rect.x() / self.current_display_scale_x
        y0 = rect.y() / self.current_display_scale_y
        x1 = (rect.x() + rect.width()) / self.current_display_scale_x
        y1 = (rect.y() + rect.height()) / self.current_display_scale_y

        points = [
            self._map_rotated_point_to_original_render(x0, y0),
            self._map_rotated_point_to_original_render(x1, y0),
            self._map_rotated_point_to_original_render(x0, y1),
            self._map_rotated_point_to_original_render(x1, y1),
        ]

        xs = [point[0] for point in points]
        ys = [point[1] for point in points]

        render_x0 = min(xs)
        render_y0 = min(ys)
        render_x1 = max(xs)
        render_y1 = max(ys)

        pdf_x = render_x0 / self.render_zoom
        pdf_y = render_y0 / self.render_zoom
        pdf_w = (render_x1 - render_x0) / self.render_zoom
        pdf_h = (render_y1 - render_y0) / self.render_zoom

        return SelectionRect(
            x=pdf_x,
            y=pdf_y,
            width=pdf_w,
            height=pdf_h,
        )

    def _build_export_selections(self) -> dict[int, SelectionRect]:
        self._save_current_selection()

        if not self.checked_pages:
            raise RuntimeError("No checked pages exist. Please select an area and check pages for export.")

        result = {}

        for page_index in sorted(self.checked_pages):
            rect = self.page_selections.get(page_index)
            if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                continue

            result[page_index] = self._preview_rect_to_pdf_selection(rect)

        if not result:
            raise RuntimeError("Checked pages do not have valid selections.")

        return result

    def on_selection_changed(self, rect: QRect) -> None:
        self._push_undo_state()
        self._update_selection_info(rect)

        if self.page_count > 0:
            if rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                self.page_selections.pop(self.current_page_index, None)
                self.checked_pages.discard(self.current_page_index)
                self._refresh_current_page_check_state()
                self._refresh_page_list_item(self.current_page_index)
                self._log(f"Selection cleared for page {self.current_page_index + 1}.")
            else:
                self.page_selections[self.current_page_index] = QRect(rect)
                self.checked_pages.add(self.current_page_index)
                self._refresh_current_page_check_state()
                self._refresh_page_list_item(self.current_page_index)
                self._log(
                    f"Selection changed on page {self.current_page_index + 1}: "
                    f"x={rect.x()}, y={rect.y()}, w={rect.width()}, h={rect.height()}"
                )

            self.is_modified = True
            self.update_poster_sheet_estimate()

