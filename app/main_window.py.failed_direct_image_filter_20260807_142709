    def _make_history_snapshot(self) -> dict:
        selections = {}
        for page_index, rect in self.page_selections.items():
            selections[str(page_index)] = {
                "x": rect.x(),
                "y": rect.y(),
                "width": rect.width(),
                "height": rect.height(),
            }

        return {
            "current_page_index": self.current_page_index,
            "checked_pages": sorted(list(self.checked_pages)),
            "selections": selections,
            "rotation_degrees": self.rotation_degrees,
            "preview_zoom_factor": self.preview_zoom_factor,
            "fit_to_page_enabled": self.fit_to_page_enabled,
            "export_type": self.export_type_combo.currentData() if hasattr(self, "export_type_combo") else None,
            "selection_fit_mode": self.selection_fit_mode_combo.currentData() if hasattr(self, "selection_fit_mode_combo") else None,
            "page_orientation": self.page_orientation_combo.currentData() if hasattr(self, "page_orientation_combo") else None,
            "export_quality": self.export_quality_combo.currentData() if hasattr(self, "export_quality_combo") else None,
            "batch_output": self.batch_output_combo.currentData() if hasattr(self, "batch_output_combo") else None,
            "output_mode": self.output_mode_combo.currentData() if hasattr(self, "output_mode_combo") else None,
            "split_layout": self.split_layout_combo.currentData() if hasattr(self, "split_layout_combo") else None,
            "add_numbers": self.numbering_check.isChecked() if hasattr(self, "numbering_check") else True,
            "add_cut_guides": self.cut_guides_check.isChecked() if hasattr(self, "cut_guides_check") else True,
        }

    def _push_undo_state(self) -> None:
        if self._restoring_history:
            return

        if not hasattr(self, "undo_stack"):
            return

        snapshot = self._make_history_snapshot()

        if self.undo_stack and self.undo_stack[-1] == snapshot:
            return

        self.undo_stack.append(snapshot)

        if len(self.undo_stack) > 50:
            self.undo_stack.pop(0)

        self.redo_stack.clear()
        self._update_undo_redo_actions()

    def _restore_history_snapshot(self, snapshot: dict) -> None:
        self._restoring_history = True

        try:
            self.page_selections.clear()
            for page_key, rect_data in snapshot.get("selections", {}).items():
                try:
                    page_index = int(page_key)
                    self.page_selections[page_index] = QRect(
                        int(rect_data.get("x", 0)),
                        int(rect_data.get("y", 0)),
                        int(rect_data.get("width", 0)),
                        int(rect_data.get("height", 0)),
                    )
                except Exception:
                    continue

            self.checked_pages = set()
            for page_index in snapshot.get("checked_pages", []):
                try:
                    self.checked_pages.add(int(page_index))
                except Exception:
                    continue

            self.rotation_degrees = int(snapshot.get("rotation_degrees", 0)) % 360
            self.preview_zoom_factor = float(snapshot.get("preview_zoom_factor", 1.0))
            self.fit_to_page_enabled = bool(snapshot.get("fit_to_page_enabled", True))

            self._apply_combo_data(self.export_type_combo, snapshot.get("export_type"))
            self._apply_combo_data(self.selection_fit_mode_combo, snapshot.get("selection_fit_mode"))
            self._apply_combo_data(self.page_orientation_combo, snapshot.get("page_orientation"))
            self._apply_combo_data(self.export_quality_combo, snapshot.get("export_quality"))
            self._apply_combo_data(self.batch_output_combo, snapshot.get("batch_output"))
            self._apply_combo_data(self.output_mode_combo, snapshot.get("output_mode"))
            self._apply_combo_data(self.split_layout_combo, snapshot.get("split_layout"))

            self.numbering_check.setChecked(bool(snapshot.get("add_numbers", True)))
            self.cut_guides_check.setChecked(bool(snapshot.get("add_cut_guides", True)))

            if self.page_count > 0:
                target_page = int(snapshot.get("current_page_index", 0))
                self.current_page_index = max(0, min(target_page, self.page_count - 1))
                self._render_current_page()
                self._refresh_page_list_all_text()
                self._refresh_current_page_check_state()
                self._update_checked_pages_label()

            self.update_export_option_states()
            self.is_modified = True

        finally:
            self._restoring_history = False

    def _update_undo_redo_actions(self) -> None:
        if hasattr(self, "undo_action"):
            self.undo_action.setEnabled(len(self.undo_stack) > 0)

        if hasattr(self, "redo_action"):
            self.redo_action.setEnabled(len(self.redo_stack) > 0)

    def undo(self) -> None:
        if not self.undo_stack:
            return

        current = self._make_history_snapshot()
        snapshot = self.undo_stack.pop()
        self.redo_stack.append(current)

        self._restore_history_snapshot(snapshot)
        self._update_undo_redo_actions()
        self._log("Undo applied.")

    def redo(self) -> None:
        if not self.redo_stack:
            return

        current = self._make_history_snapshot()
        snapshot = self.redo_stack.pop()
        self.undo_stack.append(current)

        self._restore_history_snapshot(snapshot)
        self._update_undo_redo_actions()
        self._log("Redo applied.")
    def _refresh_recent_projects_menu(self) -> None:
        self.recent_projects_menu.clear()
        paths = self.recent_projects.load()

        if not paths:
            action = self.recent_projects_menu.addAction("No Recent Projects")
            action.setEnabled(False)
            return

        for path in paths:
            action = self.recent_projects_menu.addAction(path)
            action.triggered.connect(lambda checked=False, p=path: self.load_project_from_path(p))

    def _add_recent_project(self, path: str) -> None:
