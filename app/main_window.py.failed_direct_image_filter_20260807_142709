    def _build_export_confirmation_lines(self, limit: int = 30) -> list[str]:
        lines: list[str] = []

        if self._workspace_has_multiple_pdfs():
            if self.current_workspace_index is not None:
                self._save_current_workspace_state()

            entries = self._get_export_order_entries()

            if not entries:
                for workspace_index, item in enumerate(self.workspace_items):
                    checked_pages = sorted(list(item.get("checked_pages", set())))
                    for page_index in checked_pages:
                        entries.append((workspace_index, page_index))

            for order_no, (workspace_index, page_index) in enumerate(entries, 1):
                if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                    continue

                pdf_name = Path(self.workspace_items[workspace_index].get("pdf_path", "")).name
                lines.append(f"{order_no}. {pdf_name} - Page {page_index + 1}")

                if len(lines) >= limit:
                    remaining = len(entries) - limit
                    if remaining > 0:
                        lines.append(f"... and {remaining} more page(s)")
                    break

            return lines

        try:
            export_selections = self._build_export_selections()
        except Exception:
            return []

        for order_no, page_index in enumerate(sorted(export_selections.keys()), 1):
            pdf_name = Path(self.current_pdf_path or "").name
            lines.append(f"{order_no}. {pdf_name} - Page {page_index + 1}")

            if len(lines) >= limit:
                remaining = len(export_selections) - limit
                if remaining > 0:
                    lines.append(f"... and {remaining} more page(s)")
                break

        return lines

    def _confirm_export_order(self, output_path: str) -> bool:
        lines = self._build_export_confirmation_lines()

        if not lines:
            QMessageBox.warning(
                self,
                "Export",
                "No selected pages were found for export."
            )
            return False

        preview = "\n".join(lines)
        message = (
            f"Create the print PDF using this page order?\n\n"
            f"{preview}\n\n"
            f"Output:\n{output_path}"
        )

        result = QMessageBox.question(
            self,
            "Confirm Export",
            message,
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        return result == QMessageBox.StandardButton.Yes



    def _prompt_export_type(self) -> bool:
        dialog = QMessageBox(self)
        dialog.setWindowTitle("Choose Export Type")
        dialog.setIcon(QMessageBox.Icon.Question)
        dialog.setText("How do you want to export?")
        dialog.setInformativeText(
            "Poster Print Mode: split the selected area into A4 pages for poster printing.\n\n"
            "Single Page Mode: export the selected area as clean single-page output."
        )

        a3_button = dialog.addButton("Poster Print Mode", QMessageBox.ButtonRole.AcceptRole)
        selection_button = dialog.addButton("Single Page Mode", QMessageBox.ButtonRole.ActionRole)
        cancel_button = dialog.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)

        dialog.setDefaultButton(a3_button)
        dialog.exec()

        clicked = dialog.clickedButton()

        if clicked == cancel_button:
            return False

        if clicked == a3_button:
            self._apply_combo_data(self.export_type_combo, "a3_split")
            self.update_export_option_states()
            self._log("Export type selected from prompt: Poster Print Mode")
            return True

        if clicked == selection_button:
            self._apply_combo_data(self.export_type_combo, "selection_only")
            self.update_export_option_states()
            self._log("Export type selected from prompt: Single Page Mode")
            return True

        return False



