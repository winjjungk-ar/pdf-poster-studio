        try:
            if hasattr(self, "print_quality_combo"):
                self.print_dpi = int(self.print_quality_combo.currentData())

            self._log("Creating temporary PDF for printing...")
            temp_pdf_path = self._create_temp_print_pdf()
        except Exception as exc:
            QMessageBox.warning(
                self,
                "Print",
                f"Failed to create temporary print PDF.\n\n{exc}"
            )
            self._log(f"Temporary print PDF error: {exc}")
            return

        result = QMessageBox.question(
            self,
            "Print",
            "A temporary print PDF was created from the current settings.\n\n"
            "Yes: Print now with printer selection dialog\n"
            "No: Open the temporary PDF and print manually",
            QMessageBox.StandardButton.Yes |
            QMessageBox.StandardButton.No |
            QMessageBox.StandardButton.Cancel
        )

        if result == QMessageBox.StandardButton.Yes:
            old_last_exported = self.last_exported_pdf_path
            self.last_exported_pdf_path = temp_pdf_path

            try:
                self.print_last_exported_pdf_with_dialog()
            finally:
                self.last_exported_pdf_path = old_last_exported

        elif result == QMessageBox.StandardButton.No:
            try:
                os.startfile(temp_pdf_path)
                self._log(f"Opened temporary print PDF: {temp_pdf_path}")
            except Exception as exc:
                QMessageBox.critical(
                    self,
                    "Open Error",
                    f"Failed to open temporary print PDF.\n\n{exc}"
                )
