    def _serialize_workspace_items(self) -> list[dict]:
        if hasattr(self, "workspace_items") and self.current_workspace_index is not None:
            self._save_current_workspace_state()

        result = []

        for item in getattr(self, "workspace_items", []):
            selections = {}

            for page_index, rect in item.get("page_selections", {}).items():
                selections[str(int(page_index))] = self._rect_to_project_data(rect)

            result.append(
                {
                    "pdf_path": item.get("pdf_path"),
                    "page_count": int(item.get("page_count", 0) or 0),
                    "current_page_index": int(item.get("current_page_index", 0) or 0),
                    "checked_pages": sorted([int(x) for x in item.get("checked_pages", set())]),
                    "selections": selections,
                }
            )

        return result

    def _serialize_export_order(self) -> list[dict]:
        result = []

        if not hasattr(self, "export_order_list"):
            return result

        for row in range(self.export_order_list.count()):
            list_item = self.export_order_list.item(row)
            data = list_item.data(Qt.ItemDataRole.UserRole)

            if not isinstance(data, dict):
                continue

            try:
                result.append(
                    {
                        "workspace_index": int(data.get("workspace_index")),
                        "page_index": int(data.get("page_index")),
                    }
                )
            except Exception:
                continue

        return result

    def _restore_export_order_from_project(self, export_order: list[dict]) -> None:
        if not hasattr(self, "export_order_list"):
            return

        self.export_order_list.clear()

        for entry in export_order or []:
            try:
                workspace_index = int(entry.get("workspace_index"))
                page_index = int(entry.get("page_index"))
            except Exception:
                continue

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            self._add_export_order_item(workspace_index, page_index)

    def _restore_workspace_items_from_project(self, workspace_items: list[dict]) -> None:
        self.workspace_items = []
        self.current_workspace_index = None

        if hasattr(self, "workspace_pdf_list"):
            self.workspace_pdf_list.clear()
        if hasattr(self, "export_order_list"):
            self.export_order_list.clear()

        for saved_item in workspace_items or []:
            pdf_path = saved_item.get("pdf_path")

            if not pdf_path:
                continue

            item = {
                "pdf_path": pdf_path,
                "page_count": int(saved_item.get("page_count", 0) or 0),
                "current_page_index": int(saved_item.get("current_page_index", 0) or 0),
                "page_selections": {},
                "checked_pages": set(),
            }

            # Refresh page count from actual file when possible.
            try:
                probe = self._make_workspace_item(pdf_path)
                if int(probe.get("page_count", 0) or 0) > 0:
                    item["page_count"] = int(probe.get("page_count", 0))
            except Exception:
                pass

            for page_index in saved_item.get("checked_pages", []):
                try:
                    item["checked_pages"].add(int(page_index))
                except Exception:
                    continue

            selections = saved_item.get("selections", {})
            for page_key, rect_data in selections.items():
                try:
                    item["page_selections"][int(page_key)] = self._rect_from_project_data(rect_data)
                except Exception:
                    continue

            self.workspace_items.append(item)

        self._refresh_workspace_list_text()


    def _collect_project_data(self) -> dict:
        # Keep current page selection before saving.
        if self.page_count > 0:
            self._save_current_selection()

        selections = {}
        for page_index, rect in self.page_selections.items():
            selections[str(page_index)] = self._rect_to_project_data(rect)

        workspace_items = self._serialize_workspace_items()
        export_order = self._serialize_export_order()

        return {
            "app": "PDF Poster Studio",
            "version": "0.9.3",
            "saved_at": datetime.now().isoformat(timespec="seconds"),

            # Legacy/single-PDF compatibility fields.
            "pdf_path": self.current_pdf_path,
            "last_exported_pdf_path": self.last_exported_pdf_path,
            "current_page_index": self.current_page_index,
            "page_count": self.page_count,
            "selections": selections,
            "checked_pages": sorted(list(self.checked_pages)),

            # Workspace project fields.
            "workspace": {
                "items": workspace_items,
                "current_workspace_index": self.current_workspace_index,
                "export_order": export_order,
            },

            "settings": {
                "export_type": self.export_type_combo.currentData(),
                "selection_fit_mode": self.selection_fit_mode_combo.currentData(),
                "page_orientation": self.page_orientation_combo.currentData(),
                "export_quality": self.export_quality_combo.currentData(),
                "batch_output": self.batch_output_combo.currentData(),
                "print_quality_dpi": self.print_quality_combo.currentData(),
                "auto_select_sensitivity": self.auto_select_sensitivity_combo.currentData(),
                "output_mode": self.output_mode_combo.currentData(),
                "split_layout": self.split_layout_combo.currentData(),
                "add_numbers": self.numbering_check.isChecked(),
                "add_cut_guides": self.cut_guides_check.isChecked(),
                "rotation_degrees": self.rotation_degrees,
                "preview_zoom_factor": self.preview_zoom_factor,
                "fit_to_page_enabled": self.fit_to_page_enabled,
                "paper_size": self.paper_size_combo.currentData() if hasattr(self, "paper_size_combo") else "a4",
                "poster_scale_percent": self.poster_scale_spin.value() if hasattr(self, "poster_scale_spin") else 100,
                "poster_size_preset_index": self.poster_size_preset_combo.currentIndex() if hasattr(self, "poster_size_preset_combo") else 0,
            },
        }

    def _apply_combo_data(self, combo, target_data) -> bool:
        """Select combo item by itemData with tolerant type matching."""
        if combo is None:
            return False

        if target_data is None:
            return False

        # 1) Exact match first.
        for index in range(combo.count()):
            if combo.itemData(index) == target_data:
                combo.setCurrentIndex(index)
                return True

        # 2) String-normalized match.
        target_text = str(target_data)

        for index in range(combo.count()):
            data = combo.itemData(index)
            if str(data) == target_text:
                combo.setCurrentIndex(index)
                return True

        # 3) Numeric tolerant match.
        try:
            target_float = float(target_data)

            for index in range(combo.count()):
                data = combo.itemData(index)
                try:
                    if abs(float(data) - target_float) < 0.000001:
                        combo.setCurrentIndex(index)
                        return True
                except Exception:
                    continue
        except Exception:
            pass

        # 4) Text match fallback.
        for index in range(combo.count()):
            if combo.itemText(index) == target_text:
                combo.setCurrentIndex(index)
                return True

        self._log(f"Combo data not found: {target_data}")
        return False


    def _apply_project_data(self, data: dict) -> None:
        self.last_exported_pdf_path = data.get("last_exported_pdf_path")

        settings = data.get("settings", {})
        self._apply_combo_data(self.export_type_combo, settings.get("export_type"))
        self._apply_combo_data(self.selection_fit_mode_combo, settings.get("selection_fit_mode"))
        self._apply_combo_data(self.page_orientation_combo, settings.get("page_orientation"))
        self._apply_combo_data(self.export_quality_combo, settings.get("export_quality"))
        self._apply_combo_data(self.batch_output_combo, settings.get("batch_output"))
        self._apply_combo_data(self.print_quality_combo, settings.get("print_quality_dpi"))
        self._apply_combo_data(self.auto_select_sensitivity_combo, settings.get("auto_select_sensitivity"))
        self._apply_combo_data(self.output_mode_combo, settings.get("output_mode"))
        self._apply_combo_data(self.split_layout_combo, settings.get("split_layout"))
        self.update_export_option_states()

        self.numbering_check.setChecked(bool(settings.get("add_numbers", True)))
        self.cut_guides_check.setChecked(bool(settings.get("add_cut_guides", True)))

        self.rotation_degrees = int(settings.get("rotation_degrees", 0)) % 360
        self.preview_zoom_factor = float(settings.get("preview_zoom_factor", 1.0))
        self.fit_to_page_enabled = bool(settings.get("fit_to_page_enabled", True))

        if hasattr(self, "paper_size_combo"):
            self._apply_combo_data(self.paper_size_combo, settings.get("paper_size", "a4"))
        if hasattr(self, "poster_scale_spin"):
            self.poster_scale_spin.setValue(int(settings.get("poster_scale_percent", 100)))
        if hasattr(self, "poster_size_preset_combo"):
            try:
                preset_index = int(settings.get("poster_size_preset_index", 0))
                if 0 <= preset_index < self.poster_size_preset_combo.count():
                    self.poster_size_preset_combo.setCurrentIndex(preset_index)
            except Exception:
                pass

        workspace = data.get("workspace", {})
        workspace_items = workspace.get("items", [])

        if workspace_items:
            self._restore_workspace_items_from_project(workspace_items)

            target_workspace_index = workspace.get("current_workspace_index")
            try:
                target_workspace_index = int(target_workspace_index)
            except Exception:
                target_workspace_index = 0

            if self.workspace_items:
                target_workspace_index = max(0, min(target_workspace_index, len(self.workspace_items) - 1))
                self._load_workspace_index(target_workspace_index)

            self._restore_export_order_from_project(workspace.get("export_order", []))

        else:
            # Legacy single-PDF project support.
            pdf_path = data.get("pdf_path")
            if pdf_path:
                self._open_pdf_path(pdf_path, clear_selections=False)

            self.checked_pages = set()
            for page_index in data.get("checked_pages", []):
                try:
                    self.checked_pages.add(int(page_index))
                except Exception:
                    continue

            self.page_selections.clear()
            selections = data.get("selections", {})

            for page_key, rect_data in selections.items():
                try:
                    self.page_selections[int(page_key)] = self._rect_from_project_data(rect_data)
                except Exception:
                    continue

            target_page = int(data.get("current_page_index", 0))
            if self.page_count > 0:
                self.current_page_index = max(0, min(target_page, self.page_count - 1))
                self._render_current_page()
                self._rebuild_page_list()

        self._refresh_workspace_list_text()
        self._refresh_current_page_check_state()
        self._refresh_page_list_all_text()
        self._update_checked_pages_label()

        if hasattr(self, "update_poster_sheet_estimate"):
            self.update_poster_sheet_estimate()

        self.is_modified = False

    def load_project_from_path(self, path: str) -> None:
        if not self._confirm_discard_changes():
            return

        try:
            data = self.project_manager.load_project(path)
            self.current_project_path = str(Path(path))
            self._apply_project_data(data)
            self._add_recent_project(self.current_project_path)
            self._log(f"Project loaded: {self.current_project_path}")
        except Exception as exc:
            QMessageBox.critical(
                self,
                "Open Project Error",
                f"Failed to open project.\n\n{exc}"
            )
            self._log(f"Open project error: {exc}")

    def _confirm_discard_changes(self) -> bool:
        if not self.is_modified:
            return True

        result = QMessageBox.question(
            self,
            "Unsaved Changes",
            "There are unsaved changes. Continue without saving?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        return result == QMessageBox.StandardButton.Yes
