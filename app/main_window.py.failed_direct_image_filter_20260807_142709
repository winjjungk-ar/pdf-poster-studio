    def add_pdfs_to_workspace(self) -> None:
        file_paths, _ = QFileDialog.getOpenFileNames(
            self,
            "Add PDFs or Images to Source PDFs",
            "",
            "PDF and Image Files (*.pdf *.png *.jpg *.jpeg *.bmp *.webp);;"
            "PDF Files (*.pdf);;"
            "Image Files (*.png *.jpg *.jpeg *.bmp *.webp);;"
            "All Files (*)"
        )

        if not file_paths:
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        existing = {item.get("pdf_path") for item in self.workspace_items}

        for source_path in file_paths:
            pdf_path = self._prepare_source_file_for_workspace(source_path)

            if pdf_path not in existing:
                self.workspace_items.append(self._make_workspace_item(pdf_path))

        self._refresh_workspace_list_text()

        if self.current_workspace_index is None and self.workspace_items:
            self._load_workspace_index(0)

        self.is_modified = True

    def remove_selected_workspace_pdf(self) -> None:
        if not hasattr(self, "workspace_pdf_list"):
            return

        row = self.workspace_pdf_list.currentRow()

        if row < 0 or row >= len(self.workspace_items):
            return

        del self.workspace_items[row]

        if not self.workspace_items:
            self.current_workspace_index = None
            self.current_pdf_path = None
            self.page_count = 0
            self.current_page_index = 0
            self.page_selections.clear()
            self.checked_pages.clear()
            self.preview_label.clear_preview()
            self.page_list_widget.clear()
            self.pdf_path_label.setText("PDF: Not selected")
            self.pdf_info_label.setText("Pages: -")
            self.selection_info_label.setText("Selection: None")
            self.checked_pages_label.setText("Checked pages: 0")
            self._refresh_workspace_list_text()
            return

        if self.current_workspace_index is not None:
            if row == self.current_workspace_index:
                self.current_workspace_index = None
                self._load_workspace_index(min(row, len(self.workspace_items) - 1))
            elif row < self.current_workspace_index:
                self.current_workspace_index -= 1

        self._refresh_workspace_list_text()
        self.is_modified = True

    def on_workspace_pdf_clicked(self, item: QListWidgetItem) -> None:
        if self._updating_workspace_list:
            return

        row = self.workspace_pdf_list.row(item)

        if row < 0:
            return

        self._load_workspace_index(row)

    def on_workspace_rows_moved(self, *args) -> None:
        if self._updating_workspace_list:
            return

        if not hasattr(self, "workspace_pdf_list"):
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        old_items_by_path = {
            item.get("pdf_path"): item
            for item in self.workspace_items
        }

        new_items = []
        new_current_index = None

        for row in range(self.workspace_pdf_list.count()):
            list_item = self.workspace_pdf_list.item(row)
            pdf_path = list_item.data(Qt.ItemDataRole.UserRole)

            if pdf_path in old_items_by_path:
                new_items.append(old_items_by_path[pdf_path])

                if pdf_path == self.current_pdf_path:
                    new_current_index = row

        if len(new_items) == len(self.workspace_items):
            self.workspace_items = new_items
            self.current_workspace_index = new_current_index
            self._refresh_workspace_list_text()
            self.is_modified = True
            self._log("Source PDF order changed.")

    def _workspace_has_multiple_pdfs(self) -> bool:
        return hasattr(self, "workspace_items") and len(self.workspace_items) > 1


