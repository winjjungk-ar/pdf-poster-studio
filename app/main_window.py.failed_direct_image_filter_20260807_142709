    def _make_workspace_item(self, pdf_path: str) -> dict:
        page_count = 0
        try:
            doc = fitz.open(pdf_path)
            page_count = doc.page_count
            doc.close()
        except Exception:
            page_count = 0

        return {
            "pdf_path": pdf_path,
            "page_count": page_count,
            "current_page_index": 0,
            "page_selections": {},
            "checked_pages": set(),
        }

    def _save_current_workspace_state(self) -> None:
        if self.current_workspace_index is None:
            return

        if self.current_workspace_index < 0 or self.current_workspace_index >= len(self.workspace_items):
            return

        if self.page_count > 0:
            self._save_current_selection()

        item = self.workspace_items[self.current_workspace_index]
        item["current_page_index"] = self.current_page_index
        item["page_selections"] = {page: QRect(rect) for page, rect in self.page_selections.items()}
        item["checked_pages"] = set(self.checked_pages)

        self._refresh_workspace_list_text()

    def _load_workspace_index(self, index: int) -> None:
        if index < 0 or index >= len(self.workspace_items):
            return

        if self.current_workspace_index is not None and self.current_workspace_index != index:
            self._save_current_workspace_state()

        item = self.workspace_items[index]
        pdf_path = item["pdf_path"]

        self._log(f"Loading source PDF: {pdf_path}")

        self.page_count = self.pdf_renderer.open(pdf_path)
        self.current_pdf_path = pdf_path
        self.current_workspace_index = index

        self.page_selections = {
            int(page): QRect(rect)
            for page, rect in item.get("page_selections", {}).items()
        }
        self.checked_pages = set(item.get("checked_pages", set()))

        target_page = int(item.get("current_page_index", 0))
        self.current_page_index = max(0, min(target_page, self.page_count - 1))

        self.pdf_path_label.setText(f"PDF: {pdf_path}")
        self.pdf_info_label.setText(f"Pages: {self.page_count}")
        self.selection_info_label.setText("Selection: None")

        self._render_current_page()
        self._rebuild_page_list()
        self._refresh_workspace_list_text()

        if hasattr(self, "workspace_pdf_list"):
            self.workspace_pdf_list.blockSignals(True)
            self.workspace_pdf_list.setCurrentRow(index)
            self.workspace_pdf_list.blockSignals(False)

    def _workspace_item_text(self, index: int, item: dict) -> str:
        pdf_path = item.get("pdf_path", "")
        name = Path(pdf_path).name
        page_count = item.get("page_count", 0)
        checked_count = len(item.get("checked_pages", set()))
        prefix = "▶ " if index == self.current_workspace_index else ""
        return f"{prefix}{index + 1}. {name}  |  {page_count} pages  |  checked {checked_count}"

    def _refresh_workspace_list_text(self) -> None:
        if not hasattr(self, "workspace_pdf_list"):
            return

        self._updating_workspace_list = True

        current_row = self.workspace_pdf_list.currentRow()
        self.workspace_pdf_list.clear()

        for index, item in enumerate(self.workspace_items):
            list_item = QListWidgetItem(self._workspace_item_text(index, item))
            list_item.setData(Qt.ItemDataRole.UserRole, item.get("pdf_path", ""))
            list_item.setToolTip(item.get("pdf_path", ""))
            self.workspace_pdf_list.addItem(list_item)

        if self.current_workspace_index is not None and 0 <= self.current_workspace_index < self.workspace_pdf_list.count():
            self.workspace_pdf_list.setCurrentRow(self.current_workspace_index)
        elif 0 <= current_row < self.workspace_pdf_list.count():
            self.workspace_pdf_list.setCurrentRow(current_row)

        self._updating_workspace_list = False



    def _is_supported_image_path(self, file_path: str) -> bool:
        suffix = Path(file_path).suffix.lower()
        return suffix in {".png", ".jpg", ".jpeg", ".bmp", ".webp"}

    def _prepare_source_file_for_workspace(self, file_path: str) -> str:
        suffix = Path(file_path).suffix.lower()

        if suffix == ".pdf":
            return file_path

        if self._is_supported_image_path(file_path):
            return self._convert_image_to_temp_pdf(file_path)

        raise RuntimeError(f"Unsupported file type: {file_path}")

    def _convert_image_to_temp_pdf(self, image_path: str) -> str:
        image_file = Path(image_path)

        if not image_file.exists():
            raise RuntimeError(f"Image file not found: {image_path}")

        temp_dir = DATA_DIR / "image_imports"
        temp_dir.mkdir(parents=True, exist_ok=True)

        safe_stem = "".join(ch if ch not in '<>:"/\\\\|?*' else "_" for ch in image_file.stem)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        output_pdf = temp_dir / f"{safe_stem}_{timestamp}.pdf"

        doc = fitz.open()
        img_doc = None

        try:
            img_doc = fitz.open(str(image_file))
            rect = img_doc[0].rect

            if rect.width <= 0 or rect.height <= 0:
                raise RuntimeError("Invalid image size.")

            page = doc.new_page(width=rect.width, height=rect.height)
            page.insert_image(page.rect, filename=str(image_file))
            doc.save(str(output_pdf), garbage=4, deflate=True)

        finally:
            doc.close()
            if img_doc is not None:
                img_doc.close()

        self._log(f"Image converted to temporary PDF: {image_file} -> {output_pdf}")
        return str(output_pdf)


