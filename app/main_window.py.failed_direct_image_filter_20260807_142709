    def _print_pdf_to_printer(self, pdf_path: str, printer: QPrinter) -> None:
        document = fitz.open(pdf_path)
        painter = QPainter()

        if not painter.begin(printer):
            document.close()
            raise RuntimeError("Failed to start printer painter.")

        try:
            page_count = len(document)
            dpi = max(150, int(printer.resolution()))
            zoom = dpi / 72.0

            page_rect = printer.pageRect(QPrinter.Unit.DevicePixel)
            target_width = int(page_rect.width())
            target_height = int(page_rect.height())

            for page_index in range(page_count):
                if page_index > 0:
                    printer.newPage()

                page = document.load_page(page_index)
                matrix = fitz.Matrix(zoom, zoom)

                pix = page.get_pixmap(
                    matrix=matrix,
                    alpha=False,
                    colorspace=fitz.csRGB,
                )

                image = QImage(
                    pix.samples,
                    pix.width,
                    pix.height,
                    pix.stride,
                    QImage.Format.Format_RGB888,
                ).copy()

                scaled = image.scaled(
                    target_width,
                    target_height,
                    Qt.AspectRatioMode.KeepAspectRatio,
                    Qt.TransformationMode.SmoothTransformation,
                )

                x = int((target_width - scaled.width()) / 2)
                y = int((target_height - scaled.height()) / 2)

                painter.drawImage(x, y, scaled)

        finally:
            painter.end()
            document.close()
    def print_pdf(self) -> None:
        self._log("Print selected.")

        if not self.current_pdf_path:
            QMessageBox.information(
                self,
                "Print",
                "Please open a PDF first."
            )
