        pdf_name = Path(item.get("pdf_path", "")).name
        return f"{pdf_name}  -  Page {page_index + 1}"


    def _create_export_order_thumbnail(self, workspace_index: int, page_index: int) -> QIcon:
        try:
            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                return QIcon()

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path", "")

            if not pdf_path:
                return QIcon()

            renderer = PdfRenderer()
            renderer.open(pdf_path)
            pixmap = renderer.render_page(page_index, zoom=0.35)

            if pixmap.isNull():
                return QIcon()

            canvas = QPixmap(96, 128)
            canvas.fill(QColor("#FFF8F0"))

            painter = QPainter(canvas)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)

            scaled = pixmap.scaled(
                86,
                118,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

            x = int((96 - scaled.width()) / 2)
            y = int((128 - scaled.height()) / 2)

            painter.setBrush(QBrush(QColor("#FFFFFF")))
            painter.setPen(QPen(QColor("#B7C9D6"), 1))
            painter.drawRoundedRect(x - 2, y - 2, scaled.width() + 4, scaled.height() + 4, 4, 4)
            painter.drawPixmap(x, y, scaled)

            # Draw selected area overlay if possible.
            selections = item.get("page_selections", {})
            rect = selections.get(page_index)

            if rect is not None and not rect.isNull() and rect.width() > 0 and rect.height() > 0:
                # Selections are stored in preview pixel coordinates.
                # Use stored current display base size if available; fallback to pixmap size.
                source_w = max(1, int(getattr(self, "current_display_base_width", pixmap.width())))
                source_h = max(1, int(getattr(self, "current_display_base_height", pixmap.height())))

                sx = scaled.width() / source_w
                sy = scaled.height() / source_h

                overlay_x = x + int(rect.x() * sx)
                overlay_y = y + int(rect.y() * sy)
                overlay_w = max(2, int(rect.width() * sx))
                overlay_h = max(2, int(rect.height() * sy))

                painter.setBrush(QBrush(QColor(255, 180, 110, 85)))
                painter.setPen(QPen(QColor("#FF9F68"), 2))
                painter.drawRoundedRect(overlay_x, overlay_y, overlay_w, overlay_h, 3, 3)

            painter.end()
            return QIcon(canvas)

        except Exception as exc:
            self._log(f"Thumbnail creation failed: workspace={workspace_index}, page={page_index + 1}, error={exc}")
            return QIcon()


    def _add_export_order_item(self, workspace_index: int, page_index: int) -> None:
        if not hasattr(self, "export_order_list"):
            return

        list_item = QListWidgetItem(self._export_order_item_text(workspace_index, page_index))
        list_item.setData(
            Qt.ItemDataRole.UserRole,
            {
                "workspace_index": workspace_index,
                "page_index": page_index,
            }
        )

        pdf_path = self.workspace_items[workspace_index].get("pdf_path", "")
        list_item.setToolTip(f"{pdf_path}\nPage {page_index + 1}")
        list_item.setIcon(self._create_export_order_thumbnail(workspace_index, page_index))
        self.export_order_list.addItem(list_item)

    def refresh_export_order_from_checked_pages(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            QMessageBox.information(self, "Print Order", "Workspace is empty.")
            return

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        self.export_order_list.clear()

        for workspace_index, item in enumerate(self.workspace_items):
            checked_pages = sorted(list(item.get("checked_pages", set())))

            for page_index in checked_pages:
                self._add_export_order_item(workspace_index, page_index)

        if self.export_order_list.count() <= 0:
            QMessageBox.information(
                self,
                "Print Order",
                "No selected pages found.\n\nSelect areas on pages first."
            )
            return

        self._log(f"Print order refreshed: {self.export_order_list.count()} pages")

    def _move_export_order_row(self, source_row: int, target_row: int) -> None:
        if not hasattr(self, "export_order_list"):
            return

        count = self.export_order_list.count()

        if source_row < 0 or source_row >= count:
            return

        if target_row < 0 or target_row >= count:
            return

        item = self.export_order_list.takeItem(source_row)
        self.export_order_list.insertItem(target_row, item)
        self.export_order_list.setCurrentRow(target_row)

    def move_export_order_item_up(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        row = self.export_order_list.currentRow()

        if row <= 0:
            return

        self._move_export_order_row(row, row - 1)

    def move_export_order_item_down(self) -> None:
        if not hasattr(self, "export_order_list"):
            return

        row = self.export_order_list.currentRow()

        if row < 0 or row >= self.export_order_list.count() - 1:
            return

        self._move_export_order_row(row, row + 1)


    def on_export_order_item_double_clicked(self, item: QListWidgetItem) -> None:
        if item is None:
            return

        data = item.data(Qt.ItemDataRole.UserRole)

        if not isinstance(data, dict):
            return

        try:
            workspace_index = int(data.get("workspace_index"))
            page_index = int(data.get("page_index"))
        except Exception:
            return

        if not hasattr(self, "workspace_items") or not self.workspace_items:
            return

        if workspace_index < 0 or workspace_index >= len(self.workspace_items):
            return

        try:
            if self.current_workspace_index != workspace_index:
                self._load_workspace_index(workspace_index)

            if page_index < 0 or page_index >= self.page_count:
                return

            self._save_current_selection()
            self.current_page_index = page_index
            self._render_current_page()
            self._refresh_current_page_check_state()
            self._refresh_page_list_all_text()

            self._log(
                f"Jumped from Print Order to source PDF {workspace_index + 1}, "
                f"page {page_index + 1}."
            )

        except Exception as exc:
            QMessageBox.warning(
                self,
                "Print Order",
                f"Failed to jump to selected page.\n\n{exc}"
            )
            self._log(f"Print Order jump failed: {exc}")


    def _get_export_order_entries(self) -> list[tuple[int, int]]:
        entries: list[tuple[int, int]] = []

        if not hasattr(self, "export_order_list"):
            return entries

        for row in range(self.export_order_list.count()):
            item = self.export_order_list.item(row)
            data = item.data(Qt.ItemDataRole.UserRole)

            if not isinstance(data, dict):
                continue

            try:
                workspace_index = int(data.get("workspace_index"))
                page_index = int(data.get("page_index"))
            except Exception:
                continue

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            entries.append((workspace_index, page_index))

        return entries


    def _export_workspace_to_separate_pdfs(self, output_path: str, options: ExportOptions) -> list[str]:
        if not self.workspace_items:
            raise RuntimeError("Workspace is empty.")

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        export_order_entries = self._get_export_order_entries()

        if not export_order_entries:
            for workspace_index, item in enumerate(self.workspace_items):
                checked_pages = sorted(list(item.get("checked_pages", set())))
                for page_index in checked_pages:
                    export_order_entries.append((workspace_index, page_index))

        if not export_order_entries:
            raise RuntimeError("No pages are checked for export.")

        base_path = Path(output_path)
        output_files: list[str] = []
        exporter = PosterExporter()

        self._log(
            f"Separate export started. "
            f"mode={options.export_type}, paper={getattr(options, 'paper_size', 'a4')}, "
            f"scale={getattr(options, 'poster_scale', 1.0)}"
        )

        for order_index, entry in enumerate(export_order_entries, 1):
            workspace_index, page_index = entry

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path")
            selections_qrect = item.get("page_selections", {})
            checked_pages = set(item.get("checked_pages", set()))

            if not pdf_path:
                continue

            if page_index not in checked_pages:
                continue

            rect = selections_qrect.get(page_index)

            if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                continue

            # Load correct PDF/page so coordinate conversion uses correct page data.
            self.page_count = self.pdf_renderer.open(pdf_path)
            self.current_pdf_path = pdf_path
            self.current_page_index = page_index
            self.current_pixmap = self.pdf_renderer.render_page(page_index, zoom=self.render_zoom)

            converted = {
                page_index: self._preview_rect_to_pdf_selection(rect)
            }

            source_stem = Path(pdf_path).stem
            safe_source_stem = "".join(ch if ch not in '<>:"/\\\\|?*' else "_" for ch in source_stem)

            page_output = base_path.with_name(
                f"{base_path.stem}_{order_index:03d}_{safe_source_stem}_page_{page_index + 1:03d}{base_path.suffix}"
            )

            exporter.export(
                source_pdf_path=pdf_path,
                output_pdf_path=str(page_output),
                selections=converted,
                options=options,
            )

            output_files.append(str(page_output))
            self._log(f"Separate PDF created: {page_output}")

        if not output_files:
            raise RuntimeError("No valid selected pages were found for export.")

        self.last_exported_pdf_path = output_files[0]
        self._log(f"Separate export completed. Files created: {len(output_files)}")

        return output_files


    def _export_workspace_to_pdf(self, output_path: str, options: ExportOptions) -> None:
        if not self.workspace_items:
            raise RuntimeError("Workspace is empty.")

        if self.current_workspace_index is not None:
            self._save_current_workspace_state()

        # Print Order list has priority.
        export_order_entries = self._get_export_order_entries()

        # If user did not prepare Print Order, build it from checked pages automatically.
        if not export_order_entries:
            for workspace_index, item in enumerate(self.workspace_items):
                checked_pages = sorted(list(item.get("checked_pages", set())))
                for page_index in checked_pages:
                    export_order_entries.append((workspace_index, page_index))

        if not export_order_entries:
            raise RuntimeError("No pages are checked for export.")

        temp_dir = DATA_DIR / "workspace_export_temp"
        temp_dir.mkdir(parents=True, exist_ok=True)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        temp_outputs = []
        exporter = PosterExporter()

        for order_index, entry in enumerate(export_order_entries):
            workspace_index, page_index = entry

            if workspace_index < 0 or workspace_index >= len(self.workspace_items):
                continue

            item = self.workspace_items[workspace_index]
            pdf_path = item.get("pdf_path")
            selections_qrect = item.get("page_selections", {})
            checked_pages = set(item.get("checked_pages", set()))

            if not pdf_path:
                continue

            if page_index not in checked_pages:
                continue

            rect = selections_qrect.get(page_index)

            if rect is None or rect.isNull() or rect.width() <= 0 or rect.height() <= 0:
                continue

            # Load correct PDF/page so coordinate conversion uses correct page data.
            self.page_count = self.pdf_renderer.open(pdf_path)
            self.current_pdf_path = pdf_path
            self.current_page_index = page_index
            self.current_pixmap = self.pdf_renderer.render_page(page_index, zoom=self.render_zoom)

            converted = {
                page_index: self._preview_rect_to_pdf_selection(rect)
            }

            part_path = temp_dir / f"workspace_order_{timestamp}_{order_index + 1:04d}.pdf"

            exporter.export(
                source_pdf_path=pdf_path,
                output_pdf_path=str(part_path),
                selections=converted,
                options=options,
            )

            temp_outputs.append(part_path)

        if not temp_outputs:
            raise RuntimeError("No valid selected pages were found for export.")

        merged = fitz.open()

        try:
            for part_path in temp_outputs:
                src = fitz.open(str(part_path))
                merged.insert_pdf(src)
                src.close()

            merged.save(output_path)
        finally:
            merged.close()

        self.last_exported_pdf_path = output_path
        self._log(f"Workspace export completed with custom page order: {output_path}")


